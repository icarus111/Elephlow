---
import '../../styles/global.css';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>About Elephlow | elephlow</title>
  <meta name="description" content="About Elephlow and 'Opening the Room's Door' Newsletter" />
</head>
<body>

  <main class="home-window">

    <header class="window-titlebar">
      <div class="titlebar-left">
        <span class="title-dots">● ● ●</span>
        <span class="titlebar-text">elephlow.cc / about elephlow</span>
      </div>
      <div class="titlebar-right">
        <a href="/zh-cn/about" class="lang-link">简</a>
        <a href="/zh-tw/about" class="lang-link">繁</a>
        <a href="/en/about" class="lang-link lang-active">EN</a>
      </div>
    </header>

    <div class="window-content about-layout">

      <aside class="about-left sticky-sidebar">

        <div class="elephant-portrait">
          <svg viewBox="0 0 100 80" xmlns="http://www.w3.org/2000/svg" shape-rendering="crispEdges">
            <text x="8" y="12" fill="#FFB6D9" font-size="10">✦</text>
            <text x="78" y="16" fill="#C7B3E8" font-size="8">✦</text>
            <text x="6" y="65" fill="#B5E8E0" font-size="9">·</text>
            <text x="82" y="60" fill="#FFE9B6" font-size="10">·</text>
            <rect x="30" y="26" width="8" height="10" fill="#C7B3E8"/>
            <rect x="58" y="26" width="8" height="10" fill="#C7B3E8"/>
            <rect x="34" y="24" width="28" height="18" fill="#C7B3E8"/>
            <rect x="48" y="40" width="6" height="14" fill="#C7B3E8"/>
            <rect x="48" y="52" width="4" height="4" fill="#C7B3E8"/>
            <rect x="40" y="30" width="3" height="3" fill="#2A1F18"/>
            <rect x="52" y="30" width="3" height="3" fill="#2A1F18"/>
            <rect x="38" y="34" width="3" height="2" fill="#FFB6D9" opacity="0.6"/>
            <rect x="55" y="34" width="3" height="2" fill="#FFB6D9" opacity="0.6"/>
            <rect x="32" y="42" width="32" height="20" fill="#C7B3E8"/>
            <rect x="34" y="62" width="6" height="8" fill="#C7B3E8"/>
            <rect x="56" y="62" width="6" height="8" fill="#C7B3E8"/>
            <rect x="44" y="40" width="2" height="2" fill="#FFB6D9"/>
            <rect x="50" y="40" width="2" height="2" fill="#FFB6D9"/>
            <rect x="46" y="42" width="4" height="1" fill="#FFB6D9"/>
          </svg>
          <p class="elephant-caption">Elephlow</p>
        </div>
        
        <div class="persona-card">
          <h3 class="card-title">✦ persona ✦</h3>
          <dl class="persona-list">
            
            <dt style="color: var(--tab-pink);">HANDLE</dt>
            <dd>Name: Elephlow</dd>

            <dt style="color: var(--tab-orange);">AKA</dt>
            <dd>AKA: A-Cha</dd>

            <dt style="color: var(--tab-blue);">SIGN</dt>
            <dd>Sign: Sagittarius</dd>

            <dt style="color: var(--tab-green);">TYPE</dt>
            <dd>MBTI: INFJ</dd>

            <dt style="color: var(--candy-purple);">BASE</dt>
            <dd>Base: Streets & Islands 🏝️</dd>

            <dt style="color: var(--tab-yellow);">MOTTO</dt>
            <dd>Motto: Capturing & imagining at the margins 🌈</dd>

          </dl>
        </div>

        <div class="interests-card">
          <h3 class="card-title">✿ interests ✿</h3>
          <div class="pixel-bars">
            <div class="p-bar-group">
              <div class="p-bar-label"><span>HK/TW Pop Music</span><span>85%</span></div>
              <div class="p-bar-track"><div class="p-bar-fill" style="width: 85%; background-color: var(--candy-pink);"></div></div>
            </div>
            <div class="p-bar-group">
              <div class="p-bar-label"><span>Indie Mags & Bookstores</span><span>95%</span></div>
              <div class="p-bar-track"><div class="p-bar-fill" style="width: 95%; background-color: var(--candy-mint);"></div></div>
            </div>
            <div class="p-bar-group">
              <div class="p-bar-label"><span>Documentary Film Fests</span><span>75%</span></div>
              <div class="p-bar-track"><div class="p-bar-fill" style="width: 75%; background-color: var(--candy-aqua);"></div></div>
            </div>
            <div class="p-bar-group">
              <div class="p-bar-label"><span>Queer Writing</span><span>80%</span></div>
              <div class="p-bar-track"><div class="p-bar-fill" style="width: 80%; background-color: var(--candy-purple);"></div></div>
            </div>
            <div class="p-bar-group">
              <div class="p-bar-label"><span>Zines & Art Book Fairs</span><span>90%</span></div>
              <div class="p-bar-track"><div class="p-bar-fill" style="width: 90%; background-color: var(--candy-cream);"></div></div>
            </div>
          </div>
        </div>

        <div class="retro-stickers-area">
          <span class="r-sticker sticker-a">✄ 100% Zine Lover</span>
          <span class="r-sticker sticker-b">Queer & Proud ♡</span>
        </div>

        <a href="https://tally.so/r/4415XB" target="_blank" class="retro-s4-banner">
          <div class="s4-banner-inner">
            <span class="blink-text">✦ SEASON 04 ✦</span><br/>
            Now Subscribing · Click to Join
          </div>
        </a>

      </aside>

      <section class="about-center">
        <div class="qa-card">
          <h2 class="qa-title">⌒ 5 Q&A ⌒</h2>
          <p class="qa-subtitle">A solo interview ｡^‿^｡</p>

          <div class="qa-list">

            <div class="qa-item qa-item-mint">
              <p class="qa-question"><span class="q-icon">☘</span> Q1 · Who are you?</p>
              <p class="qa-answer">Hi everyone, I'm Elephlow. An independent editor and content creator, constantly navigating between HK/TW pop culture, indie publishing, film festival studies, and queer writing. Find me online on IG / Threads at <a href="https://www.instagram.com/icarusrootedbutflow/" target="_blank">@icarusrootedbutflow</a>.</p>
            </div>

            <div class="text-divider">✿ ⋆ ✿ ⋆ ✿</div>

            <div class="qa-item qa-item-aqua">
              <p class="qa-question"><span class="q-icon">✦</span> Q2 · What is the newsletter?</p>
              <p class="qa-answer">"Opening the Room's Door" is a paid Chinese newsletter founded in July 2022. <strong>Three seasons have concluded, totaling 48 issues</strong>, and Season 4 is launching in 2026. The content revolves around the margins of independent culture in Hong Kong, Taiwan, Japan, and Korea — bookstores, zines, queer topics, sound, and visual arts. Season 4 shifts from fixed columns to <strong>themed curation</strong>, making each issue feel like a single issue of a mini indie magazine: narrow in scope, deep in content.</p>
            </div>

            <div class="text-divider">✦ ⋆ ✦ ⋆ ✦</div>

            <div class="qa-item qa-item-pink">
              <p class="qa-question"><span class="q-icon">✿</span> Q3 · Why write this newsletter?</p>
              <p class="qa-answer">Platform algorithms hide the good stuff and push what you don't need right in front of you. I want to do the opposite — selecting the good, the slow, the things that don't need to go viral but are worth seeing, and writing for those willing to slow down and read.</p>
              <p class="qa-answer">Subscribers won't receive what's already trending, but rather:</p>
              <ul class="qa-list-inner">
                <li>✿ Integrated content that bridges the information gap</li>
                <li>✦ Honest writing untainted by commercial interests</li>
                <li>☘ The sense of companionship from a real person</li>
              </ul>
            </div>

            <div class="text-divider">☘ ⋆ ☘ ⋆ ☘</div>

            <div class="qa-item qa-item-cream">
              <p class="qa-question"><span class="q-icon">♡</span> Q4 · What's different in Season 4?</p>
              <p class="qa-answer">Three big changes:</p>
              <ul class="qa-list-inner">
                <li>☘ <strong>Main issues shift to themed curation</strong>: Each issue will have a specific entry point — a certain object, a literary figure, or a music style — acting as the center of a mini-curation.</li>
                <li>✦ <strong>Faster magazine dispatch frequency</strong>: The supplement shifts from monthly to multiple issues per month, around 1000 words each, focusing on what a specific issue of a certain magazine is currently doing.</li>
                <li>✿ <strong>Adding external contributors</strong>: Inviting more writers from China, Hong Kong, and Taiwan to bring in diverse, localized voices.</li>
              </ul>
            </div>

            <div class="text-divider">♡ ⋆ ♡ ⋆ ♡</div>

            <div class="qa-item qa-item-purple">
              <p class="qa-question"><span class="q-icon">✶</span> Q5 · How to find me?</p>
              <p class="qa-answer">
                ✉ Subscribe to Season 4: <a href="https://tally.so/r/4415XB" target="_blank">tally.so/r/4415XB</a><br/>
                ◉ instagram / threads: <a href="https://www.instagram.com/icarusrootedbutflow/" target="_blank">@icarusrootedbutflow</a><br/>
                ◉ Xiaohongshu: Search "流星小飞象" (Shooting Star Elephlow)<br/>
                ◉ Writing, interviews, collaboration: DM via any of the above channels
              </p>
            </div>

          </div>

          <div class="qa-footer">
            <p>(｡♡‿♡｡) thanks for reading ✿</p>
          </div>
        </div>
      </section>

      <aside class="about-right sticky-sidebar">
        <nav class="vertical-tabs">
          <a href="/en/" class="vtab vtab-home">
            <span class="vtab-icon">🏠</span>
            <span class="vtab-label">Home</span>
          </a>
          <a href="/en/about" class="vtab vtab-active">
            <span class="vtab-icon">👤</span>
            <span class="vtab-label">About</span>
          </a>
          <a href="/en/archive" class="vtab vtab-archive">
            <span class="vtab-icon">📚</span>
            <span class="vtab-label">Archive</span>
          </a>
          <a href="/en/guestbook" class="vtab vtab-guestbook">
            <span class="vtab-icon">✉</span>
            <span class="vtab-label">Guestbook</span>
          </a>
        </nav>

        <div class="minihome-deco">
          <div class="deco-row">✦ ✿ ☘ ♡ ✦</div>
          <div class="deco-text">
            <p>this is a quiet</p>
            <p>little room ｡^‿^｡</p>
          </div>
        </div>

        <div class="kawaii-player">
          <div class="kp-header">
            <span class="kp-dot"></span>♫ NOW PLAYING<span class="kp-dot"></span>
          </div>
          <div class="kp-screen">
            <div class="kp-marquee">
              <span>Vicky Fung - 彳亍 ✿ Vicky Fung - 彳亍 ✿</span>
            </div>
          </div>
          <div class="kp-controls">
            <span class="kp-btn">⏮</span>
            <span class="kp-btn kp-play">▶</span>
            <span class="kp-btn">⏭</span>
          </div>
        </div>

        <div class="kawaii-counter">
          <p class="kc-title">✿ VISITORS ✿</p>
          <div class="kc-digits">
            <span>0</span><span>0</span><span>1</span><span>4</span><span>2</span><span>6</span>
          </div>
        </div>

      </aside>

    </div>

    <footer class="window-taskbar">
      <div class="taskbar-left">
        <span class="taskbar-start">⊞ START</span>
      </div>
      <div class="taskbar-right">
        <span class="taskbar-status">(｡♡‿♡｡) currently online</span>
        <span class="taskbar-clock" id="clock">--:--</span>
      </div>
    </footer>

  </main>

  <script is:inline>
    function updateClock() {
      const now = new Date();
      const h = String(now.getHours()).padStart(2, '0');
      const m = String(now.getMinutes()).padStart(2, '0');
      const el = document.getElementById('clock');
      if (el) el.innerText = `${h}:${m}`;
    }
    updateClock();
    setInterval(updateClock, 30000);
  </script>

  <style>
    /* === 基础容器 === */
    .home-window {
      max-width: 1180px;
      margin: 24px auto;
      background: var(--soft-white);
      border: 3px dashed var(--candy-mint);
      border-radius: 16px;
      box-shadow: 6px 6px 0 rgba(181, 232, 224, 0.6);
      /* 注意：这里删除了 overflow: hidden; 这是保证 sticky 吸顶生效的关键！ */
      display: flex;
      flex-direction: column;
    }
    .window-titlebar {
      background: var(--candy-mint);
      padding: 8px 16px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 2px dashed var(--candy-mint);
      border-radius: 13px 13px 0 0; /* 手动给顶部加上圆角 */
      font-family: var(--font-pixel);
      font-size: 11px;
      color: var(--ink);
    }
    .titlebar-left { display: flex; align-items: center; gap: 12px; }
    .title-dots { color: var(--candy-purple); letter-spacing: 2px; }
    .titlebar-text { letter-spacing: 1px; }
    .titlebar-right { display: flex; gap: 4px; }
    .lang-link {
      padding: 2px 8px;
      color: var(--ink);
      text-decoration: none;
      border-radius: 3px;
    }
    .lang-link:hover { background: rgba(255, 255, 255, 0.4); }
    .lang-active { background: rgba(255, 255, 255, 0.6); font-weight: 700; }

    .window-content { padding: 24px; }

    .about-layout {
      display: grid;
      grid-template-columns: 240px 1fr 200px;
      gap: 24px;
      align-items: start; /* 必须是 start，这样边栏自身高度才不会被拉伸，才能滑动！ */
    }

    /* === 【核心魔法】：吸顶跟随 === */
    .sticky-sidebar {
      position: sticky;
      top: 24px; /* 距离浏览器顶部 24px 处悬停 */
      height: fit-content;
    }

    .card-title {
      font-family: var(--font-pixel);
      font-size: 12px;
      color: var(--ink-light);
      text-align: center;
      letter-spacing: 4px;
      margin-bottom: 12px;
      padding-bottom: 8px;
      border-bottom: 1px dashed currentColor;
    }

    /* === 左侧卡片 === */
    .elephant-portrait {
      background: var(--soft-white);
      border: 2px dashed var(--candy-pink);
      border-radius: 12px;
      padding: 20px 16px;
      text-align: center;
      box-shadow: 4px 4px 0 rgba(255, 182, 217, 0.35);
      margin-bottom: 14px;
    }
    .elephant-portrait svg { width: 120px; height: auto; }
    .elephant-caption {
      font-family: var(--font-pixel);
      font-size: 11px;
      color: var(--ink-light);
      margin-top: 8px;
      letter-spacing: 2px;
    }

    .persona-card {
      background: var(--candy-mint);
      border: 1.5px dashed var(--candy-purple);
      border-radius: 12px;
      padding: 16px;
      box-shadow: 3px 3px 0 rgba(181, 232, 224, 0.6);
      margin-bottom: 14px;
    }
    .persona-list {
      font-family: var(--font-serif-tc);
      font-size: 12px;
      color: var(--ink);
      margin: 0;
    }
    .persona-list dt {
      font-family: var(--font-pixel);
      font-size: 9px;
      color: var(--candy-purple);
      letter-spacing: 1px;
      margin-top: 8px;
    }
    .persona-list dt:first-child { margin-top: 0; }
    .persona-list dd {
      font-size: 12.5px; /* 稍微缩小一点点字号适应长英文 */
      margin-left: 0;
      margin-top: 2px;
      line-height: 1.5;
    }

    .interests-card {
      background: var(--candy-cream);
      border: 1.5px dashed var(--candy-peach);
      border-radius: 12px;
      padding: 16px;
      box-shadow: 3px 3px 0 rgba(255, 233, 182, 0.5);
    }
    .pixel-bars { display: flex; flex-direction: column; gap: 12px; }
    .p-bar-group { width: 100%; display: block; }
    .p-bar-label {
      display: flex; justify-content: space-between;
      font-family: var(--font-serif-tc); font-size: 11px;
      color: var(--ink); margin-bottom: 4px; font-weight: 700;
    }
    .p-bar-track {
      width: 100%; height: 14px;
      background-color: rgba(255, 255, 255, 0.8);
      border: 1px dashed var(--candy-purple);
      border-radius: 8px; padding: 2px; box-sizing: border-box; 
    }
    .p-bar-fill { height: 100%; border-radius: 4px; }

    /* 手账小贴纸 */
    .retro-stickers-area {
      display: flex;
      flex-direction: column;
      gap: 12px;
      margin-top: 16px;
      padding: 0 10px;
    }
    .r-sticker {
      display: inline-block;
      align-self: flex-start;
      font-family: var(--font-mochi);
      font-size: 11px;
      color: var(--ink);
      padding: 6px 12px;
      border: 1.5px dashed rgba(0,0,0,0.15);
      border-radius: 0 12px 12px 12px; 
      box-shadow: 2px 2px 0 rgba(0,0,0,0.08);
      transition: transform 0.2s;
      cursor: default;
    }
    .r-sticker:hover { transform: scale(1.05) rotate(0deg) !important; }
    .sticker-a { background: var(--candy-pink); transform: rotate(-3deg); }
    .sticker-b { background: var(--candy-aqua); align-self: flex-end; transform: rotate(4deg); }

    /* 彩色炫动 Banner */
    .retro-s4-banner {
      display: block;
      margin-top: 20px;
      text-decoration: none;
      background: repeating-linear-gradient(
        -45deg,
        var(--candy-cream),
        var(--candy-cream) 10px,
        #fff 10px,
        #fff 20px
      );
      padding: 6px;
      border: 2px dashed var(--candy-purple);
      border-radius: 8px;
      box-shadow: 4px 4px 0 var(--candy-mint);
      animation: candy-stripe 3s linear infinite;
    }
    .s4-banner-inner {
      background: var(--candy-purple);
      color: var(--soft-white);
      text-align: center;
      padding: 12px;
      border-radius: 4px;
      font-family: var(--font-pixel);
      font-size: 12px;
      line-height: 1.6;
      letter-spacing: 1px;
    }
    .blink-text {
      color: var(--candy-peach);
      font-size: 14px;
      font-weight: bold;
      animation: retro-blink 1.5s infinite;
    }
    @keyframes candy-stripe { 0% { background-position: 0 0; } 100% { background-position: 28px 28px; } }
    @keyframes retro-blink { 0%, 49% { opacity: 1; } 50%, 100% { opacity: 0.5; } }

    /* === 中间 QA === */
    .qa-card {
      background: var(--soft-white);
      border: 2px dashed var(--candy-mint);
      border-radius: 12px;
      padding: 28px 32px;
      box-shadow: 4px 4px 0 rgba(181, 232, 224, 0.4);
    }
    .qa-title {
      font-family: var(--font-serif-tc);
      font-size: 26px;
      font-weight: 700;
      color: var(--ink-light);
      text-align: center;
      margin-bottom: 4px;
      letter-spacing: 6px;
    }
    .qa-subtitle {
      text-align: center;
      font-family: var(--font-rounded);
      font-size: 13px;
      color: var(--candy-purple);
      margin-bottom: 24px;
    }
    .qa-item {
      padding: 14px 16px;
      border-radius: 10px;
      margin: 0 -8px;
    }
    .qa-item-mint   { background: rgba(200, 233, 176, 0.25); }
    .qa-item-aqua   { background: rgba(181, 232, 224, 0.25); }
    .qa-item-pink   { background: rgba(255, 182, 217, 0.25); }
    .qa-item-cream  { background: rgba(255, 233, 182, 0.3); }
    .qa-item-purple { background: rgba(199, 179, 232, 0.25); }

    .qa-question {
      font-family: var(--font-mochi);
      font-size: 15px;
      color: var(--candy-purple);
      margin-bottom: 8px;
      letter-spacing: 1px;
    }
    .q-icon { margin-right: 4px; }
    .qa-answer {
      font-family: var(--font-serif-tc);
      font-size: 14px;
      line-height: 1.85;
      color: var(--ink);
      margin-bottom: 8px;
    }
    .qa-answer:last-child { margin-bottom: 0; }
    .qa-answer strong {
      color: var(--ink);
      background: linear-gradient(transparent 60%, var(--candy-aqua) 60%);
    }
    .qa-answer a {
      color: var(--candy-purple);
      border-bottom: 1px dashed var(--candy-purple);
      text-decoration: none;
    }
    .qa-answer a:hover { background: var(--candy-cream); }
    .qa-list-inner {
      font-family: var(--font-serif-tc);
      font-size: 13.5px;
      line-height: 1.85;
      color: var(--ink);
      padding-left: 0;
      list-style: none;
      margin-top: 4px;
    }
    .qa-list-inner li { margin-bottom: 6px; }
    .qa-list-inner strong {
      color: var(--ink);
      background: linear-gradient(transparent 60%, var(--candy-aqua) 60%);
    }
    .text-divider {
      text-align: center;
      font-family: var(--font-pixel);
      font-size: 11px;
      color: var(--candy-purple);
      letter-spacing: 6px;
      margin: 16px 0;
      opacity: 0.7;
    }
    .qa-footer {
      text-align: center;
      margin-top: 24px;
      padding-top: 16px;
      border-top: 1px dashed var(--candy-mint);
      font-family: var(--font-pixel);
      font-size: 11px;
      color: var(--ink-light);
      letter-spacing: 2px;
    }

    /* === 右侧 Tabs (加上白色外描边) === */
    .vertical-tabs {
      display: flex;
      flex-direction: column;
      gap: 4px;
      margin-bottom: 14px;
    }
    .vtab {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 12px 16px;
      border-radius: 0 16px 16px 0;
      border: 1.5px dashed rgba(0,0,0,0.1);
      border-left: 5px solid;
      text-decoration: none;
      color: var(--ink);
      font-family: var(--font-rounded);
      font-weight: 700;
      font-size: 13px;
      transition: transform 0.15s;
      /* 这里恢复了文字好看的白色发光描边！ */
      text-shadow: -1px -1px 0 var(--soft-white), 1px -1px 0 var(--soft-white), -1px 1px 0 var(--soft-white), 1px 1px 0 var(--soft-white);
    }
    .vtab:hover { transform: translateX(4px); text-decoration: none; }
    .vtab-icon { font-size: 16px; }

    .vtab-home      { background: var(--candy-mint);   border-left-color: #7BB85E; }
    .vtab-active    { background: var(--candy-purple); border-left-color: #9B7BC9; border-left-width: 7px; font-weight: 800; }
    .vtab-archive   { background: var(--candy-aqua);   border-left-color: #7DC2B8; }
    .vtab-guestbook { background: var(--candy-pink);   border-left-color: #E89BC0; }

    .minihome-deco {
      background: var(--candy-cream);
      border: 1.5px dashed var(--candy-peach);
      border-radius: 12px;
      padding: 16px 12px;
      text-align: center;
      box-shadow: 3px 3px 0 rgba(255, 200, 200, 0.3);
      margin-bottom: 16px;
    }
    .deco-row {
      font-size: 14px;
      color: var(--candy-purple);
      letter-spacing: 4px;
      margin-bottom: 10px;
    }
    .deco-text p {
      font-family: var(--font-pixel);
      font-size: 10px;
      color: var(--ink-light);
      margin: 2px 0;
    }

    /* === 纯正糖果色迷你播放器 === */
    .kawaii-player {
      background: var(--candy-mint);
      border: 2px dashed var(--candy-purple);
      border-radius: 12px;
      padding: 12px;
      box-shadow: 3px 3px 0 rgba(181, 232, 224, 0.8);
      margin-bottom: 16px;
    }
    .kp-header {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 6px;
      font-family: var(--font-pixel);
      font-size: 10px;
      color: var(--ink-light);
      margin-bottom: 8px;
      letter-spacing: 1px;
    }
    .kp-dot {
      width: 4px; height: 4px;
      background: var(--candy-pink);
      border-radius: 50%;
    }
    .kp-screen {
      background: var(--soft-white);
      border: 1.5px solid var(--candy-purple);
      border-radius: 6px;
      padding: 6px;
      overflow: hidden;
      margin-bottom: 10px;
    }
    .kp-marquee {
      font-family: var(--font-serif-tc);
      font-size: 12px;
      color: var(--candy-purple);
      font-weight: bold;
      white-space: nowrap;
      animation: marquee-scroll 6s linear infinite;
    }
    @keyframes marquee-scroll { 0% { transform: translateX(100%); } 100% { transform: translateX(-100%); } }
    .kp-controls {
      display: flex;
      justify-content: center;
      gap: 12px;
    }
    .kp-btn {
      display: inline-flex; justify-content: center; align-items: center;
      width: 24px; height: 24px;
      background: var(--soft-white);
      border: 1.5px dashed var(--candy-purple);
      border-radius: 50%;
      font-size: 10px; color: var(--candy-purple);
      cursor: pointer;
    }
    .kp-btn:hover { background: var(--candy-cream); }
    .kp-play { background: var(--candy-pink); color: white; border-color: transparent; }

    /* === 马卡龙色像素访客计数器 === */
    .kawaii-counter {
      background: var(--candy-cream);
      border: 2px dashed var(--candy-peach);
      border-radius: 12px;
      padding: 12px;
      text-align: center;
      box-shadow: 3px 3px 0 rgba(255, 200, 200, 0.4);
    }
    .kc-title {
      font-family: var(--font-pixel);
      font-size: 10px;
      color: var(--ink-light);
      margin: 0 0 8px 0;
      letter-spacing: 2px;
    }
    .kc-digits {
      display: flex;
      justify-content: center;
      gap: 3px;
    }
    .kc-digits span {
      background: var(--soft-white);
      color: var(--candy-pink); 
      font-family: var(--font-pixel);
      font-size: 16px;
      padding: 4px 6px;
      border: 1.5px solid var(--candy-pink);
      border-radius: 4px;
      font-weight: bold;
    }

    /* 底部状态栏 */
    .window-taskbar {
      background: var(--candy-mint);
      padding: 8px 16px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-top: 2px dashed var(--candy-mint);
      border-radius: 0 0 13px 13px; /* 手动给底部加上圆角 */
      font-family: var(--font-pixel);
      font-size: 11px;
      color: var(--ink);
    }
    .taskbar-left { display: flex; gap: 12px; align-items: center; }
    .taskbar-right { display: flex; gap: 12px; align-items: center; }
    .taskbar-start {
      background: rgba(255, 255, 255, 0.5);
      padding: 2px 8px;
      border-radius: 3px;
      border: 1px dashed var(--candy-purple);
    }
    .taskbar-status, .taskbar-clock { color: var(--ink); font-weight: 700; }

    @media (max-width: 900px) {
      .about-layout { grid-template-columns: 1fr; }
      .home-window { margin: 12px; }
      .sticky-sidebar { position: relative; top: 0; } /* 手机端取消吸顶 */
    }
  </style>

</body>
</html>