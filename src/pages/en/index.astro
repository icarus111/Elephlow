---
// src/pages/en/index.astro
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Push The Door | Home</title>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@400;600;900&family=Noto+Sans+TC:wght@400;700;900&display=swap" rel="stylesheet">
    <style>
        /* 為保持回答簡潔，請複製 zh-tw 版本中的 CSS 樣式至此處 */
        :root { --win-gray: #c0c0c0; --win-dark: #808080; --win-light: #ffffff; --y2k-purple: #4B2D8C; --y2k-pink: #FF66B3; --y2k-mint: #B2F5EA; --text: #1a1008; }
        * { margin: 0; padding: 0; box-sizing: border-box; cursor: default; }
        html, body { height: auto; min-height: 100%; }
        body { background: linear-gradient(to right, #98fb98, #fffacd, #ffebcd, #ffb6c1, #e0b0ff); background-attachment: fixed; font-family: 'Noto Sans TC', sans-serif; overflow-x: hidden; overflow-y: auto; display: flex; flex-direction: column; }
        .marquee-bar { background: var(--text); color: #fff; padding: 15px 0; min-height: 70px; display: flex; align-items: center; overflow: hidden; border-bottom: 3px solid #000; z-index: 2000; }
        .marquee-content { display: flex; white-space: nowrap; font-weight: 900; font-size: 1.4rem; animation: scroll 25s linear infinite; }
        @keyframes scroll { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }
        .desktop-wrapper { display: flex; flex: 1; padding: 25px; gap: 25px; padding-bottom: 80px; min-height: 1000px; }
        #sidebar { width: 280px; background: var(--win-gray); border: 2px solid; border-color: var(--win-light) var(--win-dark) var(--win-dark) var(--win-light); box-shadow: 4px 4px 0 rgba(0,0,0,0.8); display: flex; flex-direction: column; flex-shrink: 0; z-index: 1500; position: sticky; top: 25px; height: fit-content; }
        .side-title { background: linear-gradient(90deg, var(--y2k-purple), var(--y2k-pink)); color: white; padding: 8px 12px; font-weight: bold; font-size: 13px; }
        .nav-list { list-style: none; padding: 10px 0; flex: 1; }
        .nav-link { display: block; padding: 12px 20px; text-decoration: none; color: var(--text); font-weight: bold; font-size: 14px; }
        .nav-link:hover { background: rgba(255, 102, 179, 0.2); }
        .nav-active { background: var(--y2k-purple); color: white !important; }
        #playground { flex: 1; position: relative; }
        .window { background: var(--win-gray); border: 2px solid; border-color: var(--win-light) var(--win-dark) var(--win-dark) var(--win-light); box-shadow: 5px 5px 0 rgba(0,0,0,0.8); display: flex; flex-direction: column; position: absolute; height: auto; min-height: 400px; }
        .title-bar { background: linear-gradient(90deg, var(--y2k-purple), var(--y2k-pink)); padding: 4px 10px; display: flex; justify-content: space-between; align-items: center; color: white; font-weight: bold; font-size: 13px; cursor: move; }
        .win-controls { display: flex; gap: 4px; margin-left: 10px; }
        .win-btn { width: 22px; height: 22px; background-color: var(--win-gray); border: 2px solid; border-color: #fff #000 #000 #fff; color: #000; font-family: Arial, sans-serif; font-size: 14px; font-weight: bold; line-height: 1; display: flex; align-items: center; justify-content: center; cursor: pointer; padding-bottom: 2px; }
        .win-btn:active { border-color: #000 #fff #fff #000; padding-top: 2px; padding-bottom: 0; }
        .win-content { flex: 1; background: white; padding: 45px; overflow: visible; }
        .brand-hero { display: flex; flex-direction: column; justify-content: center; align-items: center; }
        .hero-title { font-family: 'Noto Serif TC', serif; font-size: 4.8rem; font-weight: 600; color: var(--y2k-purple); line-height: 1.2; text-align: center; letter-spacing: 0.08em; text-shadow: 3px 3px 0px rgba(255, 102, 179, 0.15); }
        .hero-slogan { font-weight: 900; color: var(--y2k-pink); font-size: 1.3rem; letter-spacing: 0.2rem; margin-bottom: 25px; text-align: center;}
        .ip-house { margin: 20px 0; width: 140px; height: 140px; border: 4px solid var(--text); background: linear-gradient(135deg, var(--y2k-purple) 0%, var(--y2k-pink) 100%); display: flex; align-items: center; justify-content: center; font-size: 4.5rem; box-shadow: 12px 12px 0px var(--y2k-mint); }
        .stat-tag { border: 2px solid #000; padding: 6px 18px; font-size: 0.8rem; background: #f0f0f0; font-weight: 900; text-align: center;}
        .intro-text { max-width: 580px; margin-top: 35px; color: #333; line-height: 1.8; text-align: justify; font-size: 0.95rem; border-top: 1px dashed var(--win-dark); padding-top: 25px; }
        .intro-text p { margin-bottom: 15px; }
        .intro-text strong { color: var(--y2k-purple); font-weight: 700;}
        .taskbar { position: fixed; bottom: 0; left: 0; right: 0; height: 48px; background: var(--win-gray); border-top: 2px solid var(--win-light); display: flex; align-items: center; padding: 0 12px; z-index: 3000; box-shadow: 0 -2px 0 var(--win-dark); }
        .start-btn { background: var(--win-gray); border: 2px solid; border-color: var(--win-light) var(--win-dark) var(--win-dark) var(--win-light); padding: 3px 15px; font-weight: 900; display: flex; align-items: center; gap: 8px; text-decoration: none; color: #000; font-size: 14px; box-shadow: 1px 1px 0 #000; }
        .taskbar-windows { display: flex; gap: 5px; margin-left: 15px; flex: 1; }
        .taskbar-win-tab { background: #dfdfdf; border: 2px solid; border-color: var(--win-light) var(--win-dark) var(--win-dark) var(--win-light); padding: 4px 15px; font-size: 12px; font-weight: bold; color: #333; box-shadow: 1px 1px 0 #000; display: flex; align-items: center; gap: 6px; cursor: pointer; max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .taskbar-win-tab.active { border-color: var(--win-dark) var(--win-light) var(--win-light) var(--win-dark); background: #d0d0d0; box-shadow: none; color: #000; background-image: repeating-linear-gradient(45deg, transparent, transparent 2px, #c0c0c0 2px, #c0c0c0 4px); }
        .subscribe-pill { background: var(--y2k-pink); color: white; padding: 6px 22px; border-radius: 25px; text-decoration: none; font-weight: 900; margin-left: auto; font-size: 13px; border: 2px solid #000; box-shadow: 2px 2px 0 #000; }
        .system-tray { margin-left: 15px; display: flex; gap: 12px; align-items: center; }
        .social-link { color: #000; text-decoration: none; font-size: 11px; font-weight: 900; border: 1px solid var(--win-dark); padding: 3px 8px; background: #eee; }
        .social-link:hover { background: #ddd; }
        .lang-switch { display: flex; gap: 8px; align-items: center; border: 1px solid var(--win-dark); padding: 3px 8px; background: #eee; font-size: 11px; font-weight: bold; }
        .lang-link { color: #888; text-decoration: none; }
        .lang-link:hover { color: var(--y2k-pink); }
        .lang-link.active { color: #000; font-weight: 900; text-decoration: underline; }
        .clock { font-size: 12px; font-weight: bold; border-left: 1px solid var(--win-dark); padding-left: 12px; font-family: monospace; }
    </style>
</head>
<body>
    <div class="marquee-bar">
        <div class="marquee-content">
            ✦ <span style="color:var(--y2k-pink);">Season 4 Early Bird is ON</span> ✦ Ends on <span style="color:var(--y2k-mint);">May 17, 2026</span> ✦ <span style="color:var(--y2k-pink);">All New Curated Main Issues + Zine Newsletters</span> ✦ Capturing imaginations at the edge ✴ &nbsp;&nbsp;&nbsp;
            ✦ <span style="color:var(--y2k-pink);">Season 4 Early Bird is ON</span> ✦ Ends on <span style="color:var(--y2k-mint);">May 17, 2026</span> ✦ <span style="color:var(--y2k-pink);">All New Curated Main Issues + Zine Newsletters</span> ✦ Capturing imaginations at the edge ✴ &nbsp;&nbsp;&nbsp;
        </div>
    </div>

    <div class="desktop-wrapper">
        <aside id="sidebar">
            <div class="side-title">Explorer</div>
            <nav class="nav-list">
                <a href="/en/" class="nav-link nav-active">🏠 HOME</a>
                <a href="/en/about" class="nav-link">🐘 ABOUT</a>
                <a href="/en/archive" class="nav-link">📂 ARCHIVE</a>
                <a href="/en/guestbook" class="nav-link">💬 GUESTBOOK</a>
            </nav>
            <div style="margin-top: auto; padding: 15px; border-top: 1px solid var(--win-dark); font-size: 11px; color:#444;">
                2022.07 - 2026.05 © Elephlow
            </div>
        </aside>

        <div id="playground">
            <div id="home-win" class="window draggable" style="width: 700px; left: 40px; top: 20px; z-index: 100;">
                <div class="title-bar">
                    <div style="display: flex; align-items: center; gap: 6px;">
                        <span style="font-size: 14px;">🔑</span><span>Welcome.exe</span>
                    </div>
                    <div class="win-controls">
                        <div class="win-btn">_</div><div class="win-btn">□</div><div class="win-btn" onclick="this.closest('.window').style.display='none'">×</div>
                    </div>
                </div>
                <div class="win-content">
                    <div class="brand-hero">
                        <h1 class="hero-title" style="font-size: 4.2rem;">Push The Door</h1>
                        <p class="hero-slogan">Capturing imaginations at the edge ✴</p>
                        <div class="ip-house">🏠</div>
                        <div style="display: flex; gap: 15px; margin-top: 20px; flex-wrap: wrap; justify-content: center;">
                            <div class="stat-tag">EST. 2022.07</div>
                            <div class="stat-tag" style="background: var(--y2k-mint);">48 ISSUES IN TOTAL</div>
                        </div>
                        
                        <div class="intro-text">
                            <p>Founded in July 2022, this is a Chinese-language paid newsletter and the independent communication base of <strong>Elephlow</strong>.</p>
                            <p>With words as our vessel, we navigate through the intersections of <strong>Hong Kong & Taiwan pop culture, independent publishing, film festival studies, and queer perspectives</strong>. Without relying on algorithms, we are dedicated to breaking information silos, curating high-quality cultural insights, and providing a genuine, warm reading companionship.</p>
                            <p><strong>"The Room"</strong> is the starting point of privacy, while <strong>"Pushing the Door"</strong> is an action towards the public. We strive to bring closer everything isolated by prejudice. When the next knock sounds, you are invited to push the door open with us and capture the neglected glimmers at the edge of our era.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <footer class="taskbar">
        <a href="/en/" class="start-btn">🐘 Start</a>
        <div class="taskbar-windows">
            <div class="taskbar-win-tab active"><span style="font-size: 13px;">🔑</span> Welcome.exe</div>
        </div>
        <a href="https://tally.so/r/4415XB" target="_blank" class="subscribe-pill">Subscribe Season 4</a>
        
        <div class="system-tray">
            <a href="https://www.instagram.com/icarusrootedbutflow/" target="_blank" class="social-link">INSTAGRAM</a>
            <a href="https://www.xiaohongshu.com/user/profile/5b7e4ac17cdd3b0001bc4c58" target="_blank" class="social-link">RED: @Apollo11-</a>
            
            <div class="lang-switch">
                <a href="/en/" class="lang-link active">EN</a>
                <a href="/zh-tw/" class="lang-link">繁</a>
                <a href="/zh-cn/" class="lang-link">简</a>
            </div>

            <div class="clock" id="live-clock">00:00</div>
        </div>
    </footer>

    <script is:inline>
        const windows = document.querySelectorAll('.draggable');
        let zIndexCounter = 200;
        windows.forEach(win => {
            const titleBar = win.querySelector('.title-bar');
            titleBar.onmousedown = (e) => {
                if (e.target.classList.contains('win-btn')) return;
                win.style.zIndex = ++zIndexCounter;
                let shiftX = e.clientX - win.getBoundingClientRect().left;
                let shiftY = e.clientY - win.getBoundingClientRect().top;
                function moveAt(pageX, pageY) {
                    win.style.left = (pageX - shiftX - 280 - 25) + 'px'; 
                    win.style.top = (pageY - shiftY - 70 - 25) + 'px';
                }
                document.onmousemove = (e) => moveAt(e.pageX, e.pageY);
                document.onmouseup = () => { document.onmousemove = null; };
            };
            win.onmousedown = () => { win.style.zIndex = ++zIndexCounter; };
        });
        function updateClock() {
            const now = new Date();
            document.getElementById('live-clock').innerText = `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`;
        }
        setInterval(updateClock, 1000); updateClock();
    </script>
</body>
</html>