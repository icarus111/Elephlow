---
// src/pages/en/archive.astro
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Archive | Elephlow's Room</title>
    <link href="https://fonts.googleapis.com/css2?family=DotGothic16&family=Noto+Serif:wght@400;700;900&display=swap" rel="stylesheet">
    <style>
        :root{
            --win-gray:#c0c0c0;
            --win-dark:#808080;
            --win-light:#ffffff;
            --win-blue:#000080;
            --y2k-purple:#4B2D8C;
            --y2k-pink:#FF66B3;
            --y2k-mint:#B2F5EA;
            --text:#000000;
        }
        *{margin:0;padding:0;box-sizing:border-box;cursor:default;}
        html,body{height:auto;min-height:100%;}
        body{
            background:linear-gradient(rgba(255,255,255,0.3) 1px,transparent 1px),
                       linear-gradient(90deg,rgba(255,255,255,0.3) 1px,transparent 1px),
                       linear-gradient(to right,#98fb98,#fffacd,#ffebcd,#ffb6c1,#e0b0ff);
            background-size:20px 20px,20px 20px,100% 100%;
            background-attachment:fixed;
            font-family: 'DotGothic16', 'Tahoma', 'MS Sans Serif', sans-serif;
            overflow-x:hidden;overflow-y:auto;display:flex;flex-direction:column;
        }
        
        .marquee-bar{background:#000;color:#0f0;padding:12px 0;min-height:60px;display:flex;align-items:center;overflow:hidden;border-bottom:3px solid var(--win-dark);z-index:2000; position:relative;}
        .marquee-content{display:flex;white-space:nowrap;font-size:1.1rem;animation:scroll 25s linear infinite;letter-spacing:1px;font-weight: bold;}
        @keyframes scroll{0%{transform:translateX(0);}100%{transform:translateX(-50%);}}

        .desktop-wrapper{display:flex;flex:1;padding:25px;gap:40px;padding-bottom:80px;min-height:1000px;position:relative;}
        .desktop-copyright { position: fixed; bottom: 60px; right: 20px; font-size: 12px; color: #555; text-shadow: 1px 1px 0px rgba(255,255,255,0.8); z-index: 10; }

        .desktop-icons{display:flex;flex-direction:column;gap:25px;width:100px;padding-top:10px;z-index:10;}
        .desktop-icon{display:flex;flex-direction:column;align-items:center;text-decoration:none;padding:10px 5px;cursor:pointer;}
        .desktop-icons .icon-emoji{font-size:45px;margin-bottom:5px;filter:drop-shadow(2px 2px 0px rgba(0,0,0,1));}
        .icon-text{color:#fff;background-color:var(--win-blue);font-size:11px;text-align:center;padding:2px 6px;border:1px dotted transparent; width: 85px;}
        .desktop-icon:hover .icon-text { border: 1px dotted #fff; background-color: var(--y2k-purple); }
        
        .archive-folders { display: flex; flex-wrap: wrap; gap: 20px 30px; padding: 20px; align-content: flex-start; max-width: 450px;}
        .folder-btn { display: flex; flex-direction: column; align-items: center; width: 90px; cursor: pointer; }
        .folder-btn .icon-emoji { font-size: 32px; margin-bottom: 5px; filter: drop-shadow(1px 1px 0px rgba(0,0,0,1)); transition: transform 0.1s;}
        .folder-text { color: #000; font-family: 'DotGothic16', sans-serif; font-size: 10px; text-align: center; padding: 2px 6px; background: rgba(255,255,255,0.5); border: 1px dashed var(--win-dark); margin-top: 5px; }
        .folder-btn:hover .icon-emoji { transform: translateY(-2px); }
        .folder-btn:hover .folder-text { background-color: var(--y2k-mint); border: 1px solid #000; box-shadow: 2px 2px 0 var(--y2k-pink); font-weight: bold; }

        #playground{flex:1;position:relative; z-index: 50;}
        
        .window{background:var(--win-gray);border:2px solid;border-color:var(--win-light) #000 #000 var(--win-light);box-shadow:inset 1px 1px 0 #dfdfdf,inset -1px -1px 0 var(--win-dark),2px 2px 0 rgba(0,0,0,0.5);display:none;flex-direction:column;position:fixed;height:auto;padding:3px;z-index:100;}
        .window.active { display: flex; }
        .title-bar{background:linear-gradient(90deg,var(--win-blue),#1084d0);padding:3px 6px;display:flex;justify-content:space-between;align-items:center;color:white;font-size:12px;cursor:move;letter-spacing:1px; user-select: none; font-weight: bold;}
        .win-btn{width:18px;height:18px;background-color:var(--win-gray);border:2px solid;border-color:var(--win-light) var(--win-dark) var(--win-dark) var(--win-light);color:#000;font-family:'Pixel',sans-serif;font-size:10px;font-weight:bold;display:flex;align-items:center;justify-content:center;cursor:pointer;box-shadow:1px 1px 0 #000;}
        
        .win-content{flex:1;margin-top:4px;padding:15px;border:2px solid;border-color:var(--win-dark) var(--win-light) var(--win-light) var(--win-dark);overflow-y: auto; max-height: 480px;}
        .archive-card { background: #fff; border: 2px solid #000; padding: 15px; margin-bottom: 15px; box-shadow: 3px 3px 0px var(--win-gray); display: flex; flex-direction: column;}
        .card-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 10px; flex-wrap: wrap; gap: 8px;}
        .card-title { font-family: 'Noto Serif', serif; font-weight: 900; color: var(--win-blue); font-size: 1.1rem; border-bottom: 3px solid var(--y2k-mint); padding-bottom: 2px; line-height: 1.3;}
        .card-tag { font-family: 'DotGothic16', sans-serif; font-size: 10px; background: #FFE4F2; color: var(--y2k-purple); padding: 2px 8px; border: 1px solid var(--y2k-purple); border-radius: 20px; font-weight: bold; text-transform: uppercase;}
        .card-desc { font-family: 'Noto Serif', serif; color: #333; font-size: 0.9rem; margin-bottom: 15px; line-height: 1.6; flex: 1;}
        .card-desc strong { color: var(--y2k-purple); font-weight: 900;}
        .card-desc ul { margin-left: 20px; margin-top: 5px; color: #555; font-size: 0.85rem; }
        
        .card-actions { display: flex; justify-content: flex-end; gap: 10px; margin-top: auto; border-top: 1px dashed #ccc; padding-top: 10px; }
        .btn-unlock { background: var(--y2k-pink); color: #fff; border: 2px solid #000; box-shadow: 2px 2px 0 #000; padding: 4px 10px; font-size: 11px; text-decoration: none; font-weight: bold; }
        .btn-preview { background: var(--y2k-mint); color: #000; border: 2px solid #000; box-shadow: 2px 2px 0 #000; padding: 4px 10px; font-size: 11px; text-decoration: none; font-weight: bold; }

        /* Theme Styling Overrides */
        #mag-win .win-content { background: repeating-linear-gradient(transparent, transparent 24px, #ccc 24px, #ccc 25px), #fefefe; }
        #mag-win .btn-unlock { background: #4169E1; }
        #bookstore-win .win-content { background-color: #FFF5E1; background-image: radial-gradient(#FFA07A 15%, transparent 15%); background-size: 15px 15px; }
        #bookstore-win .btn-unlock { background: #FF8C00; } 
        #fair-win .win-content { background: repeating-linear-gradient(45deg, #FFE4E1, #FFE4E1 10px, #FFF0F5 10px, #FFF0F5 20px); }
        #fair-win .btn-unlock { background: #FF1493; }
        #resource-win .win-content { background-color: #111; background-image: linear-gradient(#0f0 1px, transparent 1px), linear-gradient(90deg, #0f0 1px, transparent 1px); background-size: 20px 20px; }
        #resource-win .card-title { color: #0f0; border-bottom: 2px dashed #0f0; }
        #resource-win .card-desc { color: #aaa; }
        #resource-win .btn-unlock { background: #0f0; color: #000; }
        #music-win .win-content { background: linear-gradient(135deg, #E6E6FA, #FFF0F5, #E0FFFF); }
        #music-win .btn-unlock { background: #8A2BE2; }
        #film-win .win-content { background: #333; padding: 15px 25px; position: relative; }
        #film-win .win-content::before, #film-win .win-content::after { content:''; position:absolute; top:0; bottom:0; width:10px; background: repeating-linear-gradient(transparent, transparent 10px, #fff 10px, #fff 20px); }
        #film-win .win-content::before { left:4px; } #film-win .win-content::after { right:4px; }
        #film-win .btn-unlock { background: #B22222; }
        #doc-win .win-content { background: #DEB887; }
        #doc-win .btn-unlock { background: #8B4513; }
        #podcast-win .win-content { background-color: #E0FFFF; background-image: repeating-radial-gradient(circle at 0 0, transparent 0, #E0FFFF 10px, #AFEEEE 10px, #AFEEEE 20px); }
        #podcast-win .btn-unlock { background: #20B2AA; }

        .taskbar{position:fixed;bottom:0;left:0;right:0;height:42px;background:var(--win-gray);border-top:2px solid var(--win-light);display:flex;align-items:center;padding:0 6px;z-index:3000;}
        .start-btn{background:var(--win-gray);border:2px solid;border-color:var(--win-light) var(--win-dark) var(--win-dark) var(--win-light);padding:4px 12px;display:flex;align-items:center;gap:8px;text-decoration:none;color:#000;font-size:14px;font-weight:bold;flex-shrink:0;}
        .taskbar-windows{display:flex;gap:5px;margin-left:10px;flex:1;overflow-x:auto;}
        .taskbar-win-tab{background:var(--win-gray);border:2px solid;border-color:var(--win-light) var(--win-dark) var(--win-dark) var(--win-light);padding:4px 10px;font-size:11px;color:#000;display:none;align-items:center;gap:6px;cursor:pointer;max-width:140px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
        .taskbar-win-tab.visible { display: flex; }
        .taskbar-win-tab.active{border-color:var(--win-dark) var(--win-light) var(--win-light) var(--win-dark);background:#d0d0d0;font-weight:bold;}
        .subscribe-pill{background:var(--y2k-pink);color:white;padding:4px 15px;text-decoration:none;border:2px solid #000;box-shadow:2px 2px 0 #000;flex-shrink:0;font-size:12px;font-weight:bold;}
        .system-tray{margin-left:10px;display:flex;gap:8px;align-items:center;flex-shrink:0;border:2px solid;border-color:var(--win-dark) var(--win-light) var(--win-light) var(--win-dark);padding:2px 10px;height:32px;}
        .social-link{color:#000;text-decoration:none;font-size:11px;}
        .lang-switch{display:flex;gap:6px;align-items:center;border-left:1px solid var(--win-dark);border-right:1px solid var(--win-light);padding:0 10px;font-size:12px;}
        .lang-link{color:var(--win-dark);text-decoration:none;}
        .lang-link.active{color:#000;font-weight:bold;text-decoration:underline;}
        .clock{font-size:12px;color:#000;}

        @media (max-width: 900px) {
            .desktop-wrapper { flex-direction: column; padding: 15px; }
            .desktop-icons { flex-direction: row; flex-wrap: wrap; width: 100%; justify-content: center; gap: 10px; }
            .archive-folders { justify-content: center; max-width: 100%; }
            .window { position: fixed !important; width: 92vw !important; left: 4vw !important; top: 10vh !important; }
            .taskbar-windows { display: none; }
        }
    </style>
</head>
<body>
    <div class="marquee-bar">
        <div class="marquee-content">
            >> SYSTEM.MSG: [ <span style="color:var(--y2k-pink);">SEASON 4 EARLY BIRD</span> ] IN PROGRESS_ // ENDS_ON: <span style="color:var(--y2k-mint);">2026.05.17</span> // [ <span style="color:var(--y2k-pink);">NEW CURATED ISSUE + SUPPLEMENT</span> ] // CAPTURE AND IMAGINE AT THE MARGINS ✴ &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
        </div>
    </div>

    <div class="desktop-wrapper">
        <div class="desktop-icons">
            <a href="/" class="desktop-icon"><span class="icon-emoji">🏠</span><span class="icon-text">Home</span></a>
            <a href="/en/about" class="desktop-icon"><span class="icon-emoji">🐘</span><span class="icon-text">About</span></a>
            <a href="/en/archive" class="desktop-icon"><span class="icon-emoji">📂</span><span class="icon-text">Archive</span></a>
            <a href="/en/guestbook" class="desktop-icon"><span class="icon-emoji">💬</span><span class="icon-text">Guestbook</span></a>
        </div>

        <div class="archive-folders">
            <div class="folder-btn" onclick="bringToFront('mag-win')"><span class="icon-emoji">📖</span><span class="folder-text">Zines & Comm.</span></div>
            <div class="folder-btn" onclick="bringToFront('bookstore-win')"><span class="icon-emoji">🏡</span><span class="folder-text">Bookstore Live</span></div>
            <div class="folder-btn" onclick="bringToFront('fair-win')"><span class="icon-emoji">🎪</span><span class="folder-text">Exhibition Tour</span></div>
            <div class="folder-btn" onclick="bringToFront('resource-win')"><span class="icon-emoji">🎒</span><span class="folder-text">Digital Survival</span></div>
            <div class="folder-btn" onclick="bringToFront('music-win')"><span class="icon-emoji">🎧</span><span class="folder-text">Auditory Slice</span></div>
            <div class="folder-btn" onclick="bringToFront('film-win')"><span class="icon-emoji">🎞️</span><span class="folder-text">Cinema Proj.</span></div>
            <div class="folder-btn" onclick="bringToFront('doc-win')"><span class="icon-emoji">📽️</span><span class="folder-text">Reality Freeze</span></div>
            <div class="folder-btn" onclick="bringToFront('podcast-win')"><span class="icon-emoji">📻</span><span class="folder-text">Sound Freq.</span></div>
        </div>

        <div id="playground">
            
            <!-- Window 1: Zines & Print -->
            <div id="mag-win" class="window draggable" style="width: 480px; left: 10vw; top: 10vh;">
                <div class="title-bar"><span>📖 Zines_Comm.doc</span><div class="win-btn" onclick="closeWin('mag-win')">×</div></div>
                <div class="win-content">
                    <div class="archive-card">
                        <div class="card-header"><span class="card-title">Issue#01 Our Enclave</span><span class="card-tag">LITERATURE</span></div>
                        <div class="card-desc">Exploring <strong>UNITAS</strong> and <strong>Fountain</strong>, with guides on how to access HK/TW academic journals and theses.</div>
                        <div class="card-actions"><a href="https://elephlow1217.notion.site/Issue-01-1-35115431c08d8120ba20f72b2be8571d" target="_blank" class="btn-preview">✨ Preview</a></div>
                    </div>
                    <div class="archive-card">
                        <div class="card-header"><span class="card-title">Issue#18 La Dolce Vita</span><span class="card-tag">EARLY PUB</span></div>
                        <div class="card-desc">Exploring the legendary <strong>ECHO Magazine (漢聲)</strong> and early Taiwanese pop culture and publishing ecology.</div>
                        <div class="card-actions"><a href="https://tally.so/r/4415XB" target="_blank" class="btn-unlock">🔒 Unlock</a></div>
                    </div>
                </div>
            </div>

            <!-- Window 2: Bookstores -->
            <div id="bookstore-win" class="window draggable" style="width: 480px; left: 15vw; top: 15vh;">
                <div class="title-bar"><span>🏡 Bookstores_Live.exe</span><div class="win-btn" onclick="closeWin('bookstore-win')">×</div></div>
                <div class="win-content">
                    <div class="archive-card">
                        <div class="card-header"><span class="card-title">Issue#13 Stay Confused & Curious</span><span class="card-tag">TAIPEI</span></div>
                        <div class="card-desc">Tour 001: <strong>Garden City Publishers</strong>, a space full of design and independent publishing vitality.</div>
                        <div class="card-actions"><a href="https://tally.so/r/4415XB" target="_blank" class="btn-unlock">🔒 Unlock</a></div>
                    </div>
                    <div class="archive-card">
                        <div class="card-header"><span class="card-title">HK Indie Bookstore Tour</span><span class="card-tag">HONG KONG</span></div>
                        <div class="card-desc">Featuring <strong>Zine Coop</strong> and a comprehensive list of overseas independent bookstores.</div>
                        <div class="card-actions"><a href="https://tally.so/r/4415XB" target="_blank" class="btn-unlock">🔒 Unlock</a></div>
                    </div>
                </div>
            </div>

            <!-- Window 3: Exhibitions -->
            <div id="fair-win" class="window draggable" style="width: 480px; left: 20vw; top: 20vh;">
                <div class="title-bar"><span>🎪 Exhibitions_Tour.txt</span><div class="win-btn" onclick="closeWin('fair-win')">×</div></div>
                <div class="win-content">
                    <div class="archive-card">
                        <div class="card-header"><span class="card-title">Newsletter 012: Grass Camp</span><span class="card-tag">ART BOOK FAIR</span></div>
                        <div class="card-desc">Guided tour and deep observation of the <strong>Taipei Art Book Fair (草率季)</strong>.</div>
                        <div class="card-actions"><a href="https://tally.so/r/4415XB" target="_blank" class="btn-unlock">🔒 Unlock</a></div>
                    </div>
                    <div class="archive-card">
                        <div class="card-header"><span class="card-title">Issue#11 HK Book Fair</span><span class="card-tag">BOOK FAIR</span></div>
                        <div class="card-desc">Observations and publication recommendations from the <strong>Hong Kong Book Fair</strong>.</div>
                        <div class="card-actions"><a href="https://tally.so/r/4415XB" target="_blank" class="btn-unlock">🔒 Unlock</a></div>
                    </div>
                </div>
            </div>

            <!-- Window 4: Digital Survival -->
            <div id="resource-win" class="window draggable" style="width: 480px; left: 25vw; top: 25vh;">
                <div class="title-bar"><span>🎒 Digital_Survival.zip</span><div class="win-btn" onclick="closeWin('resource-win')">×</div></div>
                <div class="win-content">
                    <div class="archive-card">
                        <div class="card-header"><span class="card-title">Issue#31: Toolbox Special</span><span class="card-tag">HACK & AI</span></div>
                        <div class="card-desc">A guide for humanity students: <strong>How to read world magazines for free</strong> and AI use cases.</div>
                        <div class="card-actions"><a href="https://tally.so/r/4415XB" target="_blank" class="btn-unlock">🔒 Unlock</a></div>
                    </div>
                </div>
            </div>

            <!-- Window 5: Auditory Slices -->
            <div id="music-win" class="window draggable" style="width: 480px; left: 30vw; top: 15vh;">
                <div class="title-bar"><span>🎧 Auditory_Slices.wav</span><div class="win-btn" onclick="closeWin('music-win')">×</div></div>
                <div class="win-content">
                    <div class="archive-card">
                        <div class="card-header"><span class="card-title">Issue#36 Turn Back</span><span class="card-tag">MUSICIAN</span></div>
                        <div class="card-desc">Female Artists 010: Persistent and moving forward—<strong>Vicky Fung (馮穎琪)</strong>.</div>
                        <div class="card-actions"><a href="https://elephlow1217.notion.site/Issue-36-39e15431c08d831f8c6281af440ecc69" target="_blank" class="btn-preview">✨ Preview</a></div>
                    </div>
                    <div class="archive-card">
                        <div class="card-header"><span class="card-title">Issue#31 Love</span><span class="card-tag">VOCALIST</span></div>
                        <div class="card-desc">Emotional surges behind the rational mask—<strong>Hung Pei-yu (洪佩瑜)</strong>.</div>
                        <div class="card-actions"><a href="https://tally.so/r/4415XB" target="_blank" class="btn-unlock">🔒 Unlock</a></div>
                    </div>
                </div>
            </div>

            <!-- Window 6: Cinema Projection -->
            <div id="film-win" class="window draggable" style="width: 480px; left: 35vw; top: 20vh;">
                <div class="title-bar"><span>🎞️ Cinema_Projection.mp4</span><div class="win-btn" onclick="closeWin('film-win')">×</div></div>
                <div class="win-content">
                    <div class="archive-card">
                        <div class="card-header"><span class="card-title">Issue#29 Queer Cinema</span><span class="card-tag">QUEER</span></div>
                        <div class="card-desc">Happy Pride Month! A list of <strong>4 Queer directors and 31 essential Queer films/series</strong>.</div>
                        <div class="card-actions"><a href="https://tally.so/r/4415XB" target="_blank" class="btn-unlock">🔒 Unlock</a></div>
                    </div>
                    <div class="archive-card">
                        <div class="card-header"><span class="card-title">Issue#17 New Year Letter</span><span class="card-tag">AWARDS</span></div>
                        <div class="card-desc">2023 Film Summary (Full), and putting the puzzles of <strong>Edward Yang (楊德昌)</strong> back together.</div>
                        <div class="card-actions"><a href="https://tally.so/r/4415XB" target="_blank" class="btn-unlock">🔒 Unlock</a></div>
                    </div>
                </div>
            </div>

            <!-- Window 7: Reality Freeze -->
            <div id="doc-win" class="window draggable" style="width: 480px; left: 40vw; top: 25vh;">
                <div class="title-bar"><span>📽️ Reality_Freeze.avi</span><div class="win-btn" onclick="closeWin('doc-win')">×</div></div>
                <div class="win-content">
                    <div class="archive-card">
                        <div class="card-header"><span class="card-title">Issue#08 Wandering Body</span><span class="card-tag">DOC</span></div>
                        <div class="card-desc">Deep analysis of the <strong>Taiwan International Documentary Festival (TIDF)</strong>.</div>
                        <div class="card-actions"><a href="https://tally.so/r/4415XB" target="_blank" class="btn-unlock">🔒 Unlock</a></div>
                    </div>
                    <div class="archive-card">
                        <div class="card-header"><span class="card-title">Issue#12 Breaking & Regrowing</span><span class="card-tag">ARTS DOC</span></div>
                        <div class="card-desc"><strong>Chiayi International Art Doc Film Festival</strong> and Edward Yang retrospectives.</div>
                        <div class="card-actions"><a href="https://tally.so/r/4415XB" target="_blank" class="btn-unlock">🔒 Unlock</a></div>
                    </div>
                </div>
            </div>

            <!-- Window 8: Podcasts -->
            <div id="podcast-win" class="window draggable" style="width: 480px; left: 45vw; top: 30vh;">
                <div class="title-bar"><span>📻 Sound_Freq.mp3</span><div class="win-btn" onclick="closeWin('podcast-win')">×</div></div>
                <div class="win-content">
                    <div class="archive-card">
                        <div class="card-header"><span class="card-title">Issue#35 Chinese Podcast Awards</span><span class="card-tag">AWARDS 2025</span></div>
                        <div class="card-desc">Radio Special: <strong>2025 My Favorite Chinese Podcasts</strong> of the Year.</div>
                        <div class="card-actions"><a href="https://tally.so/r/4415XB" target="_blank" class="btn-unlock">🔒 Unlock</a></div>
                    </div>
                    <div class="archive-card">
                        <div class="card-header"><span class="card-title">Issue#26 Best of 2024</span><span class="card-tag">AWARDS 2024</span></div>
                        <div class="card-desc">Yearly Review: Voices that accompanied our ears throughout 2024.</div>
                        <div class="card-actions"><a href="https://tally.so/r/4415XB" target="_blank" class="btn-unlock">🔒 Unlock</a></div>
                    </div>
                </div>
            </div>

        </div>
        
        <div class="desktop-copyright">2022.07 - 2026.05 © Elephlow</div>
    </div>

    <footer class="taskbar">
        <a href="/" class="start-btn">🐘 Start</a>
        <div class="taskbar-windows">
            <div class="taskbar-win-tab" id="tab-mag-win" onclick="bringToFront('mag-win')"><span>📖</span> Zines & Comm.</div>
            <div class="taskbar-win-tab" id="tab-bookstore-win" onclick="bringToFront('bookstore-win')"><span>🏡</span> Bookstore</div>
            <div class="taskbar-win-tab" id="tab-fair-win" onclick="bringToFront('fair-win')"><span>🎪</span> Exhibitions</div>
