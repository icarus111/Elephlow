<!DOCTYPE html>

<html lang="zh-TW">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>推開部屋的門 | Home</title>

    <link href="https://fonts.googleapis.com/css2?family=DotGothic16&family=Noto+Serif+TC:wght@400;700;900&display=swap" rel="stylesheet">

    <style>

        :root {

            /* 經典 Windows 95/98 配色 */

            --win-gray: #c0c0c0; 

            --win-dark: #808080; 

            --win-light: #ffffff;

            --win-blue: #000080;

            --y2k-purple: #4B2D8C; 

            --y2k-pink: #FF66B3; 

            --y2k-mint: #B2F5EA; 

            --text: #000000;

        }

        * { margin: 0; padding: 0; box-sizing: border-box; cursor: default; }

        

        html, body { height: auto; min-height: 100%; }



        body {

            /* 加上一層復古的 20px 網格線，讓彩虹背景更有電腦螢幕感 */

            background: 

                linear-gradient(rgba(255,255,255,0.3) 1px, transparent 1px),

                linear-gradient(90deg, rgba(255,255,255,0.3) 1px, transparent 1px),

                linear-gradient(to right, #98fb98, #fffacd, #ffebcd, #ffb6c1, #e0b0ff);

            background-size: 20px 20px, 20px 20px, 100% 100%;

            background-attachment: fixed; 

            /* 全域字體改為像素字體與細明體，瞬間回到 2000 年 */

            font-family: 'DotGothic16', 'PMingLiU', 'MingLiU', '細明體', 'SimSun', sans-serif; 

            overflow-x: hidden; overflow-y: auto; 

            display: flex; flex-direction: column;

        }



        /* 跑馬燈：駭客終端機風格 */

        .marquee-bar { background: #000; color: #0f0; padding: 12px 0; min-height: 60px; display: flex; align-items: center; overflow: hidden; border-bottom: 3px solid var(--win-dark); z-index: 2000; }

        .marquee-content { display: flex; white-space: nowrap; font-size: 1.2rem; animation: scroll 25s linear infinite; letter-spacing: 2px;}

        @keyframes scroll { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }



        .desktop-wrapper { display: flex; flex: 1; padding: 25px; gap: 40px; padding-bottom: 80px; min-height: 1000px; position: relative; }



        /* --- 🌟 真正的 Y2K 桌面圖示 --- */

        .desktop-icons { display: flex; flex-direction: column; gap: 25px; width: 100px; padding-top: 10px; z-index: 10; }

        .desktop-icon { display: flex; flex-direction: column; align-items: center; text-decoration: none; padding: 10px 5px; cursor: pointer; }

        

        .icon-emoji { font-size: 40px; margin-bottom: 5px; filter: drop-shadow(2px 2px 0px rgba(0,0,0,1)); /* 銳利的純黑陰影製造像素感 */ }

        

        .icon-text { 

            color: #fff; background-color: var(--win-blue); /* 經典桌面藍底白字 */

            font-size: 13px; text-align: center; padding: 2px 6px; 

            border: 1px dotted transparent; 

        }

        .desktop-icon:hover .icon-text { border: 1px dotted #fff; background-color: var(--y2k-purple); }



        .desktop-copyright { position: fixed; bottom: 60px; right: 20px; font-size: 12px; color: #555; text-shadow: 1px 1px 0px rgba(255,255,255,0.8); z-index: 10; }



        /* --- 🌟 經典立體視窗 --- */

        #playground { flex: 1; position: relative; }

        .window {

            background: var(--win-gray); 

            /* 靈魂：左白右上、右灰下黑的 3D 浮雕邊框 */

            border: 2px solid; border-color: var(--win-light) #000 #000 var(--win-light);

            box-shadow: inset 1px 1px 0 #dfdfdf, inset -1px -1px 0 var(--win-dark), 2px 2px 0 rgba(0,0,0,0.5); 

            display: flex; flex-direction: column; position: absolute; height: auto; min-height: 400px; padding: 3px;

        }

        .title-bar { 

            /* 標題列漸層 */

            background: linear-gradient(90deg, var(--win-blue), #1084d0); 

            padding: 3px 6px; display: flex; justify-content: space-between; align-items: center; color: white; font-size: 13px; cursor: move; letter-spacing: 1px;

        }

        

        .win-controls { display: flex; gap: 2px; margin-left: 10px; }

        .win-btn { 

            width: 18px; height: 18px; background-color: var(--win-gray); 

            border: 2px solid; border-color: var(--win-light) var(--win-dark) var(--win-dark) var(--win-light); 

            color: #000; font-family: 'Pixel', sans-serif; font-size: 10px; font-weight: bold; 

            display: flex; align-items: center; justify-content: center; cursor: pointer; box-shadow: 1px 1px 0 #000;

        }

        .win-btn:active { border-color: var(--win-dark) var(--win-light) var(--win-light) var(--win-dark); padding-top: 2px; padding-left: 2px; box-shadow: none; }



        /* 視窗內容區塊做成「內凹」的效果 */

        .win-content { 

            flex: 1; background: white; margin-top: 4px; padding: 40px; 

            border: 2px solid; border-color: var(--win-dark) var(--win-light) var(--win-light) var(--win-dark);

        }

        

        .brand-hero { display: flex; flex-direction: column; justify-content: center; align-items: center; }

        

        /* 閱讀內容保留優雅的 Serif 字體，與復古外框形成強烈對比 */

        .hero-title { font-family: 'Noto Serif TC', serif; font-size: 4.5rem; font-weight: 900; color: var(--y2k-purple); line-height: 1.2; text-align: center; letter-spacing: 0.05em; text-shadow: 4px 4px 0px var(--y2k-mint); margin-bottom: 10px; }

        .hero-slogan { font-family: 'DotGothic16', sans-serif; font-weight: 900; color: var(--y2k-pink); font-size: 1.2rem; letter-spacing: 0.3rem; margin-bottom: 25px; text-align: center;}

        

        .ip-house { margin: 20px 0; width: 120px; height: 120px; border: 4px solid var(--text); background: var(--y2k-pink); display: flex; align-items: center; justify-content: center; font-size: 4rem; box-shadow: 8px 8px 0px #000; }

        

        .stat-tag { border: 2px solid #000; padding: 6px 15px; font-size: 14px; background: var(--win-gray); box-shadow: 2px 2px 0 #000; }



        .intro-text { max-width: 580px; margin-top: 35px; color: #111; line-height: 2; text-align: justify; font-size: 1rem; border-top: 2px dotted var(--win-dark); padding-top: 25px; font-family: 'Noto Serif TC', serif; }

        .intro-text p { margin-bottom: 15px; }

        .intro-text strong { color: var(--y2k-purple); font-weight: 900;}



        /* --- 🌟 經典立體任務欄 --- */

        .taskbar { 

            position: fixed; bottom: 0; left: 0; right: 0; height: 42px; background: var(--win-gray); 

            border-top: 2px solid var(--win-light); display: flex; align-items: center; padding: 0 6px; z-index: 3000; 

            box-shadow: inset 0 1px 0 #dfdfdf; 

        }

        

        .start-btn { 

            background: var(--win-gray); border: 2px solid; border-color: var(--win-light) var(--win-dark) var(--win-dark) var(--win-light); 

            padding: 4px 12px; display: flex; align-items: center; gap: 8px; text-decoration: none; color: #000; font-size: 15px; font-weight: bold; flex-shrink: 0;

        }

        .start-btn:active { border-color: var(--win-dark) var(--win-light) var(--win-light) var(--win-dark); padding: 5px 11px 3px 13px; }



        .taskbar-windows { display: flex; gap: 5px; margin-left: 10px; flex: 1; overflow-x: auto; }

        

        .taskbar-win-tab { 

            background: var(--win-gray); border: 2px solid; border-color: var(--win-light) var(--win-dark) var(--win-dark) var(--win-light); 

            padding: 4px 12px; font-size: 13px; color: #000; display: flex; align-items: center; gap: 6px; cursor: pointer; max-width: 200px;

        }

        /* 被選中的視窗標籤：內凹 + 復古網點背景 */

        .taskbar-win-tab.active { 

            border-color: var(--win-dark) var(--win-light) var(--win-light) var(--win-dark); 

            background: #d0d0d0; font-weight: bold;

            background-image: repeating-linear-gradient(45deg, transparent, transparent 2px, #c0c0c0 2px, #c0c0c0 4px); 

        }



        .subscribe-pill { background: var(--y2k-pink); color: white; padding: 4px 15px; text-decoration: none; border: 2px solid #000; box-shadow: 2px 2px 0 #000; flex-shrink: 0; font-size: 13px; }

        

        /* 系統托盤 (右下角時間區) 必須是內凹的 */

        .system-tray { margin-left: 10px; display: flex; gap: 8px; align-items: center; flex-shrink: 0; border: 2px solid; border-color: var(--win-dark) var(--win-light) var(--win-light) var(--win-dark); padding: 2px 10px; height: 32px;}

        

        .social-link { color: #000; text-decoration: none; font-size: 12px; }

        .social-link:hover { color: var(--win-blue); text-decoration: underline; }

        

        .lang-switch { display: flex; gap: 6px; align-items: center; border-left: 1px solid var(--win-dark); border-right: 1px solid var(--win-light); padding: 0 10px; font-size: 13px; }

        .lang-link { color: var(--win-dark); text-decoration: none; }

        .lang-link.active { color: #000; font-weight: bold; text-decoration: underline; }

        

        .clock { font-size: 13px; color: #000; }



        @media (max-width: 900px) {

            .desktop-wrapper { flex-direction: column; padding: 15px; padding-bottom: 70px; min-height: auto; }

            .desktop-icons { flex-direction: row; flex-wrap: wrap; width: 100%; justify-content: center; gap: 15px; padding-bottom: 20px; }

            .desktop-icon { width: 80px; padding: 5px; }

            .window { position: relative !important; width: 100% !important; left: 0 !important; top: 0 !important; min-height: auto; }

            .win-content { padding: 25px 15px; }

            .hero-title { font-size: 2.8rem; }

            .hero-slogan { font-size: 1rem; letter-spacing: 0.1rem; }

            .ip-house { width: 90px; height: 90px; font-size: 2.5rem; }

            .taskbar { padding: 0 6px; overflow-x: auto; white-space: nowrap; gap: 8px; justify-content: flex-start; height: 48px; }

            .taskbar::-webkit-scrollbar { display: none; }

            .taskbar-windows { display: none; }

            .subscribe-pill { margin-left: 0; }

            .system-tray { margin-left: 0; }

            .desktop-copyright { position: static; text-align: center; margin: 20px 0; }

        }

    </style>

</head>

<body>

    <div class="marquee-bar">

