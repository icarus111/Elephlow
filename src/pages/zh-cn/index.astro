---
import '../../styles/global.css';
---
<!DOCTYPE html>
<html lang="zh-cn">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>推开部屋的门 | elephlow</title>
  <meta name="description" content="一份中文付费电子报，写在港台日韩独立文化的边缘。" />
</head>
<body>

  <div class="page-container">

    <!-- ═══════════════════════════════
         WELCOME BANNER（绿色条纹基底）
         ═══════════════════════════════ -->
    <header class="welcome-banner">
      <div class="welcome-inner">
        <div class="pixel-icon">
          <span style="font-size: 48px;">🐘</span>
        </div>
        <div class="welcome-text">
          <p class="welcome-line1">✿ Welcome to ✿</p>
          <h1 class="site-title">elephlow's homepage</h1>
          <p class="welcome-line2">since 2022.07 · ☘ 推开部屋的门 ☘</p>
        </div>
      </div>
    </header>

    <!-- ═══════════════════════════════
         MAIN GRID（三栏：左侧栏 / 主内容 / 右侧菜单）
         ═══════════════════════════════ -->
    <div class="main-grid">

      <!-- 左侧栏 -->
      <aside class="left-column">
        <!-- icons row 装饰 -->
        <div class="deco-icons">
          <span>📕</span><span>☘</span><span>✦</span>
          <span>📩</span><span>🍵</span><span>♬</span>
        </div>

        <!-- 日历占位（阶段 4 建组件） -->
        <div class="calendar-placeholder">
          <div class="calendar-title">📅 2026年 5月</div>
          <p class="placeholder-note">日历组件 · 下阶段建好</p>
        </div>

        <!-- 状态信息 -->
        <div class="status-info">
          <p>last update: 2026.05.11</p>
          <p>currently: 第四季筹备中</p>
          <p>contact: hello@elephlow.cc</p>
        </div>
      </aside>

      <!-- 中间主内容 -->
      <main class="center-column">
        <div class="intro-card">
          <div class="intro-tabs">
            <span class="tab tab-active">≋ 推开部屋的门 ≋</span>
          </div>
          <p class="intro-tagline">在边缘捕捉与想象 ✦</p>
          <div class="intro-body">
            <p>这是一份创办于 2022 年 7 月的中文付费电子报，写在港台日韩独立文化的边缘。</p>
            <p>从独立书店、播客电台、小型乐团、Zine 到酷儿艺术——记录作为编辑、读者、行者、酷儿女性的所见所感。</p>
            <p>三季已完结，共 48 期。<strong>第四季 2026 启动。</strong></p>
          </div>
          <div class="cta-row">
            <a href="https://tally.so/r/4415XB" class="cta-button cta-primary">★ 订阅第四季 ★</a>
            <a href="/zh-cn/archive" class="cta-button cta-secondary">看往期目录 →</a>
          </div>
        </div>
      </main>

      <!-- 右侧菜单（致敬 yotsu's Homepage 的 colored MENU） -->
      <aside class="right-column">
        <div class="menu-card">
          <h3 class="menu-title">▼ MENU ▼</h3>
          <ul class="menu-list">
            <li><a href="/zh-cn/about" class="menu-mint">about 小象</a></li>
            <li><a href="/zh-cn/archive" class="menu-aqua">往期目录</a></li>
            <li><a href="/zh-cn/guestbook" class="menu-pink">留言板</a></li>
            <li><a href="https://tally.so/r/4415XB" class="menu-purple">★ 订阅 ★</a></li>
          </ul>
        </div>

        <!-- guestbook 小卡片 -->
        <div class="guestbook-card">
          <a href="/zh-cn/guestbook">
            <span class="gb-icon">✉</span>
            <span class="gb-text">sign my guestbook</span>
          </a>
        </div>
      </aside>

    </div>

  </div>

  <style>
    /* === 容器 === */
    .page-container {
      max-width: 1100px;
      margin: 0 auto;
      padding: 32px 24px 80px;
    }

    /* === Welcome Banner（绿色条纹） === */
    .welcome-banner {
      background-color: var(--candy-mint);
      background-image: repeating-linear-gradient(
        135deg,
        var(--candy-mint),
        var(--candy-mint) 16px,
        var(--candy-aqua) 16px,
        var(--candy-aqua) 32px,
        var(--candy-cream) 32px,
        var(--candy-cream) 48px,
        var(--candy-pink) 48px,
        var(--candy-pink) 64px
      );
      padding: 0;
      border-radius: var(--radius-soft);
      border: 3px solid var(--ink);
      box-shadow: 5px 5px 0 var(--ink);
      margin-bottom: 32px;
      overflow: hidden;
    }

    .welcome-inner {
      background: var(--soft-white);
      margin: 8px;
      padding: 24px 32px;
      border-radius: 6px;
      display: flex;
      align-items: center;
      gap: 24px;
    }

    .pixel-icon {
      flex-shrink: 0;
    }

    .welcome-line1 {
      font-family: var(--font-pixel);
      font-size: 13px;
      color: var(--candy-purple);
      margin: 0;
    }

    .site-title {
      font-family: var(--font-bubble);
      font-size: 36px;
      color: var(--candy-mint);
      text-shadow: 2px 2px 0 var(--candy-purple);
      margin: 6px 0;
      line-height: 1.1;
      letter-spacing: 1px;
    }

    .welcome-line2 {
      font-family: var(--font-pixel);
      font-size: 11px;
      color: var(--ink-light);
      margin: 0;
      letter-spacing: 0.5px;
    }

    /* === Main Grid === */
    .main-grid {
      display: grid;
      grid-template-columns: 220px 1fr 200px;
      gap: 24px;
      align-items: start;
    }

    /* === 左侧栏 === */
    .deco-icons {
      display: grid;
      grid-template-columns: repeat(6, 1fr);
      gap: 4px;
      padding: 12px 8px;
      background: var(--soft-white);
      border: 2px dashed var(--candy-mint);
      border-radius: var(--radius-soft);
      margin-bottom: 16px;
      text-align: center;
      font-size: 18px;
    }

    .calendar-placeholder {
      background: var(--soft-white);
      border: 2px solid var(--candy-mint);
      border-radius: var(--radius-soft);
      padding: 16px;
      margin-bottom: 16px;
      box-shadow: 3px 3px 0 var(--candy-aqua);
    }

    .calendar-title {
      font-family: var(--font-mochi);
      font-size: 15px;
      text-align: center;
      padding-bottom: 10px;
      border-bottom: 1px dashed var(--candy-mint);
      color: var(--candy-purple);
    }

    .placeholder-note {
      text-align: center;
      color: var(--ink-light);
      font-size: 12px;
      font-family: var(--font-pixel);
      padding: 16px 0 8px;
      margin: 0;
    }

    .status-info {
      font-family: var(--font-pixel);
      font-size: 11px;
      color: var(--ink-light);
      padding: 14px 12px;
      background: var(--candy-mint);
      border-radius: var(--radius-card);
      line-height: 1.8;
    }

    .status-info p {
      margin: 0;
    }

    /* === 中间主内容 === */
    .intro-card {
      background: var(--soft-white);
      border: 3px solid var(--candy-mint);
      border-radius: var(--radius-soft);
      padding: 36px 40px;
      box-shadow: 4px 4px 0 var(--candy-aqua);
    }

    .intro-tabs {
      text-align: center;
      margin-bottom: 8px;
    }

    .tab {
      display: inline-block;
      font-family: var(--font-mochi);
      font-size: 22px;
      color: var(--candy-purple);
      padding: 4px 16px;
    }

    .intro-tagline {
      text-align: center;
      font-family: var(--font-rounded);
      font-weight: 700;
      font-size: 16px;
      color: var(--candy-pink);
      margin-bottom: 28px;
    }

    .intro-body p {
      font-family: var(--font-serif-sc);
      line-height: 2;
      margin-bottom: 14px;
      font-size: 15px;
      color: var(--ink);
    }

    .intro-body strong {
      color: var(--candy-purple);
      background: linear-gradient(transparent 60%, var(--candy-aqua) 60%);
    }

    .cta-row {
      display: flex;
      gap: 12px;
      justify-content: center;
      margin-top: 28px;
      flex-wrap: wrap;
    }

    .cta-button {
      display: inline-block;
      padding: 12px 24px;
      font-family: var(--font-rounded);
      font-weight: 700;
      text-decoration: none;
      border-radius: var(--radius-pill);
      border: 2px solid var(--ink);
      box-shadow: 3px 3px 0 var(--ink);
      transition: transform 0.15s;
    }

    .cta-button:hover {
      transform: translate(-2px, -2px);
      box-shadow: 5px 5px 0 var(--ink);
      text-decoration: none;
    }

    .cta-primary {
      background: var(--candy-mint);
      color: var(--ink);
    }

    .cta-secondary {
      background: var(--soft-white);
      color: var(--ink);
    }

    /* === 右侧菜单 === */
    .menu-card {
      background: var(--soft-white);
      border: 2px solid var(--ink);
      border-radius: var(--radius-soft);
      padding: 8px;
      box-shadow: 3px 3px 0 var(--ink);
      margin-bottom: 16px;
    }

    .menu-title {
      font-family: var(--font-pixel);
      font-size: 13px;
      text-align: center;
      padding: 10px 4px;
      margin: 0 0 6px;
      color: var(--candy-purple);
      background: var(--candy-mint);
      border-radius: var(--radius-card);
    }

    .menu-list {
      list-style: none;
      padding: 0;
      margin: 0;
    }

    .menu-list li {
      margin-bottom: 4px;
    }

    .menu-list a {
      display: block;
      padding: 12px 14px;
      text-align: center;
      font-family: var(--font-rounded);
      font-weight: 700;
      font-size: 14px;
      color: var(--ink);
      text-decoration: none;
      border-radius: var(--radius-card);
      border: 1.5px solid var(--ink);
      transition: transform 0.15s, box-shadow 0.15s;
    }

    .menu-list a:hover {
      transform: translate(-2px, -2px);
      box-shadow: 3px 3px 0 var(--ink);
      text-decoration: none;
    }

    .menu-mint { background: var(--candy-mint); }
    .menu-aqua { background: var(--candy-aqua); }
    .menu-pink { background: var(--candy-pink); }
    .menu-purple { background: var(--candy-purple); }

    /* === Guestbook 小卡片 === */
    .guestbook-card a {
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 16px;
      background: var(--candy-cream);
      border: 2px solid var(--ink);
      border-radius: var(--radius-soft);
      box-shadow: 3px 3px 0 var(--candy-pink);
      text-decoration: none;
      color: var(--ink);
      transition: transform 0.15s;
    }

    .guestbook-card a:hover {
      transform: translate(-2px, -2px);
      box-shadow: 5px 5px 0 var(--candy-pink);
      text-decoration: none;
    }

    .gb-icon {
      font-size: 28px;
      margin-bottom: 4px;
    }

    .gb-text {
      font-family: var(--font-pixel);
      font-size: 11px;
      color: var(--candy-purple);
    }

    /* === 响应式 === */
    @media (max-width: 900px) {
      .main-grid {
        grid-template-columns: 1fr;
      }
      .site-title {
        font-size: 28px;
      }
    }
  </style>

</body>
</html>
