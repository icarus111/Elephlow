---
import '../../styles/global.css';
import ArchivePortrait from '../../components/sidebar/ArchivePortrait.astro';
import ArchiveStats from '../../components/sidebar/ArchiveStats.astro';
---
<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>往期目录 | 推开部屋的门</title>
  <meta name="description" content="推开部屋的门 - 往期电子报目录与精选文章" />
</head>
<body>

  <main class="home-window">

    <header class="window-titlebar">
      <div class="titlebar-left">
        <span class="title-dots">● ● ●</span>
        <span class="titlebar-text">elephlow.cc / 往期目录</span>
      </div>
      <div class="titlebar-right">
        <a href="/zh-cn/archive" class="lang-link lang-active">简</a>
        <a href="/zh-tw/archive" class="lang-link">繁</a>
        <a href="/en/archive" class="lang-link">EN</a>
      </div>
    </header>

    <div class="window-content archive-layout">

      <aside class="archive-left sticky-sidebar">

        <ArchivePortrait />
        <ArchiveStats locale="zh-cn" />

        <div class="index-card">
          <h3 class="card-title">✿ category ✿</h3>
          <nav class="cat-nav">
            <a href="#cat-zine"><span class="cat-dot bg-mint"></span>📖 纸本通信</a>
            <a href="#cat-bookstore"><span class="cat-dot bg-peach"></span>🏡 书店现场</a>
            <a href="#cat-fair"><span class="cat-dot bg-pink"></span>🎪 展场漫游</a>
            <a href="#cat-resource"><span class="cat-dot bg-aqua"></span>🎒 数字生存</a>
            <a href="#cat-music"><span class="cat-dot bg-purple"></span>🎧 听觉切片</a>
            <a href="#cat-film"><span class="cat-dot bg-cream"></span>🎞️ 光影放映</a>
            <a href="#cat-doc"><span class="cat-dot bg-mint"></span>📽️ 真实定格</a>
            <a href="#cat-podcast"><span class="cat-dot bg-aqua"></span>📻 声音频率</a>
          </nav>
        </div>

      </aside>

      <section class="archive-center">
        <div class="board-card">
          <h2 class="board-title">⌒ 往期目录 ⌒</h2>
          <p class="board-subtitle">Past Issues & Newsletters ｡^‿^｡</p>

          <div class="board-content">

            <div id="cat-zine" class="cat-section">
              <h3 class="cat-heading mint-heading">📖 纸本通信</h3>

              <div class="issue-card border-mint">
                <div class="issue-header">
                  <span class="issue-title">Issue#01 我们的飞地</span>
                  <span class="issue-tag bg-mint">LITERATURE</span>
                </div>
                <p class="issue-desc">从文学期刊出发，探讨 <strong>《联合文学》</strong> 与 <strong>《新活水》</strong>，并附港台期刊、博硕士论文查阅方式。</p>
                <div class="issue-actions">
                  <a href="https://elephlow1217.notion.site/Issue-01-1-35115431c08d8120ba20f72b2be8571d" target="_blank" class="issue-btn btn-preview">✨ 免费试阅</a>
                </div>
              </div>

              <div class="issue-card border-mint">
                <div class="issue-header">
                  <span class="issue-title">阅读小报 002：正发生</span>
                  <span class="issue-tag bg-mint">ZINE & PUB</span>
                </div>
                <p class="issue-desc">图解酷儿史、Garo漫画大革命，以及 <strong>VOP 摄影之声</strong> 等出版物梳理。</p>
                <div class="issue-actions">
                  <a href="https://elephlow1217.notion.site/002-35415431c08d80f8888dd173b80840a3" target="_blank" class="issue-btn btn-preview">✨ 免费试阅</a>
                </div>
              </div>

              <div class="issue-card border-mint">
                <div class="issue-header">
                  <span class="issue-title">Issue#19 沉默之声</span>
                  <span class="issue-tag bg-mint">PUBLISHING</span>
                </div>
                <p class="issue-desc">逃离与失声：探讨 <strong>《皇冠》杂志</strong> 历史与其背后的出版帝国。</p>
                <div class="issue-actions">
                  <a href="https://tally.so/r/4415XB" target="_blank" class="issue-btn btn-lock">🔒 解锁本期</a>
                </div>
              </div>
            </div>

            <div id="cat-bookstore" class="cat-section">
              <h3 class="cat-heading peach-heading">🏡 书店现场</h3>

              <div class="issue-card border-peach">
                <div class="issue-header">
                  <span class="issue-title">Issue#13 永远困惑，永远好奇。</span>
                  <span class="issue-tag bg-peach">TAIPEI</span>
                </div>
                <p class="issue-desc">游书店 001：走入充满设计与独立出版生命力的 <strong>田园城市风格书店</strong>。</p>
                <div class="issue-actions">
                  <a href="https://tally.so/r/4415XB" target="_blank" class="issue-btn btn-lock">🔒 解锁本期</a>
                </div>
              </div>

              <div class="issue-card border-peach">
                <div class="issue-header">
                  <span class="issue-title">Issue#28 落脚点</span>
                  <span class="issue-tag bg-peach">HONG KONG</span>
                </div>
                <p class="issue-desc">香港独立书店巡礼，特别推荐 <strong>Zine Coop</strong> 及超齐全的台港海外独立书店名单。</p>
                <div class="issue-actions">
                  <a href="https://tally.so/r/4415XB" target="_blank" class="issue-btn btn-lock">🔒 解锁本期</a>
                </div>
              </div>

              <div class="issue-card border-peach">
                <div class="issue-header">
                  <span class="issue-title">日本书店游记系列 (合集)</span>
                  <span class="issue-tag bg-peach">JAPAN</span>
                </div>
                <p class="issue-desc">跟着小羊漫游日本独立书店：<br/>• Day 1: 纯真地反抗 (Issue#28)<br/>• Day 2: 大阪的快乐老家 (Issue#30)<br/>• Day 4: 京都的礼物 (Issue#31)</p>
                <div class="issue-actions">
                  <a href="https://tally.so/r/4415XB" target="_blank" class="issue-btn btn-lock">🔒 解锁全系列</a>
                </div>
              </div>
            </div>

            <div id="cat-fair" class="cat-section">
              <h3 class="cat-heading pink-heading">🎪 展场漫游</h3>

              <div class="issue-card border-pink">
                <div class="issue-header">
                  <span class="issue-title">阅读小报 012：无用之用</span>
                  <span class="issue-tag bg-pink">ART BOOK FAIR</span>
                </div>
                <p class="issue-desc">特辑企划：<strong>草率季 Taipei Art Book Fair</strong> 现场导览与深度观察。</p>
                <div class="issue-actions">
                  <a href="https://tally.so/r/4415XB" target="_blank" class="issue-btn btn-lock">🔒 解锁本期</a>
                </div>
              </div>

              <div class="issue-card border-pink">
                <div class="issue-header">
                  <span class="issue-title">Issue#11 以身为度 如是我做</span>
                  <span class="issue-tag bg-pink">BOOK FAIR</span>
                </div>
                <p class="issue-desc"><strong>Hong Kong Book Fair 香港书展</strong> 现场观察与出版物推荐。</p>
                <div class="issue-actions">
                  <a href="https://tally.so/r/4415XB" target="_blank" class="issue-btn btn-lock">🔒 解锁本期</a>
                </div>
              </div>
            </div>

            <div id="cat-resource" class="cat-section">
              <h3 class="cat-heading aqua-heading">🎒 数字生存</h3>

              <div class="issue-card border-aqua">
                <div class="issue-header">
                  <span class="issue-title">Issue#31 & 32：工具箱特辑</span>
                  <span class="issue-tag bg-aqua">HACK & AI</span>
                </div>
                <p class="issue-desc">文科生实用指南：<strong>免费阅读世界杂志与电子书攻略</strong>，以及获取 Gemini、Perplexity PRO 的 AI 使用场景。</p>
                <div class="issue-actions">
                  <a href="https://tally.so/r/4415XB" target="_blank" class="issue-btn btn-lock">🔒 解锁本期</a>
                </div>
              </div>

              <div class="issue-card border-aqua">
                <div class="issue-header">
                  <span class="issue-title">Issue#23 萍聚雾散</span>
                  <span class="issue-tag bg-aqua">LIBRARY</span>
                </div>
                <p class="issue-desc">收藏夹：分享找 <strong>漫画资源的方法渠道</strong>，以及香港独立书店精选辑。</p>
                <div class="issue-actions">
                  <a href="https://tally.so/r/4415XB" target="_blank" class="issue-btn btn-lock">🔒 解锁本期</a>
                </div>
              </div>
            </div>

            <div id="cat-music" class="cat-section">
              <h3 class="cat-heading purple-heading">🎧 听觉切片</h3>

              <div class="issue-card border-purple">
                <div class="issue-header">
                  <span class="issue-title">Issue#36 折返</span>
                  <span class="issue-tag bg-purple">MUSICIAN</span>
                </div>
                <p class="issue-desc">岛屿之间，设计香港。女性艺术家 010：持续耕耘，彳亍前行——<strong>馮穎琪 Vicky</strong>。</p>
                <div class="issue-actions">
                  <a href="https://elephlow1217.notion.site/Issue-36-39e15431c08d831f8c6281af440ecc69" target="_blank" class="issue-btn btn-preview">✨ 免费试阅</a>
                </div>
              </div>

              <div class="issue-card border-purple">
                <div class="issue-header">
                  <span class="issue-title">Issue#04 重返昨日世界</span>
                  <span class="issue-tag bg-purple">MUSIC HISTORY</span>
                </div>
                <p class="issue-desc">杂志社 004：<strong>音乐殖民地</strong>（1994-2004），The Playlist of My life。</p>
                <div class="issue-actions">
                  <a href="https://tally.so/r/4415XB" target="_blank" class="issue-btn btn-lock">🔒 解锁本期</a>
                </div>
              </div>

              <div class="issue-card border-purple">
                <div class="issue-header">
                  <span class="issue-title">Issue#34 创造未来</span>
                  <span class="issue-tag bg-purple">INDIE POP</span>
                </div>
                <p class="issue-desc">女性艺术家 009：自在的流动，「离谱」的轻盈——<strong>Kiri T 谢晓盈</strong>。</p>
                <div class="issue-actions">
                  <a href="https://tally.so/r/4415XB" target="_blank" class="issue-btn btn-lock">🔒 解锁本期</a>
                </div>
              </div>
            </div>

            <div id="cat-film" class="cat-section">
              <h3 class="cat-heading cream-heading">🎞️ 影视与播客 (精选)</h3>

              <div class="issue-card border-cream">
                <div class="issue-header">
                  <span class="issue-title">Issue#29 在爱与恨的边缘</span>
                  <span class="issue-tag bg-cream">QUEER CINEMA</span>
                </div>
                <p class="issue-desc">Happy Pride Month！盘点 <strong>4 位酷儿导演与 31 部酷儿影视</strong>。</p>
                <div class="issue-actions">
                  <a href="https://tally.so/r/4415XB" target="_blank" class="issue-btn btn-lock">🔒 解锁本期</a>
                </div>
              </div>

              <div class="issue-card border-cream" id="cat-doc">
                <div class="issue-header">
                  <span class="issue-title">Issue#08 游移之身</span>
                  <span class="issue-tag bg-mint">DOCUMENTARY</span>
                </div>
                <p class="issue-desc">观影展 002：深度解析 <strong>TIDF 台湾国际纪录片影展</strong>。</p>
                <div class="issue-actions">
                  <a href="https://tally.so/r/4415XB" target="_blank" class="issue-btn btn-lock">🔒 解锁本期</a>
                </div>
              </div>

              <div class="issue-card border-cream" id="cat-podcast">
                <div class="issue-header">
                  <span class="issue-title">Issue#35 每当变幻时</span>
                  <span class="issue-tag bg-aqua">AWARDS 2025</span>
                </div>
                <p class="issue-desc">年度盘点特企：<strong>2025年私人影视大赏</strong> 及 <strong>华语播客大赏</strong> 榜单大公开。</p>
                <div class="issue-actions">
                  <a href="https://tally.so/r/4415XB" target="_blank" class="issue-btn btn-lock">🔒 解锁本期</a>
                </div>
              </div>
            </div>

          </div>

          <div class="board-footer">
            <p>(｡♡‿♡｡) end of archive ✿</p>
          </div>
        </div>
      </section>

      <aside class="archive-right sticky-sidebar">
        <div class="menu-card">
          <h3 class="menu-title">▼ MENU ▼</h3>
          <ul class="menu-list">
            <li><a href="/zh-cn/" class="menu-mint">🏠 主页</a></li>
            <li><a href="/zh-cn/about" class="menu-aqua">✍️ 创作者说</a></li>
            <li><span class="menu-pink menu-current">📚 往期目录</span></li>
            <li><a href="/zh-cn/links" class="menu-cream">🔖 网页收藏夹</a></li>
            <li><a href="/zh-cn/guestbook" class="menu-purple">💬 留言板</a></li>
            <li><a href="https://tally.so/r/4415XB" class="menu-cream">★ 订阅 ★</a></li>
          </ul>
        </div>

        <div class="minihome-deco">
          <div class="deco-row">✦ ✿ ☘ ♡ ✦</div>
          <div class="deco-text">
            <p>this is a quiet</p>
            <p>little room ｡^‿^｡</p>
          </div>
        </div>

        <div class="kawaii-player">
          <div class="kp-header">
            <span class="kp-dot"></span>♫ NOW PLAYING<span class="kp-dot"></span>
          </div>
          <div class="kp-screen">
            <div class="kp-marquee">
              <span>馮穎琪 - 彳亍 ✿ 馮穎琪 - 彳亍 ✿</span>
            </div>
          </div>
          <div class="kp-controls">
            <span class="kp-btn kp-prev"></span>
            <span class="kp-btn kp-play"></span>
            <span class="kp-btn kp-next"></span>
          </div>
        </div>

        <div class="kawaii-counter">
          <p class="kc-title">✿ VISITORS ✿</p>
          <div class="kc-digits">
            <span>0</span><span>0</span><span>1</span><span>4</span><span>2</span><span>6</span>
          </div>
        </div>

      </aside>

    </div>

    <footer class="window-taskbar">
      <div class="taskbar-left">
        <span class="taskbar-start">⊞ START</span>
      </div>
      <div class="taskbar-right">
        <span class="taskbar-status">(｡♡‿♡｡) currently online</span>
        <span class="taskbar-clock" id="clock">--:--</span>
      </div>
    </footer>

  </main>

  <script is:inline>
    function updateClock() {
      const now = new Date();
      const h = String(now.getHours()).padStart(2, '0');
      const m = String(now.getMinutes()).padStart(2, '0');
      const el = document.getElementById('clock');
      if (el) el.innerText = `${h}:${m}`;
    }
    updateClock();
    setInterval(updateClock, 30000);

    document.querySelectorAll('.cat-nav a').forEach(anchor => {
      anchor.addEventListener('click', function (e) {
        e.preventDefault();
        const targetId = this.getAttribute('href');
        const targetElement = document.querySelector(targetId);
        if (targetElement) {
          targetElement.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    });
  </script>

  <style>
    .home-window {
      max-width: 1180px;
      margin: 24px auto;
      background: var(--soft-white);
      border: 3px dashed var(--candy-mint);
      border-radius: 16px;
      box-shadow: 6px 6px 0 rgba(181, 232, 224, 0.6);
      display: flex;
      flex-direction: column;
    }
    .window-titlebar {
      background: var(--candy-mint);
      padding: 8px 16px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 2px dashed var(--candy-mint);
      border-radius: 13px 13px 0 0;
      font-family: var(--font-pixel);
      font-size: 11px;
      color: var(--ink);
    }
    .titlebar-left { display: flex; align-items: center; gap: 12px; }
    .title-dots { color: var(--candy-purple); letter-spacing: 2px; }
    .titlebar-text { letter-spacing: 1px; }
    .titlebar-right { display: flex; gap: 4px; }
    .lang-link { padding: 2px 8px; color: var(--ink); text-decoration: none; border-radius: 3px; }
    .lang-link:hover { background: rgba(255, 255, 255, 0.4); }
    .lang-active { background: rgba(255, 255, 255, 0.6); font-weight: 700; }

    .window-content { padding: 24px; }

    .archive-layout {
      display: grid;
      grid-template-columns: 240px 1fr 200px;
      gap: 24px;
      align-items: start;
    }

    .sticky-sidebar { position: sticky; top: 24px; height: fit-content; }

    .card-title {
      font-family: var(--font-pixel);
      font-size: 12px;
      color: var(--ink-light);
      text-align: center;
      letter-spacing: 4px;
      margin-bottom: 12px;
      padding-bottom: 8px;
      border-bottom: 1px dashed currentColor;
    }

    .elephant-portrait {
      background: var(--soft-white); border: 2px dashed var(--candy-pink); border-radius: 12px;
      padding: 20px 16px; text-align: center; box-shadow: 4px 4px 0 rgba(255, 182, 217, 0.35); margin-bottom: 14px;
    }
    .elephant-portrait svg { width: 120px; height: auto; }
    .elephant-caption { font-family: var(--font-pixel); font-size: 11px; color: var(--ink-light); margin-top: 8px; letter-spacing: 2px; }

    .persona-card {
      background: var(--candy-mint); border: 1.5px dashed var(--candy-purple); border-radius: 12px;
      padding: 16px; box-shadow: 3px 3px 0 rgba(181, 232, 224, 0.6); margin-bottom: 14px;
    }
    .persona-list { font-family: var(--font-serif-tc); font-size: 12px; color: var(--ink); margin: 0; }
    .persona-list dt { font-family: var(--font-pixel); font-size: 9px; color: var(--candy-purple); letter-spacing: 1px; margin-top: 8px; }
    .persona-list dt:first-child { margin-top: 0; }
    .persona-list dd { font-size: 12.5px; margin-left: 0; margin-top: 2px; line-height: 1.5; }

    .index-card {
      background: var(--candy-cream); border: 1.5px dashed var(--candy-peach); border-radius: 12px;
      padding: 16px; box-shadow: 3px 3px 0 rgba(255, 233, 182, 0.5);
    }
    .cat-nav { display: flex; flex-direction: column; gap: 8px; }
    .cat-nav a {
      display: flex; align-items: center; gap: 8px; text-decoration: none;
      font-family: var(--font-rounded); font-size: 13px; font-weight: 700; color: var(--ink-light);
      padding: 6px 8px; border-radius: 8px; transition: background 0.2s;
    }
    .cat-nav a:hover { background: rgba(255,255,255,0.6); }
    .cat-dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; border: 1px solid rgba(0,0,0,0.1); }

    .bg-mint { background-color: var(--candy-mint); }
    .bg-peach { background-color: var(--candy-peach); }
    .bg-pink { background-color: var(--candy-pink); }
    .bg-aqua { background-color: var(--candy-aqua); }
    .bg-purple { background-color: var(--candy-purple); }
    .bg-cream { background-color: var(--candy-cream); }

    .board-card {
      background: var(--soft-white); border: 2px dashed var(--candy-mint); border-radius: 12px;
      padding: 28px 32px; box-shadow: 4px 4px 0 rgba(181, 232, 224, 0.4);
    }
    .board-title {
      font-family: var(--font-serif-tc); font-size: 26px; font-weight: 700; color: var(--ink-light);
      text-align: center; margin-bottom: 4px; letter-spacing: 6px;
    }
    .board-subtitle { text-align: center; font-family: var(--font-rounded); font-size: 13px; color: var(--candy-purple); margin-bottom: 30px; }

    .cat-section { margin-bottom: 32px; scroll-margin-top: 40px; }
    .cat-heading {
      font-family: var(--font-mochi); font-size: 16px; margin-bottom: 16px; padding-bottom: 6px;
      border-bottom: 2px dashed #eee; color: var(--ink);
    }
    .mint-heading { border-bottom-color: var(--candy-mint); }
    .peach-heading { border-bottom-color: var(--candy-peach); }
    .pink-heading { border-bottom-color: var(--candy-pink); }
    .aqua-heading { border-bottom-color: var(--candy-aqua); }
    .purple-heading { border-bottom-color: var(--candy-purple); }
    .cream-heading { border-bottom-color: var(--candy-cream); }

    .issue-card {
      background: #fff; border: 2px dashed #eee; border-radius: 10px; padding: 16px 20px;
      margin-bottom: 16px; transition: transform 0.2s, box-shadow 0.2s;
    }
    .issue-card:hover { transform: translateY(-2px); }

    .border-mint { border-color: var(--candy-mint); box-shadow: 3px 3px 0 rgba(200, 233, 176, 0.3); }
    .border-peach { border-color: var(--candy-peach); box-shadow: 3px 3px 0 rgba(255, 200, 200, 0.3); }
    .border-pink { border-color: var(--candy-pink); box-shadow: 3px 3px 0 rgba(255, 182, 217, 0.3); }
    .border-aqua { border-color: var(--candy-aqua); box-shadow: 3px 3px 0 rgba(181, 232, 224, 0.3); }
    .border-purple { border-color: var(--candy-purple); box-shadow: 3px 3px 0 rgba(199, 179, 232, 0.3); }
    .border-cream { border-color: var(--candy-cream); box-shadow: 3px 3px 0 rgba(255, 233, 182, 0.3); }

    .issue-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; flex-wrap: wrap; gap: 8px; }
    .issue-title { font-family: var(--font-serif-tc); font-weight: 700; font-size: 16px; color: var(--ink); }
    .issue-tag { font-family: var(--font-pixel); font-size: 10px; color: var(--ink); padding: 2px 8px; border-radius: 20px; border: 1px dashed rgba(0,0,0,0.1); }

    .issue-desc { font-family: var(--font-serif-tc); font-size: 14px; line-height: 1.7; color: #555; margin-bottom: 14px; }
    .issue-desc strong { color: var(--ink); background: linear-gradient(transparent 60%, var(--candy-cream) 60%); }

    .issue-actions { display: flex; justify-content: flex-end; }
    .issue-btn {
      display: inline-block; padding: 4px 12px; font-family: var(--font-rounded); font-size: 12px; font-weight: 700;
      border-radius: 999px; text-decoration: none; color: var(--ink); transition: transform 0.15s;
    }
    .issue-btn:hover { transform: scale(1.05); text-decoration: none; }
    .btn-preview { background: var(--candy-aqua); border: 1.5px dashed var(--candy-purple); box-shadow: 2px 2px 0 rgba(181, 232, 224, 0.6); }
    .btn-lock { background: var(--soft-white); border: 1.5px dashed #ccc; color: #888; }
    .btn-lock:hover { background: #f0f0f0; }

    .board-footer { text-align: center; margin-top: 30px; padding-top: 16px; border-top: 1px dashed var(--candy-mint); font-family: var(--font-pixel); font-size: 11px; color: var(--ink-light); letter-spacing: 2px; }

    .menu-card {
      background: var(--soft-white); border: 1.5px dashed var(--candy-mint);
      border-radius: 12px; padding: 8px;
      box-shadow: 3px 3px 0 rgba(181,232,224,0.4); margin-bottom: 12px;
    }
    .menu-title {
      font-family: var(--font-pixel); font-size: 12px; text-align: center;
      padding: 8px 4px; margin: 0 0 6px;
      color: var(--ink-light); background: var(--candy-cream); border-radius: 6px;
    }
    .menu-list { list-style: none; padding: 0; margin: 0; }
    .menu-list li { margin-bottom: 4px; }
    .menu-list a, .menu-current {
      display: block; padding: 10px 12px; text-align: center;
      font-family: var(--font-rounded); font-weight: 700; font-size: 13px;
      color: var(--ink); text-decoration: none; border-radius: 8px;
      border: 1.5px dashed var(--candy-purple);
      text-shadow: -1px -1px 0 var(--soft-white), 1px -1px 0 var(--soft-white),
                   -1px  1px 0 var(--soft-white), 1px  1px 0 var(--soft-white);
    }
    .menu-list a { transition: transform 0.15s, box-shadow 0.15s; }
    .menu-list a:hover { transform: translate(-2px,-2px); box-shadow: 2px 2px 0 rgba(199,179,232,0.4); text-decoration: none; }
    .menu-mint   { background: var(--candy-mint); }
    .menu-aqua   { background: var(--candy-aqua); }
    .menu-pink   { background: var(--candy-pink); }
    .menu-purple { background: var(--candy-purple); }
    .menu-cream  { background: var(--candy-cream); }
    .menu-current { border-style: solid; border-width: 2px; cursor: default; }

    .minihome-deco {
      background: var(--candy-cream); border: 1.5px dashed var(--candy-peach); border-radius: 12px;
      padding: 16px 12px; text-align: center; box-shadow: 3px 3px 0 rgba(255, 200, 200, 0.3); margin-bottom: 16px;
    }
    .deco-row { font-size: 14px; color: var(--candy-purple); letter-spacing: 4px; margin-bottom: 10px; }
    .deco-text p { font-family: var(--font-pixel); font-size: 10px; color: var(--ink-light); margin: 2px 0; }

    .kawaii-player {
      background: var(--candy-mint); border: 2px dashed var(--candy-purple); border-radius: 12px;
      padding: 12px; box-shadow: 3px 3px 0 rgba(181, 232, 224, 0.8); margin-bottom: 16px;
    }
    .kp-header { display: flex; justify-content: center; align-items: center; gap: 6px; font-family: var(--font-pixel); font-size: 10px; color: var(--ink-light); margin-bottom: 8px; letter-spacing: 1px; }
    .kp-dot { width: 4px; height: 4px; background: var(--candy-pink); border-radius: 50%; }
    .kp-screen { background: var(--soft-white); border: 1.5px solid var(--candy-purple); border-radius: 6px; padding: 6px; overflow: hidden; margin-bottom: 10px; }
    .kp-marquee { font-family: var(--font-serif-tc); font-size: 12px; color: var(--candy-purple); font-weight: bold; white-space: nowrap; animation: marquee-scroll 6s linear infinite; }
    @keyframes marquee-scroll { 0% { transform: translateX(100%); } 100% { transform: translateX(-100%); } }
    .kp-controls { display: flex; justify-content: center; gap: 12px; }
    .kp-btn { display: inline-flex; justify-content: center; align-items: center; width: 24px; height: 24px; background: var(--soft-white); border: 1.5px dashed var(--candy-purple); border-radius: 50%; font-size: 10px; color: var(--candy-purple); cursor: pointer; }
    .kp-btn:hover { background: var(--candy-cream); }
    .kp-play { background: var(--candy-pink); color: white; border-color: transparent; }

    .kawaii-counter {
      background: var(--candy-cream); border: 2px dashed var(--candy-peach); border-radius: 12px;
      padding: 12px; text-align: center; box-shadow: 3px 3px 0 rgba(255, 200, 200, 0.4);
    }
    .kc-title { font-family: var(--font-pixel); font-size: 10px; color: var(--ink-light); margin: 0 0 8px 0; letter-spacing: 2px; }
    .kc-digits { display: flex; justify-content: center; gap: 3px; }
    .kc-digits span { background: var(--soft-white); color: var(--candy-pink); font-family: var(--font-pixel); font-size: 16px; padding: 4px 6px; border: 1.5px solid var(--candy-pink); border-radius: 4px; font-weight: bold; }

    .window-taskbar {
      background: var(--candy-mint); padding: 8px 16px; display: flex; justify-content: space-between; align-items: center;
      border-top: 2px dashed var(--candy-mint); border-radius: 0 0 13px 13px; font-family: var(--font-pixel); font-size: 11px; color: var(--ink);
    }
    .taskbar-left { display: flex; gap: 12px; align-items: center; }
    .taskbar-right { display: flex; gap: 12px; align-items: center; }
    .taskbar-start { background: rgba(255, 255, 255, 0.5); padding: 2px 8px; border-radius: 3px; border: 1px dashed var(--candy-purple); }
    .taskbar-status, .taskbar-clock { color: var(--ink); font-weight: 700; }

    /* ========================================= */
    /* 手機與平板適配 (900px 以下) - 往期目錄專屬 */
    /* ========================================= */
    @media (max-width: 900px) {
      /* 1. 關鍵修復：把目錄頁專屬的三欄網格改為單欄 */
      .archive-layout { 
        grid-template-columns: 1fr; 
        gap: 16px;
      }
      
      /* 2. 縮小最外層視窗邊距與內容留白 */
      .home-window { margin: 12px; }
      .window-content { padding: 16px 12px; }

      /* 3. 頂部標題列與底部任務欄：改為上下排列 */
      .window-titlebar, .window-taskbar {
        flex-direction: column;
        gap: 8px;
        text-align: center;
      }
      .titlebar-left, .taskbar-left, .taskbar-right {
        justify-content: center;
        flex-wrap: wrap; 
      }

      /* 4. 取消側邊欄的「吸頂跟隨 (sticky)」，讓手機端可以順暢往下滑動 */
      .sticky-sidebar {
        position: static;
      }

      /* 5. 稍微縮小面板的內距與標題字距 */
      .board-card { padding: 20px 16px; }
      .board-title { 
        font-size: 22px; 
        letter-spacing: 2px; 
      }

      /* 6. 目錄頁優化：讓卡片標題跟 Tag 在手機上改為「上下排列」，防止文字擠在一起 */
      .issue-header {
        flex-direction: column;
        align-items: flex-start;
        gap: 8px;
      }
      .issue-badges {
        align-items: flex-start; /* 讓 Tag 靠左對齊 */
      }
      
      /* 優化按鈕在手機上的點擊範圍 */
      .issue-actions { justify-content: stretch; }
      .issue-btn { text-align: center; width: 100%; box-sizing: border-box; }
    }
  </style>

</body>
</html>
