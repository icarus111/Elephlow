---
import '../../styles/global.css';
---
<!DOCTYPE html>
<html lang="zh-cn">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>elephlow design system preview</title>
</head>
<body style="padding: 40px;">

  <h1 style="font-family: var(--font-bubble); font-size: 48px; color: var(--ink-light); text-shadow: 2px 2px 0 var(--candy-peach); margin-bottom: 8px;">
    elephlow design system
  </h1>
  <p style="font-family: var(--font-mochi); font-size: 18px; color: var(--candy-purple); margin-bottom: 32px;">
    ようこそ elephlow へ  ✦  推开部屋的门
  </p>

  <!-- 字体样本 -->
  <section style="margin-bottom: 48px; padding: 24px; background: var(--soft-white); border-radius: var(--radius-soft); box-shadow: 2px 2px 0 rgba(0,0,0,0.08);">
    <h2 style="font-family: var(--font-pixel); font-size: 20px; margin-bottom: 16px;">FONTS / 字体</h2>

    <p style="font-family: var(--font-serif-sc); font-size: 18px; margin-bottom: 12px;">
      <strong>Noto Serif SC:</strong> 这是中文衬线体示例。推开部屋的门。
    </p>
    <p style="font-family: var(--font-rounded); font-size: 18px; margin-bottom: 12px;">
      <strong>M PLUS Rounded 1c:</strong> 圆润日式无衬线 こんにちは
    </p>
    <p style="font-family: var(--font-mochi); font-size: 22px; color: var(--candy-pink); margin-bottom: 12px;">
      <strong>Mochiy Pop One:</strong> もちもち kawaii 字体 ♡
    </p>
    <p style="font-family: var(--font-pixel); font-size: 16px; margin-bottom: 12px;">
      <strong>DotGothic16:</strong> PIXEL FONT 像素字体 0123456789
    </p>
    <p style="font-family: var(--font-bubble); font-size: 28px; color: var(--candy-purple); margin-bottom: 12px;">
      Bungee Bubble Headline
    </p>
    <p style="font-family: var(--font-sans-en); font-size: 16px;">
      <strong>Inter:</strong> The quick brown fox jumps over the lazy dog.
    </p>
  </section>

  <!-- 糖果色 -->
  <section style="margin-bottom: 48px;">
    <h2 style="font-family: var(--font-pixel); font-size: 20px; margin-bottom: 16px;">CANDY COLORS / 糖果色</h2>
    <div style="display: grid; grid-template-columns: repeat(6, 1fr); gap: 16px;">
      <div style="background: var(--candy-cream); padding: 24px 12px; text-align: center; border-radius: var(--radius-card); box-shadow: 2px 2px 0 rgba(0,0,0,0.1);">
        <strong>cream</strong><br/><code>#FFE9B6</code>
      </div>
      <div style="background: var(--candy-peach); padding: 24px 12px; text-align: center; border-radius: var(--radius-card); box-shadow: 2px 2px 0 rgba(0,0,0,0.1);">
        <strong>peach</strong><br/><code>#FFC8C8</code>
      </div>
      <div style="background: var(--candy-pink); padding: 24px 12px; text-align: center; border-radius: var(--radius-card); box-shadow: 2px 2px 0 rgba(0,0,0,0.1);">
        <strong>pink</strong><br/><code>#FFB6D9</code>
      </div>
      <div style="background: var(--candy-purple); padding: 24px 12px; text-align: center; border-radius: var(--radius-card); box-shadow: 2px 2px 0 rgba(0,0,0,0.1);">
        <strong>purple</strong><br/><code>#C7B3E8</code>
      </div>
      <div style="background: var(--candy-aqua); padding: 24px 12px; text-align: center; border-radius: var(--radius-card); box-shadow: 2px 2px 0 rgba(0,0,0,0.1);">
        <strong>aqua</strong><br/><code>#B5E8E0</code>
      </div>
      <div style="background: var(--candy-mint); padding: 24px 12px; text-align: center; border-radius: var(--radius-card); box-shadow: 2px 2px 0 rgba(0,0,0,0.1);">
        <strong>mint</strong><br/><code>#C8E9B0</code>
      </div>
    </div>
  </section>

  <!-- 渐变 -->
  <section style="margin-bottom: 48px;">
    <h2 style="font-family: var(--font-pixel); font-size: 20px; margin-bottom: 16px;">GRADIENTS / 渐变</h2>
    <div style="height: 60px; background: var(--gradient-rainbow); border-radius: var(--radius-soft); margin-bottom: 12px;"></div>
    <div style="height: 60px; background: var(--gradient-sunset); border-radius: var(--radius-soft);"></div>
  </section>

  <!-- tab 色 -->
  <section style="margin-bottom: 48px;">
    <h2 style="font-family: var(--font-pixel); font-size: 20px; margin-bottom: 16px;">TAB COLORS / minihome &amp; catalog 用</h2>
    <div style="display: flex; gap: 8px;">
      <div style="background: var(--tab-green); padding: 12px 20px; border-radius: var(--radius-pill);">green</div>
      <div style="background: var(--tab-orange); padding: 12px 20px; border-radius: var(--radius-pill);">orange</div>
      <div style="background: var(--tab-pink); padding: 12px 20px; border-radius: var(--radius-pill);">pink</div>
      <div style="background: var(--tab-blue); padding: 12px 20px; border-radius: var(--radius-pill);">blue</div>
      <div style="background: var(--tab-yellow); padding: 12px 20px; border-radius: var(--radius-pill);">yellow</div>
    </div>
  </section>

</body>
</html>
