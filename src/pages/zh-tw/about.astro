---
// src/pages/zh-tw/about.astro
---
<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>關於小報 | 推開部屋的門</title>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@900&family=Noto+Sans+TC:wght@400;700;900&display=swap" rel="stylesheet">
    <style>
        :root {
            --win-gray: #c0c0c0; --y2k-purple: #4B2D8C; --y2k-pink: #FF66B3;
            --y2k-mint: #B2F5EA; --bg: #E0D7FF; --text: #1a1008;
        }
        * { margin: 0; padding: 0; box-sizing: border-box; cursor: default; }
        body {
            background-color: var(--bg); background-image: linear-gradient(var(--y2k-mint) 1px, transparent 1px), linear-gradient(90deg, var(--y2k-mint) 1px, transparent 1px);
            background-size: 30px 30px; font-family: 'Noto Sans TC', sans-serif; height: 100vh; overflow: hidden; display: flex; flex-direction: column;
        }

        /* --- 跑馬燈：找回彩色重點 --- */
        .marquee-bar { 
            background: var(--text); color: #fff; padding: 15px 0; min-height: 70px; 
            display: flex; align-items: center; overflow: hidden; border-bottom: 3px solid #000; z-index: 2000;
        }
        .marquee-content { display: flex; white-space: nowrap; font-weight: 900; font-size: 1.4rem; animation: scroll 25s linear infinite; }
        @keyframes scroll { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }

        .desktop-wrapper { display: flex; flex: 1; min-height: 0; padding: 25px; gap: 25px; padding-bottom: 60px; }

        /* --- 固定側邊欄 --- */
        #sidebar { 
            width: 280px; background: var(--win-gray); border: 2px solid; border-color: #fff #808080 #808080 #fff;
            box-shadow: 4px 4px 0 #000; display: flex; flex-direction: column; flex-shrink: 0; z-index: 1500;
        }
        .side-title { background: linear-gradient(90deg, var(--y2k-purple), var(--y2k-pink)); color: white; padding: 8px 12px; font-weight: bold; font-size: 13px; }
        .nav-list { list-style: none; padding: 10px 0; flex: 1; }
        .nav-link { display: block; padding: 12px 20px; text-decoration: none; color: var(--text); font-weight: bold; }
        .nav-link:hover { background: rgba(255, 102, 179, 0.2); }
        .nav-active { background: var(--y2k-purple); color: white !important; }

        /* --- 視窗區域 --- */
        #playground { flex: 1; position: relative; overflow: hidden; }
        .window {
            background: var(--win-gray); border: 2px solid; border-color: #fff #808080 #808080 #fff;
            box-shadow: 4px 4px 0 #000; display: flex; flex-direction: column; position: absolute;
        }
        .title-bar { background: linear-gradient(90deg, var(--y2k-purple), var(--y2k-pink)); padding: 4px 8px; display: flex; justify-content: space-between; align-items: center; color: white; font-weight: bold; font-size: 12px; cursor: move; }
        .win-controls { display: flex; gap: 3px; }
        .win-btn { width: 18px; height: 16px; background: var(--win-gray); border: 1px solid; border-color: #fff #808080 #808080 #fff; color: black; font-size: 10px; display: flex; align-items: center; justify-content: center; cursor: pointer; box-shadow: 1px 1px 0 #000; }

        .win-content { flex: 1; overflow-y: auto; background: white; padding: 35px; line-height: 1.8; }
        
        .header-title { font-family: 'Noto Serif TC'; font-size: 2.8rem; color: var(--y2k-purple); margin-bottom: 10px; line-height: 1.2; }
        .highlight-pink { color: var(--y2k-pink); font-weight: 900; font-size: 1.1rem; display: block; margin-bottom: 20px; }
        .manifesto-p { margin-bottom: 20px; color: #333; text-align: justify; }
        
        .season-block { border-left: 5px solid var(--y2k-purple); padding-left: 20px; margin-bottom: 40px; }
        .season-header { font-family: 'Noto Serif TC'; font-size: 1.5rem; color: var(--y2k-purple); margin-bottom: 5px; }
        .season-date { font-weight: 900; font-size: 0.85rem; color: var(--y2k-pink); margin-bottom: 10px; }
        .feature-box { background: #f9f9f9; padding: 15px; border: 1px dashed var(--y2k-purple); margin-top: 10px; font-size: 0.9rem; }

        /* --- 全域任務欄 (Taskbar) --- */
        .taskbar {
            position: fixed; bottom: 0; left: 0; right: 0; height: 48px;
            background: var(--win-gray); border-top: 2px solid #fff;
            display: flex; align-items: center; padding: 0 12px; z-index: 3000;
            box-shadow: 0 -2px 0 #808080;
        }
        .start-btn {
            background: var(--win-gray); border: 2px solid; border-color: #fff #808080 #808080 #fff;
            padding: 3px 15px; font-weight: 900; display: flex; align-items: center; gap: 8px;
            text-decoration: none; color: #000; font-size: 14px; box-shadow: 1px 1px 0 #000;
        }
        .subscribe-pill {
            background: var(--y2k-pink); color: white; padding: 6px 22px;
            border-radius: 25px; text-decoration: none; font-weight: 900;
            margin-left: 20px; font-size: 13px; border: 2px solid #000; box-shadow: 2px 2px 0 #000;
        }
        .system-tray { margin-left: auto; display: flex; gap: 12px; align-items: center; }
        .social-link { color: #000; text-decoration: none; font-size: 11px; font-weight: 900; border: 1px solid #808080; padding: 3px 8px; background: #eee; }
        .clock { font-size: 12px; font-weight: bold; border-left: 1px solid #808080; padding-left: 12px; font-family: monospace; }
    </style>
</head>
<body>
    <div class="marquee-bar">
        <div class="marquee-content">
            ✦ <span style="color:var(--y2k-pink);">第四季早鳥活動</span> 進行中 ✦ 即將於 <span style="color:var(--y2k-mint);">2026年5月17日</span> 結束 ✦ <span style="color:var(--y2k-pink);">36期正刊 + 12期閱讀小報</span> ✦ 在邊緣捕捉與想像 ✴ &nbsp;&nbsp;&nbsp;
        </div>
    </div>
    <div class="desktop-wrapper">
        <aside id="sidebar">
            <div class="side-title">Explorer</div>
            <nav class="nav-list">
                <a href="/zh-tw/" class="nav-link">🏠 主頁 / HOME</a>
                <a href="/zh-tw/about" class="nav-link nav-active">📝 關於小報 / ABOUT</a>
                <a href="/zh-tw/archive" class="nav-link">📂 往期目錄 / ARCHIVE</a>
            </nav>
            <div style="margin-top: auto; padding: 15px; border-top: 1px solid #808080; font-size: 11px;">2022.07 - 2026.05 © elephlow</div>
        </aside>

        <div id="playground">
            <div id="manifesto-win" class="window draggable" style="width: 580px; height: 450px; left: 40px; top: 30px; z-index: 100;">
                <div class="title-bar">
                    <span>About_Push_The_Door.txt</span>
                    <div class="win-controls">
                        <div class="win-btn">_</div><div class="win-btn">□</div><div class="win-btn" onclick="this.closest('.window').style.display='none'">×</div>
                    </div>
                </div>
                <div class="win-content">
                    <h1 class="header-title">推開部屋的門</h1>
                    <span class="highlight-pink">在邊緣捕捉與想像 ✴</span>
                    <p class="manifesto-p">這是一份創辦於 2022 年 7 月的中文付費電子報。我們關注港台流行音樂、獨立出版、影展研究及酷兒視角書寫。</p>
                    <p class="manifesto-p"><strong>「部屋」</strong>是私密的起點，而<strong>「推開門」</strong>則是通往公共的行動。我們致力於將偏見所隔絕的萬事萬物重新拉近，在邊緣捕捉那些被忽視的微光。</p>
                </div>
            </div>

            <div id="timeline-win" class="window draggable" style="width: 620px; height: 600px; left: 200px; top: 100px; z-index: 50;">
                <div class="title-bar">
                    <span>Evolution_Report.doc</span>
                    <div class="win-controls">
                        <div class="win-btn">_</div><div class="win-btn">□</div><div class="win-btn" onclick="this.closest('.window').style.display='none'">×</div>
                    </div>
                </div>
                <div class="win-content">
                    <div class="season-block">
                        <h3 class="season-header">第一至二季：文化基底</h3>
                        <p class="season-date">2022.07 - 2024.09</p>
                        <p style="font-size:0.95rem;">建立固定欄目：播放器、雜誌社、逛書店。關注港台期刊考古與影展研究。</p>
                    </div>
                    <div class="season-block" style="border-left-color: var(--y2k-pink);">
                        <h3 class="season-header">第三季：深度閱讀與生命共鳴</h3>
                        <p class="season-date">2024.12 - 2026.05</p>
                        <div class="feature-box">
                            <strong>核心變革：【閱讀小報】正式啟動</strong>
                            <p>不僅是補充，更是產品線的全新延伸。以書單+資源合集形式分享海內外好書，打破月刊週期限制。</p>
                        </div>
                    </div>
                    <div class="season-block" style="border-left: 5px dashed var(--y2k-purple);">
                        <h3 class="season-header">第四季：主題策展化</h3>
                        <p class="season-date">2026.05.17 LAUNCH</p>
                        <p style="font-size:0.95rem;">正刊轉向主題策展；副刊升級為高頻的「雜誌通信」；邀請更多在地寫作者供稿。</p>
                    </div>
                    <div style="height:50px;"></div>
                </div>
            </div>
        </div>
    </div>

    <footer class="taskbar">
        <a href="/zh-tw/" class="start-btn">🏠 Start</a>
        <a href="https://tally.so/r/4415XB" target="_blank" class="subscribe-pill">立即訂閱第四季早鳥</a>
        <div class="system-tray">
            <a href="https://www.instagram.com/icarusrootedbutflow/" target="_blank" class="social-link">INSTAGRAM</a>
            <a href="#" class="social-link">RED: @Apollo11-</a>
            <div class="clock" id="live-clock">00:00</div>
        </div>
    </footer>

    <script is:inline>
        // 拖拽邏輯
        const windows = document.querySelectorAll('.draggable');
        let zIndexCounter = 200;
        windows.forEach(win => {
            const titleBar = win.querySelector('.title-bar');
            titleBar.onmousedown = (e) => {
                if (e.target.classList.contains('win-btn')) return;
                win.style.zIndex = ++zIndexCounter;
                let shiftX = e.clientX - win.getBoundingClientRect().left;
                let shiftY = e.clientY - win.getBoundingClientRect().top;
                function moveAt(pageX, pageY) {
                    win.style.left = (pageX - shiftX - 280) + 'px';
                    win.style.top = (pageY - shiftY - 70) + 'px';
                }
                document.onmousemove = (e) => moveAt(e.pageX, e.pageY);
                document.onmouseup = () => { document.onmousemove = null; };
            };
            win.onmousedown = () => { win.style.zIndex = ++zIndexCounter; };
        });

        // 時鐘邏輯
        function updateClock() {
            const now = new Date();
            const h = String(now.getHours()).padStart(2, '0');
            const m = String(now.getMinutes()).padStart(2, '0');
            document.getElementById('live-clock').innerText = `${h}:${m}`;
        }
        setInterval(updateClock, 1000);
        updateClock();
    </script>
</body>
</html>