<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>关于小象 | 推开部屋的门</title>
    <link href="https://fonts.googleapis.com/css2?family=DotGothic16&family=Noto+Serif+SC:wght@400;700;900&display=swap" rel="stylesheet">
    <style>
        :root{
            /* 💾 经典 OS 全局配色 (用于外层桌面与视窗框) */
            --win-gray: #c0c0c0; 
            --win-dark: #808080; 
            --win-light: #ffffff;
            --win-blue: #000080;
            
            /* 🍭 内部 Y2K 浏览器马卡龙配色 */
            --m-green: #B5E48C;
            --m-pink: #FFB5A7;
            --m-blue: #A2D2FF;
            --m-yellow: #FFF5BA;
            --m-purple: #CDB4DB;
        }
        *{margin:0;padding:0;box-sizing:border-box;cursor:default;}
        html,body{height:auto;min-height:100%; overflow-x:hidden;}
        
        /* 🌍 保留你原始的桌面背景 */
        body{
            background:linear-gradient(rgba(255,255,255,0.3) 1px,transparent 1px),
                       linear-gradient(90deg,rgba(255,255,255,0.3) 1px,transparent 1px),
                       linear-gradient(to right,#98fb98,#fffacd,#ffebcd,#ffb6c1,#e0b0ff);
            background-size:20px 20px,20px 20px,100% 100%;
            background-attachment:fixed;
            font-family:'DotGothic16','PMingLiU','MingLiU','细明体','SimSun',sans-serif;
            display:flex; flex-direction:column;
        }

        .desktop-wrapper{display:flex;flex:1;padding:25px;position:relative;min-height:900px;}
        
        /* ==========================================
           🗂️ 桌面图标排版 (像素化大改造)
           ========================================== */
        .desktop-grid { display: flex; flex-direction: column; gap: 15px; width: 100px; z-index: 10;}
        .desktop-divider { height: 2px; border-bottom: 2px dashed rgba(0,0,0,0.3); margin: 5px 0; width: 80%; align-self: center; }
        .desktop-group-title { background: var(--win-light); border: 1px solid var(--win-dark); padding: 2px 6px; font-size: 11px; font-weight: bold; text-align: center; color: var(--win-dark); width: 80%; align-self: center; margin-bottom: 5px;}

        .desktop-icon {
            display: flex; flex-direction: column; align-items: center; text-decoration: none; 
            padding: 8px 5px; cursor: pointer; width: 100%; gap: 6px;
        }
        
        /* 真正的像素图标样式 */
        .pixel-icon {
            width: 36px; height: 36px; 
            image-rendering: pixelated; /* 保持像素边缘锋利 */
            filter: drop-shadow(2px 2px 0px rgba(0,0,0,0.3)); 
            transition: transform 0.1s;
        }
        
        .icon-text {
            color: #fff; background-color: transparent; font-size: 13px; text-align: center; 
            padding: 2px 4px; border: 1px dotted transparent; word-break: break-all;
        }
        
        /* 选中/Hover 状态还原经典 Windows */
        .desktop-icon:hover .pixel-icon { transform: scale(1.05); filter: drop-shadow(2px 2px 0px rgba(0,0,0,0.5));}
        .desktop-icon:hover .icon-text { background-color: var(--win-blue); border: 1px dotted #fff; }

        /* ==========================================
           🗂️ 核心视窗通用样式 (经典 OS 灰框)
           ========================================== */
        .window { 
            background: var(--win-gray); 
            border: 2px solid; border-color: var(--win-light) #000 #000 var(--win-light); 
            box-shadow: inset 1px 1px 0 #dfdfdf, inset -1px -1px 0 var(--win-dark), 4px 4px 0 rgba(0,0,0,0.3); 
            display: flex; flex-direction: column; position: absolute; z-index: 100; padding: 3px; 
        }
        
        .title-bar { background: linear-gradient(90deg, var(--win-blue), #1084d0); color: white; padding: 4px 6px; font-size: 13px; display: flex; justify-content: space-between; align-items: center; cursor: move; user-select: none; letter-spacing: 1px; font-weight: bold;}
        .win-controls { display: flex; flex-direction: row; gap: 3px; }
        .win-btn { width: 18px; height: 18px; background-color: var(--win-gray); border: 2px solid; border-color: var(--win-light) var(--win-dark) var(--win-dark) var(--win-light); color: #000; font-family: 'Pixel', sans-serif; font-size: 10px; font-weight: bold; display: flex; align-items: center; justify-content: center; cursor: pointer; box-shadow: 1px 1px 0 #000; }
        .win-btn:active { border-color: var(--win-dark) var(--win-light) var(--win-light) var(--win-dark); padding-top: 2px; padding-left: 2px; box-shadow: none; }
        
        .sys-menu { display: flex; gap: 10px; padding: 3px 6px; font-size: 12px; border-bottom: 1px solid var(--win-dark); color: #000;}
        .sys-menu span { padding: 2px 6px; cursor: pointer;}
        .sys-menu span:first-letter { text-decoration: underline; }
        .sys-menu span:hover { background-color: var(--win-blue); color: #fff; }

        /* ==========================================
           🎨 视窗内部：固定尺寸的 Y2K 盒中盒
           ========================================== */
        #about-win { width: 850px; height: 580px; left: calc(50% - 425px); top: 8vh; z-index: 150;}
        
        .kawaii-inner { 
            background: #fafafa; display: flex; flex-direction: column; flex: 1; 
            overflow: hidden; border: 2px inset var(--win-dark); margin-top: 2px;
        }
        
        /* 可爱工具列 (地址列 + 语言切换) */
        .kawaii-toolbar { 
            display: flex; padding: 10px 15px; background: #fff; 
            border-bottom: 2px dashed var(--m-green); align-items: center; gap: 15px; 
        }
        .url-pill { 
            border: 2px solid #ccc; border-radius: 20px; padding: 4px 15px; flex: 1; 
            font-family: 'DotGothic16'; color: #666; font-size: 14px; display: flex; align-items: center; gap: 8px;
        }
        .lang-toggles { display: flex; gap: 6px; }
        .lang-btn { 
            border: 2px solid #ccc; border-radius: 15px; padding: 2px 10px; font-size: 12px; 
            font-weight: bold; text-decoration: none; color: #555; transition: 0.2s;
        }
        .lang-btn.active { background: var(--m-green); color: #333; border-color: var(--m-green); }

        /* 视窗内部双栏布局 */
        .kawaii-body { display: flex; flex: 1; overflow: hidden; }
        
        /* 👉 左侧：固定不滑动 (解决空荡问题) */
        .k-sidebar { 
            width: 240px; padding: 25px 20px; background: #fff; 
            border-right: 2px dashed var(--m-green); display: flex; flex-direction: column; 
            gap: 15px; overflow-y: auto; text-align: center;
        }
        .k-sidebar h1 { font-family: 'DotGothic16'; color: var(--m-pink); font-size: 24px; text-shadow: 1px 1px 0 #eee; margin-bottom: 5px;}
        .k-sidebar p { font-size: 13px; color: #888; margin-bottom: 15px;}
        
        .k-link-title { font-weight: bold; color: var(--m-blue); font-size: 15px; margin-top: 10px; border-bottom: 2px dotted var(--m-blue); padding-bottom: 5px; display: inline-block;}
        
        /* 马卡龙社交药丸按钮 */
        .social-pills { display: flex; flex-direction: column; gap: 10px; margin-top: 10px; }
        .k-link-btn { 
            display: flex; align-items: center; justify-content: center; gap: 8px; 
            padding: 10px; border-radius: 25px; text-decoration: none; font-weight: bold; 
            font-size: 13px; color: #333; box-shadow: 2px 3px 0 rgba(0,0,0,0.1); border: 1px solid #ddd; transition: 0.1s;
        }
        .k-link-btn:active { transform: translate(1px,2px); box-shadow: none; }
        .k-ig { background: var(--m-green); }
        .k-red { background: var(--m-pink); }
        .k-th { background: var(--m-blue); }

        /* 👉 右侧：独立滑动的文章区 (绝对不溢出) */
        .k-content { 
            flex: 1; padding: 35px 40px; background: #FEFEFE; 
            overflow-y: auto; line-height: 2; font-size: 15px; font-family: 'Noto Serif SC', serif; color: #444;
        }
        
        /* 定制超可爱粉色滚动条 */
        .k-content::-webkit-scrollbar { width: 12px; }
        .k-content::-webkit-scrollbar-track { background: #fdfdfd; border-left: 1px solid #eee; }
        .k-content::-webkit-scrollbar-thumb { background: var(--m-pink); border-radius: 6px; border: 2px solid #fff;}

        /* 右侧文章细节排版 */
        .section-title { font-family: 'DotGothic16'; color: var(--m-pink); font-size: 20px; font-weight: bold; margin-bottom: 15px; display: flex; align-items: center; gap: 8px;}
        .cute-divider { text-align: center; color: var(--m-blue); letter-spacing: 5px; margin: 35px 0; }
        .y2k-tag { font-family: 'DotGothic16'; font-size: 12px; padding: 4px 12px; border-radius: 20px; font-weight: bold; background: var(--m-yellow); border: 1px solid #ddd; margin-right: 6px;}
        
        /* 观测领域进度条 */
        .skill-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; font-size: 14px; font-family: 'DotGothic16';}
        .skill-name { width: 130px; font-weight: bold; color: #555;}
        .bar-bg { flex: 1; height: 12px; background: #f0f0f0; border-radius: 6px; overflow: hidden; border: 1px solid #ddd;}
        .bar-fill { height: 100%; border-radius: 6px;}

        /* Q&A 样式 */
        .qa-box { background: #F8F5FF; border: 1px dashed #CDB4DB; border-radius: 12px; padding: 20px; margin-top: 15px;}
        .qa-item { margin-bottom: 15px; }
        .qa-q { font-weight: bold; color: #8A2BE2; display: block; margin-bottom: 5px;}
        .qa-a { color: #555; display: block; padding-left: 15px; border-left: 3px solid var(--m-purple);}

        /* ==========================================
           📌 任务栏与底部元素 (完全保留你的原版设计)
           ========================================== */
        .taskbar{position:fixed;bottom:0;left:0;right:0;height:42px;background:var(--win-gray);border-top:2px solid var(--win-light);display:flex;align-items:center;padding:0 6px;z-index:3000;box-shadow:inset 0 1px 0 #dfdfdf;}
        
        .start-btn{background:var(--win-gray);border:2px solid;border-color:var(--win-light) var(--win-dark) var(--win-dark) var(--win-light);padding:4px 12px;display:flex;align-items:center;gap:8px;text-decoration:none;color:#000;font-size:15px;font-weight:bold;flex-shrink:0;}
        .start-btn:active{border-color:var(--win-dark) var(--win-light) var(--win-light) var(--win-dark);padding:5px 11px 3px 13px;}
        
        .taskbar-windows{display:flex;gap:5px;margin-left:10px;flex:1;overflow-x:auto;}
        
        .taskbar-win-tab{background:var(--win-gray);border:2px solid;border-color:var(--win-light) var(--win-dark) var(--win-dark) var(--win-light);padding:4px 12px;font-size:13px;color:#000;display:none;align-items:center;gap:6px;cursor:pointer;max-width:140px; overflow:hidden; white-space:nowrap; text-overflow:ellipsis; user-select: none;}
        .taskbar-win-tab.visible { display: flex; }
        .taskbar-win-tab.active{border-color:var(--win-dark) var(--win-light) var(--win-light) var(--win-dark);background:#d0d0d0;font-weight:bold;background-image:repeating-linear-gradient(45deg,transparent,transparent 2px,#c0c0c0 2px,#c0c0c0 4px);}
        
        .subscribe-pill{background:var(--y2k-pink);color:white;padding:4px 15px;text-decoration:none;border:2px solid #000;box-shadow:2px 2px 0 #000;flex-shrink:0;font-size:13px; font-weight: bold;}
        .subscribe-pill:active { transform: translate(1px, 1px); box-shadow: 0px 0px 0 #000; }

        .system-tray{margin-left:10px;display:flex;gap:8px;align-items:center;flex-shrink:0;border:2px solid;border-color:var(--win-dark) var(--win-light) var(--win-light) var(--win-dark);padding:2px 10px;height:32px;}
        .social-link{color:#000;text-decoration:none;font-size:12px; font-weight: bold;}
        .social-link:hover{color:var(--win-blue);text-decoration:underline;}
        
        .clock{font-size:13px;color:#000; margin-left: 5px; font-weight: bold; font-family: 'PMingLiU', sans-serif;}

        @media (max-width: 900px) {
            .desktop-grid { flex-direction: row; height: auto; width: 100%; justify-content: center; }
            .desktop-divider, .desktop-group-title { display: none; }
            .subscribe-pill { display: none; }
            
            /* 手机版视窗自动充满画面，内部改为上下排列 */
            #about-win { width: 95vw !important; height: 80vh !important; left: 2.5vw !important; top: 10vh !important; position: absolute !important; }
            .kawaii-body { flex-direction: column; }
            .k-sidebar { width: 100%; border-right: none; border-bottom: 2px dashed var(--m-green); padding: 15px; }
            .social-pills { flex-direction: row; flex-wrap: wrap; justify-content: center;}
            .k-link-btn { flex: 1; min-width: 100px; padding: 6px; }
            .k-content { padding: 20px 15px; }
        }
    </style>
</head>
<body>
    
