    <script is:inline>
        let zIndexCounter = 300;

        function openApp(winId) {
            const win = document.getElementById(winId);
            const tab = document.getElementById('tab-' + winId);
            if (win) { win.style.display = 'flex'; win.style.zIndex = ++zIndexCounter; }
            if (tab) { tab.classList.add('visible'); }
            bringToFront(winId);
        }

        function closeApp(winId) {
            const win = document.getElementById(winId);
            const tab = document.getElementById('tab-' + winId);
            if (win) win.style.display = 'none';
            if (tab) { tab.classList.remove('visible'); tab.classList.remove('active'); }
        }

        function bringToFront(winId) {
            const win = document.getElementById(winId);
            if (win && win.style.display !== 'none') { win.style.zIndex = ++zIndexCounter; }
            document.querySelectorAll('.taskbar-win-tab').forEach(t => t.classList.remove('active'));
            const tab = document.getElementById('tab-' + winId);
            if (tab && tab.classList.contains('visible')) { tab.classList.add('active'); }
        }

        // 绑定视窗拖拽把手 (经典代码完美保留)
        const allWindows = document.querySelectorAll('.window');
        allWindows.forEach(win => {
            const dragHandle = win.querySelector('.drag-handle');
            win.addEventListener('mousedown', () => { bringToFront(win.id); });

            if (dragHandle) {
                dragHandle.addEventListener('mousedown', (e) => {
                    if (e.target.closest('.win-btn')) return; 
                    if (window.innerWidth <= 900) return; 

                    let rect = win.getBoundingClientRect();
                    let shiftX = e.clientX - rect.left;
                    let shiftY = e.clientY - rect.top;

                    function moveAt(clientX, clientY) { 
                        win.style.left = (clientX - shiftX) + 'px'; 
                        win.style.top = (clientY - shiftY) + 'px'; 
                        win.style.transform = 'none'; /* 拖拽时取消居中 transform 防止跳动 */
                    }
                    
                    function onMouseMove(e) { moveAt(e.clientX, e.clientY); }
                    document.addEventListener('mousemove', onMouseMove);
                    document.addEventListener('mouseup', () => { document.removeEventListener('mousemove', onMouseMove); }, { once: true });
                });
            }
        });

        function updateClock() {
            const now = new Date(); let h = now.getHours(); let m = String(now.getMinutes()).padStart(2, '0');
            let ampm = h >= 12 ? 'PM' : 'AM'; h = h % 12; h = h ? h : 12;
            document.getElementById('live-clock').innerText = `${String(h).padStart(2, '0')}:${m} ${ampm}`;
        }
        setInterval(updateClock, 1000); updateClock();
    </script>
</body>
</html>