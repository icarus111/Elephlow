// src/pages/zh-tw/about.astro
---
<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>關於小象 | 推開部屋的門</title>
    <link href="https://fonts.googleapis.com/css2?family=DotGothic16&family=Noto+Serif+TC:wght@400;700;900&display=swap" rel="stylesheet">
    <style>
        :root{
            /* 🎨 全局 XP/Y2K OS 立體配色 (銀色主題) */
            --os-title-start: #e0e0e0; --os-title-end: #b0b0b0; /* 具有金屬光澤的漸變 */
            --os-win-body: #f5f5f5; /* 略帶溫暖的白 */
            --os-border: #808080; --os-dark-shadow: #333333; --os-light-shadow: #ffffff;
            --win-blue: #000080; --win-gray: #c0c0c0; /* 保留一些 Win95 配色做過渡 */

            /* 🎨 重新引入的板块顏色 (進度條) */
            --skill-pink: #F19CBB; --skill-purple: #CDB4DB; --skill-yellow: #FAD961; --skill-blue: #A2D2FF; --skill-green: #B9FBC0;

            /* 🌐 內部大膽撞色 (清晰度優先) */
            --pop-ig-inner-bg: #FFEAD2; --pop-ig-inner-ink: #5C3A21; /* IG (左上): 杏桃黃底 × 深咖字 */
            --pop-red-inner-bg: #D4EDD9; --pop-red-inner-ink: #1B4332; /* 小紅書 (右側): 開心果綠底 × 深墨綠字 */
            --pop-th-inner-bg: #FAD4D8; --pop-th-inner-ink: #2E1B4E; /* Threads (左下): 櫻花柔粉底 × 深靛藍字 */
        }
        *{margin:0;padding:0;box-sizing:border-box;cursor:default;}
        html,body{height:auto;min-height:100%; overflow-x:hidden;}
        
        body{
            background:linear-gradient(rgba(255,255,255,0.3) 1px,transparent 1px),
                       linear-gradient(90deg,rgba(255,255,255,0.3) 1px,transparent 1px),
                       linear-gradient(to right,#98fb98,#fffacd,#ffebcd,#ffb6c1,#e0b0ff);
            background-size:20px 20px,20px 20px,100% 100%;
            background-attachment:fixed;
            font-family:'DotGothic16','PMingLiU','MingLiU','細明體','SimSun',sans-serif;
            display:flex; flex-direction:column;
        }

        /* 跑馬燈 */
        .marquee-bar{background:#000;color:#0f0;padding:12px 0;min-height:60px;display:flex;align-items:center;overflow:hidden;border-bottom:3px solid var(--win-dark);z-index:2000; position:relative;}
        .marquee-content{display:flex;white-space:nowrap;font-size:1.2rem;animation:scroll 25s linear infinite;letter-spacing:2px;}
        @keyframes scroll{0%{transform:translateX(0);}100%{transform:translateX(-50%);}}

        .desktop-wrapper{display:flex;flex:1;padding:25px;position:relative;min-height:900px;}
        
        /* 桌面圖標 */
        .desktop-grid { display: flex; flex-direction: column; flex-wrap: wrap; gap: 20px; height: 800px; width: 120px; z-index: 10; align-content: flex-start;}
        .desktop-icon{display:flex;flex-direction:column;align-items:center;text-decoration:none;padding:8px 5px;cursor:pointer; width: 100px;}
        .desktop-icon .icon-emoji{font-size:40px;margin-bottom:5px;filter:drop-shadow(2px 2px 0px rgba(0,0,0,1)); transition: transform 0.1s;}
        .icon-text{color:#fff;background-color:var(--win-blue);font-size:13px;text-align:center;padding:2px 6px;border:1px dotted transparent; word-break: break-all;}
        .desktop-icon:hover .icon-emoji { transform: scale(1.1); }
        .desktop-icon:hover .icon-text { border: 1px dotted #fff; background-color: #4B2D8C; }

        /* ==========================================
           🗂️ 全局 XP/Y2K OS 立體視窗通用樣式
           ========================================== */
        .window {
            background: var(--os-win-body);
            border: 2px solid var(--os-border);
            border-radius: 6px; /* 賦予 XP 圓角 */
            box-shadow: 
                3px 3px 6px rgba(0,0,0,0.4), /* 外部柔軟陰影 */
                inset 1px 1px 1px var(--os-light-shadow), /* 內部高光 */
                inset -1px -1px 1px rgba(0,0,0,0.2); /* 內部陰影 */
            display: flex;
            flex-direction: column;
            position: absolute;
            z-index: 100;
            padding: 2px;
            overflow: hidden; /* 確保內容不會溢出圓角 */
        }
        
        .title-bar {
            background: linear-gradient(180deg, var(--os-title-start), var(--os-title-end));
            border-bottom: 2px solid var(--os-border);
            border-radius: 4px 4px 0 0;
            color: #000;
            padding: 6px 10px;
            font-size: 13px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            cursor: move;
            user-select: none;
            letter-spacing: 1px;
            font-weight: bold;
        }
        .win-controls { display: flex; flex-direction: row; gap: 4px; }
        .win-btn {
            width: 20px; height: 20px;
            background: linear-gradient(180deg, #f0f0f0, #c0c0c0);
            border: 1px solid var(--os-border);
            border-radius: 3px;
            color: #000;
            font-family: 'Pixel', sans-serif;
            font-size: 11px;
            font-weight: bold;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            box-shadow: 1px 1px 1px rgba(0,0,0,0.5);
        }
        .win-btn:active {
            background: linear-gradient(180deg, #c0c0c0, #f0f0f0);
            box-shadow: inset 1px 1px 2px rgba(0,0,0,0.6);
            transform: translate(1px, 1px);
        }
        
        .sys-menu, .paint-menu { display: flex; gap: 10px; padding: 4px 8px; font-size: 12px; border-bottom: 1px solid var(--win-dark); color: #000;}
        .sys-menu span, .paint-menu span { padding: 2px 6px; cursor: pointer; border-radius: 2px;}
        .sys-menu span:first-letter, .paint-menu span:first-letter { text-decoration: underline; }
        .sys-menu span:hover, .paint-menu span:hover { background-color: var(--win-blue); color: #fff; }

        /* ==========================================
           🎨 中央小畫家視窗 (Canvas.exe)
           ========================================== */
        #paint-win { width: 660px; left: 28%; top: 12%; z-index: 150;}
        .paint-body { display: flex; flex-direction: row; background: var(--os-win-body); border: 2px inset var(--win-light); border-radius: 0 0 4px 4px; }
        
        .paint-tools { width: 52px; display: flex; flex-wrap: wrap; align-content: flex-start; gap: 2px; padding: 3px; background: var(--os-win-body); border-radius: 0 0 0 4px; }
        .tool-btn { width: 22px; height: 22px; border: 1px outset var(--win-light); background: #eee; font-size: 12px; display: flex; justify-content: center; align-items: center; cursor: pointer; }
        .tool-btn:hover { background: #ddd; }
        .tool-btn.active { border: 1px inset var(--win-light); background: #d0d0d0; box-shadow: inset 1px 1px 2px rgba(0,0,0,0.2); }
        
        .paint-workspace { flex: 1; display: flex; flex-direction: column; padding-left: 2px; border-left: 1px solid var(--win-dark); border-radius: 0 0 4px 0;}
        
        .paint-canvas-container { flex: 1; background: #949494; padding: 4px; overflow: hidden; position: relative; min-height: 380px;}
        .paint-canvas { background: #fff; width: 100%; height: 100%; border: 2px dashed #888; overflow-y: auto; padding: 25px; position: relative; font-family: 'Noto Serif TC', serif; }
        
        .paint-palette-bar { height: 45px; display: flex; align-items: center; gap: 8px; padding: 4px 6px; background: var(--os-win-body); border-top: 1px solid var(--win-light);}
        .color-indicator { width: 32px; height: 32px; border: 2px inset var(--win-light); background: var(--os-win-body); position: relative; flex-shrink: 0;}
        .color-bg { position: absolute; right: 2px; bottom: 2px; width: 14px; height: 14px; background: #ffffff; border: 1px inset #888; }
        .color-fg { position: absolute; left: 2px; top: 2px; width: 14px; height: 14px; background: #000000; border: 1px inset #888; z-index: 2; }
        .color-grid { display: flex; flex-wrap: wrap; width: 200px; gap: 1px; align-content: flex-start;}
        .color-box { width: 13px; height: 13px; border: 1px inset var(--win-light); }
        
        .canvas-section { display: none; animation: fadeIn 0.3s; }
        .canvas-section.active { display: block; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(5px); } to { opacity: 1; transform: translateY(0); } }

        /* 畫布內容排版 */
        .intro-slogan { font-family: 'DotGothic16', sans-serif; font-size: 22px; color: var(--win-blue); font-weight: bold; margin-bottom: 15px; border-bottom: 2px solid var(--win-blue); padding-bottom: 5px; display: inline-block;}
        .y2k-tag { font-family: 'DotGothic16', sans-serif; font-size: 13px; background: #fff; color: var(--win-blue); padding: 2px 8px; border: 1px solid var(--win-blue); margin-right: 5px; display: inline-block; margin-bottom: 15px; font-weight: bold;}
        
        /* 🎨 重新引入並應用板块顏色的進度條 */
        .skill-title { font-size: 14px; font-weight: bold; margin-bottom: 6px; color: var(--win-blue); font-family: 'DotGothic16', sans-serif;}
        .skill-bar { margin-bottom: 18px; }
        .bar-bg { display: block; width: 100%; height: 16px; border: 2px inset var(--win-dark); background: #f9f9f9; }
        .bar-fill { display: block; height: 100%; }

        .philosophy-box { background: #fdfbf7; border: 1px dashed #ccc; padding: 20px; margin-top: 15px; font-size: 14.5px; line-height: 1.8;}
        .status-bar { padding: 4px 10px; font-size: 12px; background: var(--os-win-body); border-top: 1px solid var(--win-dark); color: #333; font-family: 'PMingLiU', sans-serif; border-radius: 0 0 4px 4px; }

        /* ==========================================
           🌐 社群媒體矩陣視窗 (XP 立體外框 + 內部大膽撞色)
           打破統一長寬，呈現亂中有序的設計感
           ========================================== */
        .social-content {
            border: 2px solid;
            border-color: var(--os-dark-shadow) var(--os-light-shadow) var(--os-light-shadow) var(--os-dark-shadow); /* 內部內凹 Inset border */
            padding: 30px 20px;
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            gap: 15px;
            font-family: 'PMingLiU', '細明體', serif;
            min-height: 180px;
            justify-content: center;
            border-radius: 0 0 4px 4px;
        }
        
        .social-content h2 { font-family: 'DotGothic16', sans-serif; font-size: 24px; margin: 0; letter-spacing: 1px; }
        .social-content p { font-size: 13px; margin: 8px 0; font-weight: bold; letter-spacing: 1px; }
        
        .os-btn {
            display: inline-block;
            padding: 6px 18px;
            text-decoration: none;
            font-size: 13px;
            font-weight: bold;
            margin-top: 15px;
            font-family: 'PMingLiU', sans-serif;
            border: 2px solid;
            border-color: var(--win-light) var(--os-dark-shadow) var(--os-dark-shadow) var(--win-light);
            border-radius: 3px;
            transition: 0.1s;
        }
        .os-btn:active { transform: translate(1px, 1px); box-shadow: inset 1px 1px 2px rgba(0,0,0,0.6); }

        /* ✨ Instagram (左側): 杏桃黃底 × 深咖字 (不同長寬: 280x280) */
        #ig-win { left: 10%; top: 8%; width: 280px; height: 280px; }
        #ig-win .social-content { background-color: var(--pop-ig-inner-bg); color: var(--pop-ig-inner-ink); }
        #ig-win h2, #ig-win p { color: var(--pop-ig-inner-ink); }
        #ig-win .os-btn { background-color: #ffd7aa; color: var(--pop-ig-inner-ink); border-color: #ffd7aa #5C3A21 #5C3A21 #ffd7aa;}
        #ig-win .os-btn:hover { background-color: var(--pop-ig-inner-ink); color: var(--pop-ig-inner-bg); border-color: var(--pop-ig-inner-ink);}

        /* ✨ 小紅書 (右側): 開心果綠底 × 深墨綠字 (不同長寬: 240x300) */
        #red-win { left: 68%; top: 22%; width: 240px; height: 300px; }
        #red-win .social-content { background-color: var(--pop-red-inner-bg); color: var(--pop-red-inner-ink); }
        #red-win h2, #red-win p { color: var(--pop-red-inner-ink); }
        #red-win .os-btn { background-color: #a8dbae; color: var(--pop-red-inner-ink); border-color: #a8dbae #1B4332 #1B4332 #a8dbae;}
        #red-win .os-btn:hover { background-color: var(--pop-red-inner-ink); color: var(--pop-red-inner-bg); border-color: var(--pop-red-inner-ink);}

        /* ✨ Threads (左下): 櫻花柔粉底 × 深靛藍字 (不同長寬: 300x240) */
        #threads-win { left: 14%; top: 58%; width: 300px; height: 240px; }
        #threads-win .social-content { background-color: var(--pop-th-inner-bg); color: var(--pop-th-inner-ink); }
        #threads-win h2, #threads-win p { color: var(--pop-th-inner-ink); }
        #threads-win .os-btn { background-color: #f7b4b9; color: var(--pop-th-inner-ink); border-color: #f7b4b9 #2E1B4E #2E1B4E #f7b4b9;}
        #threads-win .os-btn:hover { background-color: var(--pop-th-inner-ink); color: var(--pop-th-inner-bg); border-color: var(--pop-th-inner-ink);}

        /* ==========================================
           📌 任務欄與底部元素 (回歸全局 XP OS 立體感)
           ========================================== */
        .taskbar{position:fixed;bottom:0;left:0;right:0;height:42px;background:linear-gradient(180deg, #f0f0f0, #c0c0c0);border-top:2px solid var(--os-border);display:flex;align-items:center;padding:0 6px;z-index:3000;box-shadow:inset 0 1px 0 #dfdfdf;}
        
        .start-btn{background:linear-gradient(180deg, #f0f0f0, #c0c0c0);border:2px solid;border-color:var(--win-light) var(--os-dark-shadow) var(--os-dark-shadow) var(--win-light);padding:4px 12px;display:flex;align-items:center;gap:8px;text-decoration:none;color:#000;font-size:15px;font-weight:bold;flex-shrink:0;border-radius: 4px; box-shadow: 1px 1px 1px rgba(0,0,0,0.5);}
        .start-btn:active{border-color:var(--os-dark-shadow) var(--win-light) var(--win-light) var(--os-dark-shadow);padding:5px 11px 3px 13px; box-shadow: inset 1px 1px 1px rgba(0,0,0,0.5);}
        
        .taskbar-windows{display:flex;gap:5px;margin-left:10px;flex:1;overflow-x:auto;}
        
        .taskbar-win-tab{background:linear-gradient(180deg, #f0f0f0, #c0c0c0);border:2px solid;border-color:var(--win-light) var(--os-dark-shadow) var(--os-dark-shadow) var(--win-light);padding:4px 12px;font-size:13px;color:#000;display:none;align-items:center;gap:6px;cursor:pointer;max-width:140px; overflow:hidden; white-space:nowrap; text-overflow:ellipsis; user-select: none; border-radius: 3px; box-shadow: 1px 1px 1px rgba(0,0,0,0.5);}
        .taskbar-win-tab.visible { display: flex; }
        .taskbar-win-tab.active{border-color:var(--os-dark-shadow) var(--win-light) var(--win-light) var(--os-dark-shadow);background:#d0d0d0;font-weight:bold;background-image:repeating-linear-gradient(45deg,transparent,transparent 2px,#c0c0c0 2px,#c0c0c0 4px); box-shadow: inset 1px 1px 1px rgba(0,0,0,0.5);}
        
        .subscribe-pill{background:linear-gradient(180deg, #ff66b3, #db2c88);color:white;padding:4px 15px;text-decoration:none;border:2px solid #000;box-shadow:2px 2px 0 #000;flex-shrink:0;font-size:13px; font-weight: bold; border-radius: 4px;}
        .subscribe-pill:active { transform: translate(1px, 1px); box-shadow: 0px 0px 0 #000; }

        .system-tray{margin-left:10px;display:flex;gap:8px;align-items:center;flex-shrink:0;border:2px solid;border-color:var(--os-dark-shadow) var(--win-light) var(--win-light) var(--os-dark-shadow);padding:2px 10px;height:32px;border-radius: 3px; box-shadow: 1px 1px 1px rgba(0,0,0,0.5);}
        .social-link{color:#000;text-decoration:none;font-size:12px; font-weight: bold;}
        .social-link:hover{color:var(--win-blue);text-decoration:underline;}
        
        .lang-switch{display:flex;gap:6px;align-items:center;border-left:1px solid var(--win-dark);border-right:1px solid var(--win-light);padding:0 10px;font-size:13px;}
        .lang-link{color:var(--win-dark);text-decoration:none;}
        .lang-link.active{color:#000;font-weight:bold;text-decoration:underline;}
        
        .clock{font-size:13px;color:#000; margin-left: 5px;}

        @media (max-width: 900px) {
            .social-win { display: none !important; }
            .window { width: 90vw !important; left: 5vw !important; position: absolute !important; top: 10vh !important; }
            .desktop-grid { flex-direction: row; height: auto; width: 100%; justify-content: center; }
            .subscribe-pill { display: none; }
        }
    </style>
</head>
<body>
    
    <div class="marquee-bar">
        <div class="marquee-content">
            >> SYSTEM.MSG: [ <span style="color:var(--skill-pink);">第四季早鳥活動</span> ] 進行中_ // ENDS_ON: <span style="color:var(--skill-green);">2026.05.17</span> // [ <span style="color:var(--skill-purple);">全新主題策展正刊 ＋ 雜誌通信副刊</span> ] // 在邊緣捕捉與想像 ✴ &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
            >> SYSTEM.MSG: [ <span style="color:var(--skill-pink);">第四季早鳥活動</span> ] 進行中_ // ENDS_ON: <span style="color:var(--skill-green);">2026.05.17</span> // [ <span style="color:var(--skill-purple);">全新主題策展正刊 ＋ 雜誌通信副刊</span> ] // 在邊緣捕捉與想像 ✴ &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
        </div>
    </div>

    <div class="desktop-wrapper">
        <div class="desktop-grid">
            <a href="/" class="desktop-icon"><span class="icon-emoji">🏠</span><span class="icon-text">主頁</span></a>
            <a href="/zh-tw/about" class="desktop-icon"><span class="icon-emoji">🐘</span><span class="icon-text">關於小象</span></a>
            <a href="/zh-tw/archive" class="desktop-icon"><span class="icon-emoji">📂</span><span class="icon-text">往期目錄</span></a>
            <a href="/zh-tw/guestbook" class="desktop-icon"><span class="icon-emoji">💬</span><span class="icon-text">留言板</span></a>
            
            <div style="height: 10px;"></div>
            
            <div class="desktop-icon" onclick="openApp('ig-win')"><span class="icon-emoji">📷</span><span class="icon-text">Instagram</span></div>
            <div class="desktop-icon" onclick="openApp('red-win')"><span class="icon-emoji">📕</span><span class="icon-text">小紅書</span></div>
            <div class="desktop-icon" onclick="openApp('threads-win')"><span class="icon-emoji">🧵</span><span class="icon-text">Threads</span></div>
        </div>

        <div id="ig-win" class="window social-win" style="display: flex;">
            <div class="title-bar drag-handle">
                <div style="display: flex; align-items: center; gap: 6px;">
                    <span>📷</span><span>Instagram.exe</span>
                </div>
                <div class="win-controls">
                    <div class="win-btn">_</div>
                    <div class="win-btn">□</div>
                    <div class="win-btn" onclick="closeApp('ig-win')">×</div>
                </div>
            </div>
            <div class="social-content">
                <div style="font-size: 45px; margin-bottom: 5px;">📸</div>
                <h2>Instagram</h2>
                <p>@icarusrootedbutflow</p>
                <a href="https://www.instagram.com/icarusrootedbutflow/" target="_blank" class="os-btn">Execute / 執行</a>
            </div>
        </div>

        <div id="red-win" class="window social-win" style="display: flex;">
            <div class="title-bar drag-handle">
                <div style="display: flex; align-items: center; gap: 6px;">
                    <span>📕</span><span>Xiaohongshu.app</span>
                </div>
                <div class="win-controls">
                    <div class="win-btn">_</div>
                    <div class="win-btn">□</div>
                    <div class="win-btn" onclick="closeApp('red-win')">×</div>
                </div>
            </div>
            <div class="social-content">
                <div style="font-size: 45px; margin-bottom: 5px;">📔</div>
                <h2>小紅書 RED</h2>
                <p>@Apollo11-</p>
                <a href="https://www.xiaohongshu.com/user/profile/5b7e4ac17cdd3b0001bc4c58" target="_blank" class="os-btn">Execute / 執行</a>
            </div>
        </div>

        <div id="threads-win" class="window social-win" style="display: flex;">
            <div class="title-bar drag-handle">
                <div style="display: flex; align-items: center; gap: 6px;">
                    <span>🧵</span><span>Threads.sys</span>
                </div>
                <div class="win-controls">
                    <div class="win-btn">_</div>
                    <div class="win-btn">□</div>
                    <div class="win-btn" onclick="closeApp('threads-win')">×</div>
                </div>
            </div>
            <div class="social-content">
                <div style="font-size: 45px; margin-bottom: 5px;">🕸️</div>
                <h2>Threads</h2>
                <p>@icarusrootedbutflow</p>
                <a href="https://www.threads.net/@icarusrootedbutflow" target="_blank" class="os-btn">Execute / 執行</a>
            </div>
        </div>

        <div id="paint-win" class="window" style="display: flex;">
            <div class="title-bar drag-handle">
                <div style="display: flex; align-items: center; gap: 6px;">
                    <span>🎨</span><span>Canvas.exe - 關於創作者</span>
                </div>
                <div class="win-controls">
                    <div class="win-btn">_</div>
                    <div class="win-btn">□</div>
                    <div class="win-btn" onclick="closeApp('paint-win')">×</div>
                </div>
            </div>
            <div class="paint-menu">
                <span>File</span><span>Edit</span><span>View</span><span>Image</span><span>Options</span><span>Help</span>
            </div>
            
            <div class="paint-body">
                <div class="paint-tools">
