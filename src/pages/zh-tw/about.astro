// src/pages/zh-tw/about.astro
---
<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>關於小象 | 推開部屋的門</title>
    <link href="https://fonts.googleapis.com/css2?family=DotGothic16&family=Noto+Serif+TC:wght@400;700;900&display=swap" rel="stylesheet">
    <style>
        :root{
            /* 經典 OS 全局配色 */
            --win-gray:#c0c0c0; --win-dark:#808080; --win-light:#ffffff;
            --win-blue:#000080; --y2k-purple:#4B2D8C; --y2k-pink:#FF66B3; --y2k-mint:#B2F5EA;
            
            /* 🎨 獨立窗格內部撞色配色 (高對比跳色) */
            --bg-ig: #B2F5EA; --ink-ig: #000080;   /* 左側: 薄荷藍 x 深藍 */
            --bg-red: #FDF1B8; --ink-red: #8A2828; /* 右側 (粉紫背景): 奶油黃 x 深磚紅 (高對比) */
            --bg-th: #E6E6FA; --ink-th: #4B2D8C;   /* 左下 (綠黃背景): 薰衣草紫 x 深紫 (高對比) */
        }
        *{margin:0;padding:0;box-sizing:border-box;cursor:default;}
        html,body{height:auto;min-height:100%; overflow-x:hidden;}
        
        body{
            background:linear-gradient(rgba(255,255,255,0.3) 1px,transparent 1px),
                       linear-gradient(90deg,rgba(255,255,255,0.3) 1px,transparent 1px),
                       linear-gradient(to right,#98fb98,#fffacd,#ffebcd,#ffb6c1,#e0b0ff);
            background-size:20px 20px,20px 20px,100% 100%;
            background-attachment:fixed;
            font-family:'DotGothic16','PMingLiU','MingLiU','細明體','SimSun',sans-serif;
            display:flex; flex-direction:column;
        }

        /* 跑馬燈 */
        .marquee-bar{background:#000;color:#0f0;padding:12px 0;min-height:60px;display:flex;align-items:center;overflow:hidden;border-bottom:3px solid var(--win-dark);z-index:2000; position:relative;}
        .marquee-content{display:flex;white-space:nowrap;font-size:1.2rem;animation:scroll 25s linear infinite;letter-spacing:2px;}
        @keyframes scroll{0%{transform:translateX(0);}100%{transform:translateX(-50%);}}

        .desktop-wrapper{display:flex;flex:1;padding:25px;position:relative;min-height:900px;}
        
        /* 桌面圖標排版 */
        .desktop-grid { display: flex; flex-direction: column; gap: 15px; width: 120px; z-index: 10;}
        
        /* 📍 修改點：桌面圖標層級分隔 */
        .desktop-divider { height: 2px; border-bottom: 2px dashed rgba(0,0,0,0.3); margin: 10px 0; width: 80%; align-self: center; }
        .desktop-group-title { background: var(--win-light); border: 1px solid var(--win-dark); padding: 2px 6px; font-size: 11px; font-weight: bold; text-align: center; color: var(--win-dark); width: 80%; align-self: center; margin-bottom: 5px;}

        .desktop-icon{display:flex;flex-direction:column;align-items:center;text-decoration:none;padding:8px 5px;cursor:pointer; width: 100%;}
        .desktop-icon .icon-emoji{font-size:40px;margin-bottom:5px;filter:drop-shadow(2px 2px 0px rgba(0,0,0,1)); transition: transform 0.1s;}
        .icon-text{color:#fff;background-color:var(--win-blue);font-size:13px;text-align:center;padding:2px 6px;border:1px dotted transparent; word-break: break-all;}
        .desktop-icon:hover .icon-emoji { transform: scale(1.1); }
        .desktop-icon:hover .icon-text { border: 1px dotted #fff; background-color: var(--y2k-purple); }

        /* ==========================================
           🗂️ 獨立視窗通用樣式 (經典 OS 灰框)
           ========================================== */
        .window { background: var(--win-gray); border: 2px solid; border-color: var(--win-light) #000 #000 var(--win-light); box-shadow: inset 1px 1px 0 #dfdfdf, inset -1px -1px 0 var(--win-dark), 2px 2px 0 rgba(0,0,0,0.5); display: flex; flex-direction: column; position: absolute; z-index: 100; padding: 3px; }
        
        .title-bar { background: linear-gradient(90deg, var(--win-blue), #1084d0); color: white; padding: 4px 6px; font-size: 13px; display: flex; justify-content: space-between; align-items: center; cursor: move; user-select: none; letter-spacing: 1px; font-weight: bold;}
        .win-controls { display: flex; flex-direction: row; gap: 3px; }
        .win-btn { width: 18px; height: 18px; background-color: var(--win-gray); border: 2px solid; border-color: var(--win-light) var(--win-dark) var(--win-dark) var(--win-light); color: #000; font-family: 'Pixel', sans-serif; font-size: 10px; font-weight: bold; display: flex; align-items: center; justify-content: center; cursor: pointer; box-shadow: 1px 1px 0 #000; }
        .win-btn:active { border-color: var(--win-dark) var(--win-light) var(--win-light) var(--win-dark); padding-top: 2px; padding-left: 2px; box-shadow: none; }
        
        .sys-menu, .paint-menu { display: flex; gap: 10px; padding: 3px 6px; font-size: 12px; border-bottom: 1px solid var(--win-dark); color: #000;}
        .sys-menu span, .paint-menu span { padding: 2px 6px; cursor: pointer;}
        .sys-menu span:first-letter, .paint-menu span:first-letter { text-decoration: underline; }
        .sys-menu span:hover, .paint-menu span:hover { background-color: var(--win-blue); color: #fff; }

        /* ==========================================
           🎨 中央小畫家視窗 (Canvas.exe)
           ========================================== */
        #paint-win { width: 660px; left: 28%; top: 12%; z-index: 150;}
        .paint-body { display: flex; flex-direction: row; background: var(--win-gray); border: 2px inset var(--win-light); }
        
        .paint-tools { width: 52px; display: flex; flex-wrap: wrap; align-content: flex-start; gap: 2px; padding: 3px; background: var(--win-gray); }
        .tool-btn { width: 22px; height: 22px; border: 1px outset var(--win-light); background: #eee; font-size: 12px; display: flex; justify-content: center; align-items: center; cursor: pointer; }
        .tool-btn:hover { background: #ddd; }
        .tool-btn.active { border: 1px inset var(--win-light); background: #d0d0d0; box-shadow: inset 1px 1px 2px rgba(0,0,0,0.2); }
        
        .paint-workspace { flex: 1; display: flex; flex-direction: column; padding-left: 2px; border-left: 1px solid var(--win-dark);}
        
        .paint-canvas-container { flex: 1; background: #949494; padding: 4px; overflow: hidden; position: relative; min-height: 380px;}
        .paint-canvas { background: #fff; width: 100%; height: 100%; border: 2px dashed #888; overflow-y: auto; padding: 25px; position: relative; font-family: 'Noto Serif TC', serif; }
        
        .paint-palette-bar { height: 45px; display: flex; align-items: center; gap: 8px; padding: 4px 6px; background: var(--win-gray); border-top: 1px solid var(--win-light);}
        .color-indicator { width: 32px; height: 32px; border: 2px inset var(--win-light); background: var(--win-gray); position: relative; flex-shrink: 0;}
        .color-bg { position: absolute; right: 2px; bottom: 2px; width: 14px; height: 14px; background: #ffffff; border: 1px inset #888; }
        .color-fg { position: absolute; left: 2px; top: 2px; width: 14px; height: 14px; background: #000000; border: 1px inset #888; z-index: 2; }
        .color-grid { display: flex; flex-wrap: wrap; width: 200px; gap: 1px; align-content: flex-start;}
        .color-box { width: 13px; height: 13px; border: 1px inset var(--win-light); }
        
        .canvas-section { display: none; animation: fadeIn 0.3s; }
        .canvas-section.active { display: block; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(5px); } to { opacity: 1; transform: translateY(0); } }

        /* 畫布內容排版 */
        .intro-slogan { font-family: 'DotGothic16', sans-serif; font-size: 22px; color: var(--win-blue); font-weight: bold; margin-bottom: 15px; border-bottom: 2px solid var(--win-blue); padding-bottom: 5px; display: inline-block;}
        
        .y2k-tag { font-family: 'DotGothic16', sans-serif; font-size: 13px; padding: 2px 8px; border: 1px solid #000; margin-right: 5px; display: inline-block; margin-bottom: 15px; font-weight: bold; box-shadow: 2px 2px 0 rgba(0,0,0,0.15);}
        .tag-creator { background: var(--win-blue); color: #fff; }
        .tag-editor { background: var(--y2k-pink); color: #fff; }
        
        .skill-title { font-size: 14px; font-weight: bold; margin-bottom: 6px; color: var(--win-blue); font-family: 'DotGothic16', sans-serif;}
        .skill-bar { margin-bottom: 18px; }
        .bar-bg { display: block; width: 100%; height: 16px; border: 2px inset var(--win-dark); background: #f9f9f9; }
        .bar-fill { display: block; height: 100%; }

        .philosophy-box { background: #fdfbf7; border: 1px dashed #ccc; padding: 20px; margin-top: 15px; font-size: 14.5px; line-height: 1.8;}
        .status-bar { padding: 3px 6px; font-size: 12px; background: var(--win-gray); border-top: 1px solid var(--win-dark); color: #333; font-family: 'PMingLiU', sans-serif; }

        /* ==========================================
           🌐 社群媒體矩陣視窗：無 Emoji 復古程式風
           ========================================== */
        .social-win { padding: 3px; display: flex; flex-direction: column; position: absolute; z-index: 100;}
        
        .social-inner-content {
            margin-top: 2px;
            border: 2px inset var(--win-light);
            display: flex; flex-direction: column; align-items: center; justify-content: center;
            height: 100%; padding: 20px; text-align: center; cursor: pointer;
            font-family: 'PMingLiU', '細明體', serif;
            position: relative;
        }

        .social-inner-content p { font-size: 13px; font-weight: bold; letter-spacing: 1px; margin: 8px 0; }

        .execute-btn {
            display: inline-block; padding: 4px 16px; text-decoration: none; font-size: 12px; font-weight: bold; margin-top: 15px;
            font-family: 'PMingLiU', sans-serif; border: 2px solid #000; box-shadow: 2px 2px 0 #000; color: #000; background: #fff; transition: 0.1s;
        }
        .execute-btn:active { transform: translate(2px, 2px); box-shadow: 0 0 0 transparent; }

        /* 📸 Instagram: 橫向長方形 (340x240) */
        #ig-win { width: 340px; height: 240px; left: 8%; top: 10%; }
        #ig-win .social-inner-content { background: var(--bg-ig); color: var(--ink-ig); }
        .ig-retro-box { border: 2px dashed var(--ink-ig); padding: 10px 20px; margin-bottom: 10px; width: 90%; background: rgba(255,255,255,0.4); }
        .ig-retro-box h2 { font-family: 'DotGothic16', sans-serif; font-size: 22px; margin: 0; letter-spacing: 2px; }
        
        /* 📕 小紅書: 窄高長方形 (220x360) - 換成高對比奶油黃 */
        #red-win { width: 220px; height: 360px; left: 70%; top: 15%; }
        #red-win .social-inner-content { background: var(--bg-red); color: var(--ink-red); }
        .red-retro-line { width: 100%; height: 3px; background: var(--ink-red); margin: 10px 0; }
        #red-win h2 { font-family: 'DotGothic16', sans-serif; font-size: 18px; margin: 0; border: 1px solid var(--ink-red); padding: 4px 10px; background: rgba(255,255,255,0.5);}

        /* 🧵 Threads: 正方形 (250x250) - 換成高對比薰衣草紫 */
        #threads-win { width: 250px; height: 250px; left: 14%; top: 58%; }
        #threads-win .social-inner-content { background: var(--bg-th); color: var(--ink-th); }
        #threads-win h2 { font-family: 'DotGothic16', sans-serif; font-size: 20px; margin: 0; letter-spacing: 1px; }
        .th-retro-bracket { font-family: 'DotGothic16', sans-serif; font-size: 16px; opacity: 0.7; margin-bottom: 10px; }

        /* ==========================================
           📌 任務欄與底部元素
           ========================================== */
        .taskbar{position:fixed;bottom:0;left:0;right:0;height:42px;background:var(--win-gray);border-top:2px solid var(--win-light);display:flex;align-items:center;padding:0 6px;z-index:3000;box-shadow:inset 0 1px 0 #dfdfdf;}
        
        .start-btn{background:var(--win-gray);border:2px solid;border-color:var(--win-light) var(--win-dark) var(--win-dark) var(--win-light);padding:4px 12px;display:flex;align-items:center;gap:8px;text-decoration:none;color:#000;font-size:15px;font-weight:bold;flex-shrink:0;}
        .start-btn:active{border-color:var(--win-dark) var(--win-light) var(--win-light) var(--win-dark);padding:5px 11px 3px 13px;}
        
        .taskbar-windows{display:flex;gap:5px;margin-left:10px;flex:1;overflow-x:auto;}
        
        .taskbar-win-tab{background:var(--win-gray);border:2px solid;border-color:var(--win-light) var(--win-dark) var(--win-dark) var(--win-light);padding:4px 12px;font-size:13px;color:#000;display:none;align-items:center;gap:6px;cursor:pointer;max-width:140px; overflow:hidden; white-space:nowrap; text-overflow:ellipsis; user-select: none;}
        .taskbar-win-tab.visible { display: flex; }
        .taskbar-win-tab.active{border-color:var(--win-dark) var(--win-light) var(--win-light) var(--win-dark);background:#d0d0d0;font-weight:bold;background-image:repeating-linear-gradient(45deg,transparent,transparent 2px,#c0c0c0 2px,#c0c0c0 4px);}
        
        .subscribe-pill{background:var(--y2k-pink);color:white;padding:4px 15px;text-decoration:none;border:2px solid #000;box-shadow:2px 2px 0 #000;flex-shrink:0;font-size:13px; font-weight: bold;}
        .subscribe-pill:active { transform: translate(1px, 1px); box-shadow: 0px 0px 0 #000; }

        .system-tray{margin-left:10px;display:flex;gap:8px;align-items:center;flex-shrink:0;border:2px solid;border-color:var(--win-dark) var(--win-light) var(--win-light) var(--win-dark);padding:2px 10px;height:32px;}
        .social-link{color:#000;text-decoration:none;font-size:12px; font-weight: bold;}
        .social-link:hover{color:var(--win-blue);text-decoration:underline;}
        
        .lang-switch{display:flex;gap:6px;align-items:center;border-left:1px solid var(--win-dark);border-right:1px solid var(--win-light);padding:0 10px;font-size:13px;}
        .lang-link{color:var(--win-dark);text-decoration:none;}
        .lang-link.active{color:#000;font-weight:bold;text-decoration:underline;}
        
        .clock{font-size:13px;color:#000; margin-left: 5px;}

        @media (max-width: 900px) {
            .social-win { display: none !important; }
            .window { width: 90vw !important; left: 5vw !important; position: absolute !important; top: 10vh !important; }
            .desktop-grid { flex-direction: row; height: auto; width: 100%; justify-content: center; }
            .desktop-divider, .desktop-group-title { display: none; }
            .subscribe-pill { display: none; }
        }
    </style>
</head>
<body>
    
    <div class="marquee-bar">
        <div class="marquee-content">
            >> SYSTEM.MSG: [ <span style="color:var(--y2k-pink);">第四季早鳥活動</span> ] 進行中_ // ENDS_ON: <span style="color:var(--y2k-mint);">2026.05.17</span> // [ <span style="color:var(--y2k-pink);">全新主題策展正刊 ＋ 雜誌通信副刊</span> ] // 在邊緣捕捉與想像 ✴ &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
            >> SYSTEM.MSG: [ <span style="color:var(--y2k-pink);">第四季早鳥活動</span> ] 進行中_ // ENDS_ON: <span style="color:var(--y2k-mint);">2026.05.17</span> // [ <span style="color:var(--y2k-pink);">全新主題策展正刊 ＋ 雜誌通信副刊</span> ] // 在邊緣捕捉與想像 ✴ &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
        </div>
    </div>

    <div class="desktop-wrapper">
        <div class="desktop-grid">
            <a href="/" class="desktop-icon"><span class="icon-emoji">🏠</span><span class="icon-text">主頁</span></a>
            <a href="/zh-tw/about" class="desktop-icon"><span class="icon-emoji">🐘</span><span class="icon-text">關於小象</span></a>
            <a href="/zh-tw/archive" class="desktop-icon"><span class="icon-emoji">📂</span><span class="icon-text">往期目錄</span></a>
            <a href="/zh-tw/guestbook" class="desktop-icon"><span class="icon-emoji">💬</span><span class="icon-text">留言板</span></a>
            
            <div class="desktop-divider"></div>
            <div class="desktop-group-title">NETWORK</div>
            
            <div class="desktop-icon" onclick="openApp('ig-win')"><span class="icon-emoji">📷</span><span class="icon-text">Instagram</span></div>
            <div class="desktop-icon" onclick="openApp('red-win')"><span class="icon-emoji">📕</span><span class="icon-text">小紅書</span></div>
            <div class="desktop-icon" onclick="openApp('threads-win')"><span class="icon-emoji">🧵</span><span class="icon-text">Threads</span></div>
        </div>

        <div id="ig-win" class="window social-win" style="display: flex;">
            <div class="title-bar drag-handle">
                <div style="display: flex; align-items: center; gap: 6px;">
                    <span style="font-size: 10px;">▣</span><span>Instagram.exe</span>
                </div>
                <div class="win-controls"><div class="win-btn">_</div><div class="win-btn">□</div><div class="win-btn" onclick="closeApp('ig-win')">×</div></div>
            </div>
            <div class="social-inner-content" onclick="playIg(this)">
                <div class="ig-retro-box">
                    <h2>INSTAGRAM</h2>
                </div>
                <p>USR: @icarusrootedbutflow</p>
                <div id="ig-vibe" style="margin-top: 5px; font-size: 12px; font-family: 'DotGothic16'; opacity: 0.8;">[ STATUS: ACTIVE ]</div>
                <a href="https://www.instagram.com/icarusrootedbutflow/" target="_blank" class="execute-btn" onclick="event.stopPropagation()">RUN PROGRAM</a>
            </div>
        </div>

        <div id="red-win" class="window social-win" style="display: flex;">
            <div class="title-bar drag-handle">
                <div style="display: flex; align-items: center; gap: 6px;">
                    <span style="font-size: 10px;">▣</span><span>Xiaohongshu.app</span>
                </div>
                <div class="win-controls"><div class="win-btn">_</div><div class="win-btn">□</div><div class="win-btn" onclick="closeApp('red-win')">×</div></div>
            </div>
            <div class="social-inner-content" onclick="playRed(this)">
                <h2>小紅書 RED</h2>
                <div class="red-retro-line"></div>
                <p style="font-family: 'DotGothic16'; font-size: 14px;">ID: Apollo11-</p>
                <div class="red-retro-line"></div>
                <div id="red-status" style="margin-top: 10px; font-size: 12px; border: 1px dotted var(--ink-red); padding: 4px 8px;">[ 點擊載入新動態 ]</div>
                <a href="https://www.xiaohongshu.com/user/profile/5b7e4ac17cdd3b0001bc4c58" target="_blank" class="execute-btn" onclick="event.stopPropagation()">EXECUTE</a>
            </div>
        </div>

        <div id="threads-win" class="window social-win" style="display: flex;">
            <div class="title-bar drag-handle">
                <div style="display: flex; align-items: center; gap: 6px;">
                    <span style="font-size: 10px;">▣</span><span>Threads.sys</span>
                </div>
                <div class="win-controls"><div class="win-btn">_</div><div class="win-btn">□</div><div class="win-btn" onclick="closeApp('threads-win')">×</div></div>
            </div>
            <div class="social-inner-content" onclick="playThreads(this)">
                <div class="th-retro-bracket">&lt;system_log&gt;</div>
                <h2>THREADS</h2>
                <p style="font-family: 'DotGothic16';">@icarusrootedbutflow</p>
                <div id="th-quote" style="margin-top: 10px; font-size: 12px; background: rgba(0,0,0,0.1); padding: 4px; width: 100%;">[ Awaiting input... ]</div>
                <div class="th-retro-bracket" style="margin-top: 10px; margin-bottom: 0;">&lt;/system_log&gt;</div>
                <a href="https://www.threads.net/@icarusrootedbutflow" target="_blank" class="execute-btn" onclick="event.stopPropagation()">CONNECT</a>
            </div>
        </div>

        <div id="paint-win" class="window" style="display: flex;">
            <div class="title-bar drag-handle">
                <div style="display: flex; align-items: center; gap: 6px;">
                    <span>🎨</span><span>Canvas.exe - 關於創作者</span>
                </div>
                <div class="win-controls">
                    <div class="win-btn">_</div>
                    <div class="win-btn">□</div>
                    <div class="win-btn" onclick="closeApp('paint-win')">×</div>
                </div>
            </div>
            <div class="paint-menu">
                <span>File</span><span>Edit</span><span>View</span><span>Image</span><span>Options</span><span>Help</span>
            </div>
            
            <div class="paint-body">
                <div class="paint-tools">
                    <div class="tool-btn active" onclick="switchCanvas('section-intro', this)" title="個人簡介">✏️</div>
                    <div class="tool-btn" onclick="switchCanvas('section-radar', this)" title="寫作板塊">📊</div>
                    <div class="tool-btn" onclick="switchCanvas('section-philosophy', this)" title="創作理念">💡</div>
                    <div class="tool-btn">🔍</div><div class="tool-btn">✂</div><div class="tool-btn">⬚</div>
                    <div class="tool-btn">🖌</div><div class="tool-btn">A</div><div class="tool-btn">🖍</div><div class="tool-btn">🪣</div>
                </div>
                
                <div class="paint-workspace">
                    <div class="paint-canvas-container">
                        <div class="paint-canvas">
                            
                            <div id="section-intro" class="canvas-section active">
                                <div class="intro-slogan">Elephlow / 小象</div><br>
                                <span class="y2k-tag tag-creator">CREATOR</span>
                                <span class="y2k-tag tag-editor">EDITOR</span>
                                
                                <div style="margin-top: 15px; line-height: 1.8; color: #111; font-size: 15px;">
                                    <p>你好，歡迎推開這扇門。我是小象，一名內容創意工作者。</p>
                                    <p style="margin-top: 10px;">這裡不僅僅是字與圖的集散地，更像是一座虛擬的橋樑。我專注於獨立出版、東亞文學與邊緣視角的書寫，帶著相機與筆記本，在城市巷弄與藝文展會間穿梭。</p>
