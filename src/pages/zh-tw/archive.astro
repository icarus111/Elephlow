    <script is:inline>
        let zIndexCounter = 200;
        
        function bringToFront(id) {
            const win = document.getElementById(id);
            const tab = document.getElementById('tab-' + id);
            if(win) {
                if(!win.classList.contains('active')) {
                    win.classList.add('active');
                }
                win.style.zIndex = ++zIndexCounter;
            }
            if(tab) {
                tab.classList.add('visible', 'active');
            }
        }
        
        function closeWin(id) {
            const win = document.getElementById(id);
            const tab = document.getElementById('tab-' + id);
            if(win) win.classList.remove('active');
            if(tab) tab.classList.remove('visible', 'active');
        }

        const windows = document.querySelectorAll('.draggable');
        windows.forEach(win => {
            const titleBar = win.querySelector('.title-bar');
            titleBar.onmousedown = (e) => {
                // 【修復關鍵】：防止點擊按鈕時觸發拖拽
                if (e.target.closest('.win-btn')) return;

                if (window.innerWidth <= 900) return; 
                win.style.zIndex = ++zIndexCounter;
                
                let rect = win.getBoundingClientRect();
                let shiftX = e.clientX - rect.left;
                let shiftY = e.clientY - rect.top;

                function moveAt(clientX, clientY) { 
                    win.style.left = (clientX - shiftX) + 'px'; 
                    win.style.top = (clientY - shiftY) + 'px'; 
                }
                
                document.onmousemove = (e) => moveAt(e.clientX, e.clientY);
                document.onmouseup = () => { document.onmousemove = null; };
            };
            
            win.onmousedown = () => { win.style.zIndex = ++zIndexCounter; };
        });
        
        function updateClock() {
            const now = new Date(); let h = now.getHours(); let m = String(now.getMinutes()).padStart(2, '0');
            let ampm = h >= 12 ? 'PM' : 'AM'; h = h % 12; h = h ? h : 12;
            document.getElementById('live-clock').innerText = `${String(h).padStart(2, '0')}:${m} ${ampm}`;
        }
        setInterval(updateClock, 1000); updateClock();
    </script>
