---
// src/pages/zh-tw/guestbook.astro
---
<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>留言板 | 推開部屋的門</title>
    <link href="https://fonts.googleapis.com/css2?family=DotGothic16&family=Noto+Serif+TC:wght@400;700;900&display=swap" rel="stylesheet">
    <style>
        :root{--win-gray:#c0c0c0;--win-dark:#808080;--win-light:#ffffff;--win-blue:#000080;--y2k-purple:#4B2D8C;--y2k-pink:#FF66B3;--y2k-mint:#B2F5EA;--text:#000000;}
        *{margin:0;padding:0;box-sizing:border-box;cursor:default;}
        html,body{height:auto;min-height:100%;}
        body{background:linear-gradient(rgba(255,255,255,0.3) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,0.3) 1px,transparent 1px),linear-gradient(to right,#98fb98,#fffacd,#ffebcd,#ffb6c1,#e0b0ff);background-size:20px 20px,20px 20px,100% 100%;background-attachment:fixed;font-family:'DotGothic16','PMingLiU','MingLiU','細明體','SimSun',sans-serif;overflow-x:hidden;overflow-y:auto;display:flex;flex-direction:column;}
        .marquee-bar{background:#000;color:#0f0;padding:12px 0;min-height:60px;display:flex;align-items:center;overflow:hidden;border-bottom:3px solid var(--win-dark);z-index:2000;}
        .marquee-content{display:flex;white-space:nowrap;font-size:1.2rem;animation:scroll 25s linear infinite;letter-spacing:2px;}
        @keyframes scroll{0%{transform:translateX(0);}100%{transform:translateX(-50%);}}
        .desktop-wrapper{display:flex;flex:1;padding:25px;gap:40px;padding-bottom:80px;min-height:1000px;position:relative;}
        .desktop-icons{display:flex;flex-direction:column;gap:25px;width:100px;padding-top:10px;z-index:10;}
        .desktop-icon{display:flex;flex-direction:column;align-items:center;text-decoration:none;padding:10px 5px;cursor:pointer;}
        .icon-emoji{font-size:40px;margin-bottom:5px;filter:drop-shadow(2px 2px 0px rgba(0,0,0,1));}
        .icon-text{color:#fff;background-color:var(--win-blue);font-size:13px;text-align:center;padding:2px 6px;border:1px dotted transparent;}
        .desktop-icon:hover .icon-text{border:1px dotted #fff;background-color:var(--y2k-purple);}
        #playground{flex:1;position:relative;}
        
        .window{background:var(--win-gray);border:2px solid;border-color:var(--win-light) #000 #000 var(--win-light);box-shadow:inset 1px 1px 0 #dfdfdf,inset -1px -1px 0 var(--win-dark),2px 2px 0 rgba(0,0,0,0.5);display:flex;flex-direction:column;position:absolute;height:auto;padding:3px;}
        .title-bar{background:linear-gradient(90deg,var(--win-blue),#1084d0);padding:3px 6px;display:flex;justify-content:space-between;align-items:center;color:white;font-size:13px;cursor:move;letter-spacing:1px;}
        .win-controls{display:flex;gap:2px;margin-left:10px;}
        .win-btn{width:18px;height:18px;background-color:var(--win-gray);border:2px solid;border-color:var(--win-light) var(--win-dark) var(--win-dark) var(--win-light);color:#000;font-family:'Pixel',sans-serif;font-size:10px;font-weight:bold;display:flex;align-items:center;justify-content:center;cursor:pointer;box-shadow:1px 1px 0 #000;}
        .win-btn:active{border-color:var(--win-dark) var(--win-light) var(--win-light) var(--win-dark);padding-top:2px;padding-left:2px;box-shadow:none;}
        .win-content{flex:1;background:#fffcf2;margin-top:4px;padding:25px;border:2px solid;border-color:var(--win-dark) var(--win-light) var(--win-light) var(--win-dark);font-family:'Noto Serif TC',serif;font-size:0.95rem;line-height:1.8;color:#111;text-align:justify;}
        
        .win-content mark { background-color: var(--y2k-mint); color: #000; padding: 0 4px; font-weight: 700; border-radius: 2px; }
        .win-content strong { color: var(--y2k-purple); font-weight: 900; }
        .win-content em { color: var(--y2k-pink); font-style: normal; font-weight: bold; }
        .action-btn { display: inline-block; background: var(--y2k-mint); border: 2px solid #000; padding: 8px 20px; font-weight: 900; text-decoration: none; color: #000; box-shadow: 2px 2px 0 var(--y2k-purple); margin-top: 15px; transition: all 0.1s; cursor: pointer; font-family:'Noto Serif TC',serif;}
        .action-btn:active { transform: translate(2px, 2px); box-shadow: 0px 0px 0 var(--y2k-purple); }

        .taskbar{position:fixed;bottom:0;left:0;right:0;height:42px;background:var(--win-gray);border-top:2px solid var(--win-light);display:flex;align-items:center;padding:0 6px;z-index:3000;box-shadow:inset 0 1px 0 #dfdfdf;}
        .start-btn{background:var(--win-gray);border:2px solid;border-color:var(--win-light) var(--win-dark) var(--win-dark) var(--win-light);padding:4px 12px;display:flex;align-items:center;gap:8px;text-decoration:none;color:#000;font-size:15px;font-weight:bold;flex-shrink:0;}
        .start-btn:active{border-color:var(--win-dark) var(--win-light) var(--win-light) var(--win-dark);padding:5px 11px 3px 13px;}
        .taskbar-windows{display:flex;gap:5px;margin-left:10px;flex:1;overflow-x:auto;}
        .taskbar-win-tab{background:var(--win-gray);border:2px solid;border-color:var(--win-light) var(--win-dark) var(--win-dark) var(--win-light);padding:4px 12px;font-size:13px;color:#000;display:flex;align-items:center;gap:6px;cursor:pointer;max-width:200px;}
        .taskbar-win-tab.active{border-color:var(--win-dark) var(--win-light) var(--win-light) var(--win-dark);background:#d0d0d0;font-weight:bold;background-image:repeating-linear-gradient(45deg,transparent,transparent 2px,#c0c0c0 2px,#c0c0c0 4px);}
        .subscribe-pill{background:var(--y2k-pink);color:white;padding:4px 15px;text-decoration:none;border:2px solid #000;box-shadow:2px 2px 0 #000;flex-shrink:0;font-size:13px;}
        .system-tray{margin-left:10px;display:flex;gap:8px;align-items:center;flex-shrink:0;border:2px solid;border-color:var(--win-dark) var(--win-light) var(--win-light) var(--win-dark);padding:2px 10px;height:32px;}
        .social-link{color:#000;text-decoration:none;font-size:12px;}
        .social-link:hover{color:var(--win-blue);text-decoration:underline;}
        .lang-switch{display:flex;gap:6px;align-items:center;border-left:1px solid var(--win-dark);border-right:1px solid var(--win-light);padding:0 10px;font-size:13px;}
        .lang-link{color:var(--win-dark);text-decoration:none;}
        .lang-link.active{color:#000;font-weight:bold;text-decoration:underline;}
        .clock{font-size:13px;color:#000;}

        @media (max-width: 900px) {
            .desktop-wrapper { flex-direction: column; padding: 15px; padding-bottom: 70px; min-height: auto; }
            .desktop-icons { flex-direction: row; flex-wrap: wrap; width: 100%; justify-content: center; gap: 15px; padding-bottom: 20px; }
            .desktop-icon { width: 80px; padding: 5px; }
            .window { position: relative !important; width: 100% !important; left: 0 !important; top: 0 !important; margin-bottom: 25px; }
            .taskbar { padding: 0 6px; overflow-x: auto; white-space: nowrap; gap: 8px; justify-content: flex-start; height: 48px; }
            .taskbar::-webkit-scrollbar { display: none; }
            .taskbar-windows { display: none; }
            .subscribe-pill { margin-left: 0; }
            .system-tray { margin-left: 0; }
        }
    </style>
</head>
<body>
    <div class="marquee-bar">
        <div class="marquee-content">
            >> SYSTEM.MSG: [ <span style="color:var(--y2k-pink);">第四季早鳥活動</span> ] 進行中_ // ENDS_ON: <span style="color:var(--y2k-mint);">2026.05.17</span> // [ <span style="color:var(--y2k-pink);">全新主題策展正刊 ＋ 雜誌通信副刊</span> ] // 在邊緣捕捉與想像 ✴ &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
        </div>
    </div>

    <div class="desktop-wrapper">
        <div class="desktop-icons">
            <a href="/" class="desktop-icon"><span class="icon-emoji">🏠</span><span class="icon-text">主頁</span></a>
            <a href="/zh-tw/about" class="desktop-icon"><span class="icon-emoji">🐘</span><span class="icon-text">關於小象</span></a>
            <a href="/zh-tw/archive" class="desktop-icon"><span class="icon-emoji">📂</span><span class="icon-text">往期目錄</span></a>
            <a href="/zh-tw/guestbook" class="desktop-icon"><span class="icon-emoji">💬</span><span class="icon-text">留言板</span></a>
        </div>

        <div id="playground">
            
            <div class="window draggable" style="width: 450px; left: 20px; top: 20px; z-index: 101;">
                <div class="title-bar">
                    <div style="display: flex; align-items: center; gap: 6px;"><span>📝</span><span>Reader_01.txt</span></div>
                    <div class="win-controls"><div class="win-btn" onclick="this.closest('.window').style.display='none'">×</div></div>
                </div>
                <div class="win-content">
                    <strong style="font-size: 1.1rem;"># 關於「女孩們」</strong><br><br>
                    很喜歡<mark>「女孩們」這個欄目</mark>，對我來說像在閱讀<em>“私小說”</em>(可能不是很好的類比)，想把它們都看完💖<br><br>
                    我剛剛回到目錄，看完了第一期的電報，很巧合，我的本科專業也是廣告學。最後的<strong>“一人公司”</strong>還有你開始電報項目的初衷給了我很大的鼓舞。因為半年前去了“安穩”的甲方，有點忘記做自己的項目手感了。謝謝阿茶的電報💖
                </div>
            </div>

            <div class="window draggable" style="width: 400px; left: 520px; top: 80px; z-index: 102;">
                <div class="title-bar">
                    <div style="display: flex; align-items: center; gap: 6px;"><span>📧</span><span>Mail_from_Reader.msg</span></div>
                    <div class="win-controls"><div class="win-btn" onclick="this.closest('.window').style.display='none'">×</div></div>
                </div>
                <div class="win-content" style="background-color: #f4f0ff;">
                    hello！小象👋我正在閱讀你發的小報，真的非常有意思！希望能夠讀到更多有趣的內容。<br><br>
                    我非常同意你說的，雖然現在越來越多的加入到<mark>個人 zine 的製作</mark>，但是大多還是只是在 zine 的形式上做文章，<strong>真正的好內容還是很缺乏</strong> (我也買了很多新出的雜誌，也是這種感覺)。本人也是雜誌愛好者！我也超想自己做 zine 的~我覺得你的內容和形式給我好多感觸🤩
                </div>
            </div>

            <div class="window draggable" style="width: 480px; left: 50px; top: 320px; z-index: 103;">
                <div class="title-bar">
                    <div style="display: flex; align-items: center; gap: 6px;"><span>💡</span><span>Feedback_03.doc</span></div>
                    <div class="win-controls"><div class="win-btn" onclick="this.closest('.window').style.display='none'">×</div></div>
                </div>
                <div class="win-content">
                    我覺得你分享的內容很棒的一個原因是，<em>你分享很多工具</em>，因此也默認你的讀者可以和你一樣自主地去使用這些工具，這和我的需求很契合，當然你整理自己的思考我也很喜歡，就像有時候看完作品太興奮了就會去看大家的更多評論和分析，好像對答案一樣hhh<br><br>
                    一個作者一定是有自己對應的讀者的，<mark>作者輻射影響的範圍就在自身附近</mark>，而更下層的讀者如果有意願和行動的話也會自己找到工具來一級一級向上來。
                </div>
            </div>

            <div class="window draggable" style="width: 380px; left: 560px; top: 400px; z-index: 104;">
                <div class="title-bar">
                    <div style="display: flex; align-items: center; gap: 6px;"><span>📌</span><span>Sticky_Note.txt</span></div>
                    <div class="win-controls"><div class="win-btn" onclick="this.closest('.window').style.display='none'">×</div></div>
                </div>
                <div class="win-content" style="background: #fff9c4;">
                    在微博關注了很久，然後又在小紅書上刷到了。還想說，真好，居然遇見了<strong>兩個這麼認真的創作者</strong>，結果後面發現<mark>原來就是一個人！</mark>🐘✨
                </div>
            </div>

            <div class="window draggable" style="width: 320px; left: 300px; top: 180px; z-index: 110;">
                <div class="title-bar" style="background: linear-gradient(90deg, #FF66B3, #ff99cc);">
                    <div style="display: flex; align-items: center; gap: 6px;"><span>📮</span><span>Write_Message.exe</span></div>
                    <div class="win-controls"><div class="win-btn" onclick="this.closest('.window').style.display='none'">×</div></div>
                </div>
                <div class="win-content" style="text-align: center; padding: 40px 20px;">
                    <h3 style="color: var(--y2k-purple); margin-bottom: 15px; font-family: 'DotGothic16', sans-serif;">想留下你的足跡嗎？</h3>
                    <p style="font-size: 0.9rem; color: #555;">在這裡寫下你想對小象說的話，<br>你的留言將有機會被張貼到這片桌面上喔！</p>
                    <a href="https://tally.so/r/RGvzrl" target="_blank" class="action-btn">✍️ 點此寫信</a>
                </div>
            </div>

        </div>
    </div>

    <footer class="taskbar">
        <a href="/" class="start-btn">🐘 Start</a>
        
        <div class="taskbar-windows">
            <div class="taskbar-win-tab active"><span>📝</span> Reader_01</div>
            <div class="taskbar-win-tab active"><span>📧</span> Mail_02</div>
            <div class="taskbar-win-tab active"><span>💡</span> Feedback</div>
            <div class="taskbar-win-tab active"><span>📮</span> Write_Msg</div>
        </div>

        <a href="https://tally.so/r/4415XB" target="_blank" class="subscribe-pill">立即訂閱第四季早鳥</a>
        
        <div class="system-tray">
            <a href="https://www.instagram.com/icarusrootedbutflow/" target="_blank" class="social-link">INSTAGRAM</a>
            <a href="https://www.xiaohongshu.com/user/profile/5b7e4ac17cdd3b0001bc4c58" target="_blank" class="social-link">RED: @Apollo11-</a>
            <div class="lang-switch">
                <a href="/en/guestbook" class="lang-link">EN</a>
                <a href="/zh-tw/guestbook" class="lang-link active">繁</a>
                <a href="/zh-cn/guestbook" class="lang-link">简</a>
            </div>
            <div class="clock" id="live-clock">00:00 AM</div>
        </div>
    </footer>

    <script is:inline>
        const windows = document.querySelectorAll('.draggable');
        let zIndexCounter = 200;
        windows.forEach(win => {
            const titleBar = win.querySelector('.title-bar');
            titleBar.onmousedown = (e) => {
                if (window.innerWidth <= 900) return; 
                if (e.target.classList.contains('win-btn')) return;
                win.style.zIndex = ++zIndexCounter;
                let shiftX = e.clientX - win.getBoundingClientRect().left;
                let shiftY = e.clientY - win.getBoundingClientRect().top;
                function moveAt(pageX, pageY) { win.style.left = (pageX - shiftX - 25) + 'px'; win.style.top = (pageY - shiftY - 70 - 25) + 'px'; }
                document.onmousemove = (e) => moveAt(e.pageX, e.pageY);
                document.onmouseup = () => { document.onmousemove = null; };
            };
            win.onmousedown = () => { win.style.zIndex = ++zIndexCounter; };
        });
        function updateClock() {
            const now = new Date(); let h = now.getHours(); let m = String(now.getMinutes()).padStart(2, '0');
            let ampm = h >= 12 ? 'PM' : 'AM'; h = h % 12; h = h ? h : 12;
            document.getElementById('live-clock').innerText = `${String(h).padStart(2, '0')}:${m} ${ampm}`;
        }
        setInterval(updateClock, 1000); updateClock();
    </script>
</body>
</html>