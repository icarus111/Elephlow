---
import '../../styles/global.css';
import GuestbookPortrait from '../../components/sidebar/GuestbookPortrait.astro';
import HouseRules from '../../components/sidebar/HouseRules.astro';
---
<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>留言板 | 推開部屋的門</title>
  <meta name="description" content="推開部屋的門 - 讀者留言板與交流空間" />
</head>
<body>

  <main class="home-window">

    <header class="window-titlebar">
      <div class="titlebar-left">
        <span class="title-dots">● ● ●</span>
        <span class="titlebar-text">elephlow.cc / 留言板</span>
      </div>
      <div class="titlebar-right">
        <a href="/zh-cn/guestbook" class="lang-link">简</a>
        <a href="/zh-tw/guestbook" class="lang-link lang-active">繁</a>
        <a href="/en/guestbook" class="lang-link">EN</a>
      </div>
    </header>

    <div class="marquee-bar">
      <div class="marquee-content">
        >> SYSTEM.MSG: [ <span>第四季早鳥活動</span> ] 進行中_ // ENDS_ON: <span>2026.05.17</span> // [ <span>全新主題策展正刊 ＋ 雜誌通信副刊</span> ] // 在邊緣捕捉與想像 ✴ &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
        >> SYSTEM.MSG: [ <span>第四季早鳥活動</span> ] 進行中_ // ENDS_ON: <span>2026.05.17</span> // [ <span>全新主題策展正刊 ＋ 雜誌通信副刊</span> ] // 在邊緣捕捉與想像 ✴ &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
      </div>
    </div>

    <div class="window-content guestbook-layout">

      <aside class="guestbook-left sticky-sidebar">

        <GuestbookPortrait locale="zh-tw" />
        <HouseRules locale="zh-tw" />

        <div class="write-msg-card">
          <h3 class="card-title">📮 Say Hello</h3>
          <div class="write-msg-inner">
            <p>想留下你的足跡嗎？在這裡寫下你想對小象說的話，你的留言將有機會被張貼到這片桌面上喔！</p>
            <a href="https://tally.so/r/RGvzrl" target="_blank" class="write-btn">✍️ 點此寫信</a>
          </div>
        </div>

      </aside>

      <section class="guestbook-center">
        <div class="board-card">
          <h2 class="board-title">⌒ 留言板 ⌒</h2>
          <p class="board-subtitle">Guestbook & Letters ｡^‿^｡</p>

          <div class="board-content">

            <div class="msg-card border-mint">
              <div class="msg-header">
                <span class="msg-title">📝 關於「女孩們」</span>
                <span class="msg-date">Reader_01</span>
              </div>
              <div class="msg-body">
                很喜歡 <mark>「女孩們」這個欄目</mark>，對我來說像在閱讀<em>“私小說”</em> (可能不是很好的類比)，想把它們都看完💖<br><br>
                我剛剛回到目錄，看完了第一期的電報，很巧合，我的本科專業也是廣告學。最後的 <strong>“一人公司”</strong> 還有你開始電報項目的初衷給了我很大的鼓舞。因為半年前去了“安穩”的甲方，有點忘記做自己的項目手感了。謝謝阿茶的電報💖
              </div>
            </div>

            <div class="msg-card border-purple">
              <div class="msg-header">
                <span class="msg-title">📧 真正的好內容</span>
                <span class="msg-date">Mail_02</span>
              </div>
              <div class="msg-body bg-purple-light">
                hello！小象👋我正在閱讀你發的小報，真的非常有意思！希望能夠讀到更多有趣的內容。<br><br>
                我非常同意你說的，雖然現在越來越多的加入到 <mark>個人 zine 的製作</mark>，但是大多還是只是在 zine 的形式上做文章，<strong>真正的好內容還是很缺乏</strong> (我也買了很多新出的雜誌，也是這種感覺)。本人也是雜誌愛好者！我也超想自己做 zine 的~我覺得你的內容和形式給我好多感觸🤩
              </div>
            </div>

            <div class="msg-card border-aqua">
              <div class="msg-header">
                <span class="msg-title">💡 輻射的範圍</span>
                <span class="msg-date">Feedback_03</span>
              </div>
              <div class="msg-body">
                我覺得你分享的內容很棒的一個原因是，<em>你分享很多工具</em>，因此也默認你的讀者可以和你一樣自主地去使用這些工具，這和我的需求很契合，當然你整理自己的思考我也很喜歡，就像有時候看完作品太興奮了就會去看大家的更多評論和分析，好像對答案一樣hhh<br><br>
                一個作者一定是有自己對應的讀者的，<mark>作者輻射影響的範圍就在自身附近</mark>，而更下層的讀者如果有意願和行動的話也會自己找到工具來一級一級向上來。
              </div>
            </div>

            <div class="msg-card border-cream">
              <div class="msg-header">
                <span class="msg-title">📌 遇見</span>
                <span class="msg-date">Sticky_Note</span>
              </div>
              <div class="msg-body bg-cream-light">
                在微博關注了很久，然後又在小紅書上刷到了。還想說，真好，居然遇見了 <strong>兩個這麼認真的創作者</strong>，結果後面發現 <mark>原來就是一個人！</mark>🐘✨
              </div>
            </div>

          </div>

          <div class="board-footer">
            <p>(｡♡‿♡｡) end of messages ✿</p>
          </div>
        </div>
      </section>

      <aside class="guestbook-right sticky-sidebar">
        <div class="menu-card">
            <h3 class="menu-title">▼ MENU ▼</h3>
            <ul class="menu-list">
             <ul class="menu-list">
  <li><a href="/zh-tw/" class="menu-mint">🏠 主頁</a></li>
  <li><a href="/zh-tw/about" class="menu-pink">✍️ 創作者說</a></li>
  <li><a href="/zh-tw/archive" class="menu-aqua">📚 往期目錄</a></li>
  <li><a href="/zh-tw/guestbook" class="menu-purple">💬 留言板</a></li>
  <li><a href="https://tally.so/r/4415XB" class="menu-cream">★ 訂閱 ★</a></li>
</ul>
            </ul>
          </div>

        <div class="minihome-deco">
          <div class="deco-row">✦ ✿ ☘ ♡ ✦</div>
          <div class="deco-text">
            <p>this is a quiet</p>
            <p>little room ｡^‿^｡</p>
          </div>
        </div>

        <div class="kawaii-player">
          <div class="kp-header">
            <span class="kp-dot"></span>♫ NOW PLAYING<span class="kp-dot"></span>
          </div>
          <div class="kp-screen">
            <div class="kp-marquee">
              <span>馮穎琪 - 彳亍 ✿ 馮穎琪 - 彳亍 ✿</span>
            </div>
          </div>
          <div class="kp-controls">
            <span class="kp-btn">⏮</span>
            <span class="kp-btn kp-play">▶</span>
            <span class="kp-btn">⏭</span>
          </div>
        </div>

        <div class="kawaii-counter">
          <p class="kc-title">✿ VISITORS ✿</p>
          <div class="kc-digits">
            <span>0</span><span>0</span><span>1</span><span>4</span><span>2</span><span>6</span>
          </div>
        </div>

      </aside>

    </div>

    <footer class="window-taskbar">
      <div class="taskbar-left">
        <span class="taskbar-start">⊞ START</span>
      </div>
      <div class="taskbar-right">
        <span class="taskbar-status">(｡♡‿♡｡) currently online</span>
        <span class="taskbar-clock" id="clock">--:--</span>
      </div>
    </footer>

  </main>

  <script is:inline>
    // 監聽時間
    function updateClock() {
      const now = new Date();
      const h = String(now.getHours()).padStart(2, '0');
      const m = String(now.getMinutes()).padStart(2, '0');
      const el = document.getElementById('clock');
      if (el) el.innerText = `${h}:${m}`;
    }
    updateClock();
    setInterval(updateClock, 30000);
  </script>

  <style>
    /* === 基礎容器 === */
    .home-window {
      max-width: 1180px;
      margin: 24px auto;
      background: var(--soft-white);
      border: 3px dashed var(--candy-mint);
      border-radius: 16px;
      box-shadow: 6px 6px 0 rgba(181, 232, 224, 0.6);
      display: flex;
      flex-direction: column;
    }
    .window-titlebar {
      background: var(--candy-mint);
      padding: 8px 16px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 2px dashed var(--candy-mint);
      border-radius: 13px 13px 0 0;
      font-family: var(--font-pixel);
      font-size: 11px;
      color: var(--ink);
    }
    .titlebar-left { display: flex; align-items: center; gap: 12px; }
    .title-dots { color: var(--candy-purple); letter-spacing: 2px; }
    .titlebar-text { letter-spacing: 1px; }
    .titlebar-right { display: flex; gap: 4px; }
    .lang-link { padding: 2px 8px; color: var(--ink); text-decoration: none; border-radius: 3px; }
    .lang-link:hover { background: rgba(255, 255, 255, 0.4); }
    .lang-active { background: rgba(255, 255, 255, 0.6); font-weight: 700; }

    /* === 彩色炫動頂部跑馬燈 === */
    .marquee-bar {
      background: repeating-linear-gradient(-45deg, var(--candy-cream), var(--candy-cream) 15px, #fff 15px, #fff 30px);
      padding: 8px 0; min-height: 40px; display: flex; align-items: center; overflow: hidden; 
      border-bottom: 3px dashed var(--candy-purple); z-index: 2000; position: relative;
      box-shadow: 0 4px 0 rgba(199, 179, 232, 0.2);
      animation: candy-stripe 4s linear infinite;
    }
    @keyframes candy-stripe { 0% { background-position: 0 0; } 100% { background-position: 42px 42px; } }
    
    .marquee-content {
      display: flex; white-space: nowrap; font-family: var(--font-pixel); font-size: 13px; font-weight: bold;
      color: var(--ink-light); animation: scroll 30s linear infinite; letter-spacing: 2px;
    }
    .marquee-content span { background: var(--soft-white); padding: 0 6px; border-radius: 4px; border: 1px dashed var(--candy-pink); margin: 0 4px; }
    @keyframes scroll { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }

    .window-content { padding: 24px; }

    .guestbook-layout {
      display: grid;
      grid-template-columns: 240px 1fr 200px;
      gap: 24px;
      align-items: start;
    }

    /* === 吸頂跟隨 === */
    .sticky-sidebar {
      position: sticky;
      top: 24px;
      height: fit-content;
    }

    .card-title {
      font-family: var(--font-pixel);
      font-size: 12px;
      color: var(--ink-light);
      text-align: center;
      letter-spacing: 4px;
      margin-bottom: 12px;
      padding-bottom: 8px;
      border-bottom: 1px dashed currentColor;
    }

    /* === 左側元素 === */
    .elephant-portrait {
      background: var(--soft-white); border: 2px dashed var(--candy-pink); border-radius: 12px;
      padding: 20px 16px; text-align: center; box-shadow: 4px 4px 0 rgba(255, 182, 217, 0.35); margin-bottom: 14px;
    }
    .elephant-portrait svg { width: 120px; height: auto; }
    .elephant-caption { font-family: var(--font-pixel); font-size: 11px; color: var(--ink-light); margin-top: 8px; letter-spacing: 2px; }

    .persona-card {
      background: var(--candy-mint); border: 1.5px dashed var(--candy-purple); border-radius: 12px;
      padding: 16px; box-shadow: 3px 3px 0 rgba(181, 232, 224, 0.6); margin-bottom: 14px;
    }
    .persona-list { font-family: var(--font-serif-tc); font-size: 12px; color: var(--ink); margin: 0; }
    .persona-list dt { font-family: var(--font-pixel); font-size: 9px; color: var(--candy-purple); letter-spacing: 1px; margin-top: 8px; }
    .persona-list dt:first-child { margin-top: 0; }
    .persona-list dd { font-size: 12.5px; margin-left: 0; margin-top: 2px; line-height: 1.5; }

    /* 寫信 CTA 卡片 */
    .write-msg-card {
      background: var(--candy-pink); border: 1.5px dashed var(--candy-purple); border-radius: 12px;
      padding: 16px; box-shadow: 3px 3px 0 rgba(199, 179, 232, 0.6);
    }
    .write-msg-card .card-title { color: var(--ink); border-bottom-color: rgba(0,0,0,0.12); }
    .write-msg-inner { text-align: center; }
    .write-msg-inner p { font-family: var(--font-serif-tc); font-size: 12.5px; color: var(--ink-light); line-height: 1.7; margin-bottom: 16px; }
    .write-btn {
      display: inline-block; background: var(--candy-cream); color: var(--ink); font-family: var(--font-rounded); font-weight: 700;
      font-size: 13px; padding: 8px 16px; border-radius: 999px; text-decoration: none; border: 1.5px dashed var(--candy-peach);
      box-shadow: 2px 2px 0 rgba(0,0,0,0.1); transition: transform 0.2s;
    }
    .write-btn:hover { transform: scale(1.05); text-decoration: none; box-shadow: 3px 3px 0 rgba(0,0,0,0.15); }

    /* === 中間：留言板 === */
    .board-card {
      background: var(--soft-white); border: 2px dashed var(--candy-mint); border-radius: 12px;
      padding: 28px 32px; box-shadow: 4px 4px 0 rgba(181, 232, 224, 0.4);
    }
    .board-title {
      font-family: var(--font-serif-tc); font-size: 26px; font-weight: 700; color: var(--ink-light);
      text-align: center; margin-bottom: 4px; letter-spacing: 6px;
    }
    .board-subtitle { text-align: center; font-family: var(--font-rounded); font-size: 13px; color: var(--candy-purple); margin-bottom: 30px; }

    /* 留言手帳卡片 */
    .board-content { display: flex; flex-direction: column; gap: 20px; }
    
    .msg-card {
      background: #fff; border: 2px dashed #eee; border-radius: 12px; padding: 0;
      transition: transform 0.2s, box-shadow 0.2s; overflow: hidden;
    }
    .msg-card:hover { transform: translateY(-2px); }
    
    .border-mint { border-color: var(--candy-mint); box-shadow: 3px 3px 0 rgba(200, 233, 176, 0.3); }
    .border-purple { border-color: var(--candy-purple); box-shadow: 3px 3px 0 rgba(199, 179, 232, 0.3); }
    .border-aqua { border-color: var(--candy-aqua); box-shadow: 3px 3px 0 rgba(181, 232, 224, 0.3); }
    .border-cream { border-color: var(--candy-peach); box-shadow: 3px 3px 0 rgba(255, 233, 182, 0.3); } /* 用 peach 邊框配 cream 更好看 */

    .msg-header { 
      display: flex; justify-content: space-between; align-items: center; 
      padding: 10px 16px; border-bottom: 1.5px dashed rgba(0,0,0,0.05); background: rgba(0,0,0,0.02); 
    }
    .msg-title { font-family: var(--font-mochi); font-size: 14px; color: var(--ink); }
    .msg-date { font-family: var(--font-pixel); font-size: 11px; color: var(--ink-light); background: rgba(255,255,255,0.8); padding: 2px 8px; border-radius: 4px; border: 1px solid rgba(0,0,0,0.05); }
    
    .msg-body { 
      font-family: var(--font-serif-tc); font-size: 14.5px; line-height: 1.8; color: var(--ink); 
      padding: 20px 24px; text-align: justify;
    }
    .bg-purple-light { background-color: rgba(199, 179, 232, 0.1); }
    .bg-cream-light { background-color: rgba(255, 233, 182, 0.15); }

    /* 文本糖果化格式 (取代原本 Y2K 的 mark/strong/em) */
    .msg-body mark { background-color: transparent; background-image: linear-gradient(transparent 60%, var(--candy-mint) 60%); color: var(--ink); padding: 0 2px; font-weight: 700; }
    .msg-body strong { color: var(--ink); background-image: linear-gradient(transparent 60%, var(--candy-pink) 60%); }
    .msg-body em { color: var(--candy-purple); font-style: normal; font-weight: 700; border-bottom: 2px dashed var(--candy-purple); }

    .board-footer { text-align: center; margin-top: 30px; padding-top: 16px; border-top: 1px dashed var(--candy-mint); font-family: var(--font-pixel); font-size: 11px; color: var(--ink-light); letter-spacing: 2px; }

    /* === 右側 Tabs === */
/* === 彩色长方形导航菜单 === */
    .menu-card {
      background: var(--soft-white);
      border: 1.5px dashed var(--candy-mint);
      border-radius: 12px;
      padding: 8px;
      box-shadow: 3px 3px 0 rgba(181, 232, 224, 0.4);
      margin-bottom: 12px;
    }

    .menu-title {
      font-family: var(--font-pixel);
      font-size: 12px;
      text-align: center;
      padding: 8px 4px;
      margin: 0 0 6px;
      color: var(--ink-light);
      background: var(--candy-cream);
      border-radius: 6px;
    }

    .menu-list { list-style: none; padding: 0; margin: 0; }
    .menu-list li { margin-bottom: 4px; }

    .menu-list a {
      display: block;
      padding: 10px 12px;
      text-align: center;
      font-family: var(--font-rounded);
      font-weight: 700;
      font-size: 13px;
      color: var(--ink);
      text-decoration: none;
      border-radius: 8px;
      border: 1.5px dashed var(--candy-purple);
      transition: transform 0.15s;
      text-shadow: -1px -1px 0 var(--soft-white), 1px -1px 0 var(--soft-white), -1px 1px 0 var(--soft-white), 1px 1px 0 var(--soft-white);
    }

    .menu-list a:hover {
      transform: translate(-2px, -2px);
      box-shadow: 2px 2px 0 rgba(199, 179, 232, 0.4);
      text-decoration: none;
    }

    .menu-mint { background: var(--candy-mint); }
    .menu-aqua { background: var(--candy-aqua); }
    .menu-pink { background: var(--candy-pink); }
    .menu-purple { background: var(--candy-purple);}
    .menu-mint { background: var(--candy-mint); }
    .menu-aqua { background: var(--candy-aqua); }
    .menu-pink { background: var(--candy-pink); }
    .menu-purple { background: var(--candy-purple); }
    .menu-cream { background: var(--candy-cream); } 

    .minihome-deco {
      background: var(--candy-cream); border: 1.5px dashed var(--candy-peach); border-radius: 12px;
      padding: 16px 12px; text-align: center; box-shadow: 3px 3px 0 rgba(255, 200, 200, 0.3); margin-bottom: 16px;
    }
    .deco-row { font-size: 14px; color: var(--candy-purple); letter-spacing: 4px; margin-bottom: 10px; }
    .deco-text p { font-family: var(--font-pixel); font-size: 10px; color: var(--ink-light); margin: 2px 0; }

    /* === 迷你播放器 === */
    .kawaii-player {
      background: var(--candy-mint); border: 2px dashed var(--candy-purple); border-radius: 12px;
      padding: 12px; box-shadow: 3px 3px 0 rgba(181, 232, 224, 0.8); margin-bottom: 16px;
    }
    .kp-header { display: flex; justify-content: center; align-items: center; gap: 6px; font-family: var(--font-pixel); font-size: 10px; color: var(--ink-light); margin-bottom: 8px; letter-spacing: 1px; }
    .kp-dot { width: 4px; height: 4px; background: var(--candy-pink); border-radius: 50%; }
    .kp-screen { background: var(--soft-white); border: 1.5px solid var(--candy-purple); border-radius: 6px; padding: 6px; overflow: hidden; margin-bottom: 10px; }
    .kp-marquee { font-family: var(--font-serif-tc); font-size: 12px; color: var(--candy-purple); font-weight: bold; white-space: nowrap; animation: marquee-scroll 6s linear infinite; }
    @keyframes marquee-scroll { 0% { transform: translateX(100%); } 100% { transform: translateX(-100%); } }
    .kp-controls { display: flex; justify-content: center; gap: 12px; }
    .kp-btn { display: inline-flex; justify-content: center; align-items: center; width: 24px; height: 24px; background: var(--soft-white); border: 1.5px dashed var(--candy-purple); border-radius: 50%; font-size: 10px; color: var(--candy-purple); cursor: pointer; }
    .kp-btn:hover { background: var(--candy-cream); }
    .kp-play { background: var(--candy-pink); color: white; border-color: transparent; }

    /* === 訪客計數器 === */
    .kawaii-counter {
      background: var(--candy-cream); border: 2px dashed var(--candy-peach); border-radius: 12px;
      padding: 12px; text-align: center; box-shadow: 3px 3px 0 rgba(255, 200, 200, 0.4);
    }
    .kc-title { font-family: var(--font-pixel); font-size: 10px; color: var(--ink-light); margin: 0 0 8px 0; letter-spacing: 2px; }
    .kc-digits { display: flex; justify-content: center; gap: 3px; }
    .kc-digits span { background: var(--soft-white); color: var(--candy-pink); font-family: var(--font-pixel); font-size: 16px; padding: 4px 6px; border: 1.5px solid var(--candy-pink); border-radius: 4px; font-weight: bold; }

    /* === 底部狀態欄 === */
    .window-taskbar {
      background: var(--candy-mint); padding: 8px 16px; display: flex; justify-content: space-between; align-items: center;
      border-top: 2px dashed var(--candy-mint); border-radius: 0 0 13px 13px; font-family: var(--font-pixel); font-size: 11px; color: var(--ink);
    }
    .taskbar-left { display: flex; gap: 12px; align-items: center; }
    .taskbar-right { display: flex; gap: 12px; align-items: center; }
    .taskbar-start { background: rgba(255, 255, 255, 0.5); padding: 2px 8px; border-radius: 3px; border: 1px dashed var(--candy-purple); }
    .taskbar-status, .taskbar-clock { color: var(--ink); font-weight: 700; }

    @media (max-width: 900px) {
      .guestbook-layout { grid-template-columns: 1fr; }
