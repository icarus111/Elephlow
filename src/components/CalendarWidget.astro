<div class="calendar-widget" data-calendar-widget>
  <div class="cal-header">
    <span>📅</span>
    <span data-calendar-month></span>
  </div>

  <div class="cal-weekdays">
    <span>日</span><span>一</span><span>二</span>
    <span>三</span><span>四</span><span>五</span><span>六</span>
  </div>

  <div class="cal-grid" data-calendar-grid></div>

  <div class="cal-legend">
    <div class="legend-row">
      <span class="legend-dot legend-letter"></span>
      <span>杂志通信</span>
    </div>
    <div class="legend-row">
      <span class="legend-dot legend-issue"></span>
      <span>正刊</span>
    </div>
  </div>
</div>

<script>
  import { getScheduleForMonth } from '../data/publishing-schedule';

  const formatDate = (year: number, month: number, day: number) =>
    `${year}-${String(month + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;

  document.querySelectorAll<HTMLElement>('[data-calendar-widget]').forEach(widget => {
    const today = new Date();
    const currentMonth = today.getMonth();
    const currentYear = today.getFullYear();
    const firstDay = new Date(currentYear, currentMonth, 1).getDay();
    const daysInMonth = new Date(currentYear, currentMonth + 1, 0).getDate();
    const schedule = getScheduleForMonth(currentYear, currentMonth);
    const monthLabel = widget.querySelector<HTMLElement>('[data-calendar-month]');
    const grid = widget.querySelector<HTMLElement>('[data-calendar-grid]');

    if (!monthLabel || !grid) return;

    monthLabel.textContent = `${currentYear} 年 ${currentMonth + 1} 月`;

    for (let i = 0; i < firstDay; i++) {
      const emptyCell = document.createElement('div');
      emptyCell.className = 'cal-empty';
      grid.append(emptyCell);
    }

    for (let day = 1; day <= daysInMonth; day++) {
      const events = schedule.filter(event => event.date === formatDate(currentYear, currentMonth, day));
      const hasLetter = events.some(event => event.type === 'letter');
      const hasIssue = events.some(event => event.type === 'issue');
      const cell = document.createElement('div');
      const dayLabel = document.createElement('span');
      const classes = ['cal-cell'];

      if (day === today.getDate()) classes.push('cal-today');
      if (hasLetter) classes.push('cal-letter');
      if (hasIssue) classes.push('cal-issue');

      cell.className = classes.join(' ');
      cell.title = events.map(event => event.title).join(' · ');
      dayLabel.className = 'cal-day';
      dayLabel.textContent = String(day);
      cell.append(dayLabel);
      grid.append(cell);
    }
  });
</script>

<style>
  .calendar-widget {
    background: var(--soft-white);
    border: 2px solid var(--candy-mint);
    border-radius: var(--radius-soft);
    padding: 14px;
    box-shadow: 3px 3px 0 var(--candy-aqua);
  }

  .cal-header {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding-bottom: 10px;
    border-bottom: 1px dashed var(--candy-mint);
    margin-bottom: 8px;
    font-family: var(--font-mochi);
    font-size: 13px;
    color: var(--ink-light);
  }

  .cal-weekdays {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 2px;
    font-family: var(--font-pixel);
    font-size: 9px;
    color: var(--ink-light);
    text-align: center;
    margin-bottom: 4px;
  }

  .cal-grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 2px;
  }

  .cal-empty {
    aspect-ratio: 1;
  }

  .cal-cell {
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-pixel);
    font-size: 10px;
    color: var(--ink);
    border-radius: 3px;
    background: var(--cream-paper);
    cursor: default;
  }

  .cal-today {
    border: 1.5px solid var(--ink-light);
    font-weight: 700;
  }

  .cal-letter {
    background: var(--candy-mint);
  }

  .cal-issue {
    background: var(--candy-purple);
  }

  .cal-letter.cal-issue {
    background: linear-gradient(135deg, var(--candy-mint) 50%, var(--candy-purple) 50%);
  }

  .cal-legend {
    padding-top: 8px;
    margin-top: 8px;
    border-top: 1px dashed var(--candy-mint);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .legend-row {
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-pixel);
    font-size: 10px;
    color: var(--ink-light);
  }

  .legend-dot {
    width: 10px;
    height: 10px;
    border-radius: 2px;
    flex-shrink: 0;
  }

  .legend-letter {
    background: var(--candy-mint);
  }

  .legend-issue {
    background: var(--candy-purple);
  }
</style>
