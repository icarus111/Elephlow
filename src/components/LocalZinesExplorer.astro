                  return (
                    <g class:list={['county-label', ['澎湖縣', '金門縣', '連江縣'].includes(county) && 'is-offshore', county === initialCounty && 'is-current']} data-county-label={county} data-county-select={county} role="button" tabindex="0" aria-label={`${copy.selectCounty}${county}`} aria-pressed={county === initialCounty ? 'true' : 'false'}>
                      <rect x={label.x - 7} y={label.y - 12} width={25 + label.short.length * 15} height="25" rx="8"></rect>
                      <circle cx={label.x} cy={label.y} r="3.5"></circle>
                      <text x={label.x + 7} y={label.y + 3}>{label.short}</text>
                    </g>
                  );
                })}
              </svg>
              <div class="island-insets" aria-label={copy.islandZoom}>
                <span class="island-insets-label">ISLAND ZOOM ♡</span>
                {islandInsets.map((island) => (
                  <button
                    class:list={['island-inset', island.county === initialCounty && 'is-current']}
                    type="button"
                    data-county-select={island.county}
                    aria-label={copy.viewCounty + island.label + copy.viewSuffix}
                    aria-pressed={island.county === initialCounty ? 'true' : 'false'}
                  >
                    <span><b>{island.label}</b><small>{payload.filter((item) => item.county === island.county).length}{copy.unit}</small></span>
                    <svg viewBox={island.viewBox} aria-hidden="true"><path d={taiwanCountyPaths[island.county]}></path></svg>
                    <i aria-hidden="true">{island.charm}</i>
                  </button>
                ))}
              </div>
              <span class="map-decoration map-star">✦</span><span class="map-decoration map-heart">♡</span><span class="map-decoration map-note">22 COUNTY FILES</span>
            </div>
            <footer class="map-source">{copy.boundary}<a href="https://data.gov.tw/dataset/7442" target="_blank" rel="noreferrer">{copy.dataPlatform}</a> · {copy.checked} {lastVerified}</footer>
          </section>

          <aside class="library-pane">
            <section class="directory-window" aria-labelledby="directory-title">
              <header class="pane-titlebar"><span>▤ publication_index.txt</span><i>— □</i></header>
              <div class="directory-tools">
                <div><p>{copy.shelf}</p><h2 id="directory-title">{initialCounty} · {initialPublications.length}{copy.unit}</h2></div>
                <label class="directory-search"><span>⌕</span><input id="zine-search" type="search" placeholder={copy.search} autocomplete="off" /></label>
              </div>
              <div class="directory-list" id="directory-list">
                {initialPublications.map((item) => (
                  <button class:list={['directory-item', `is-${item.reading}`, item.id === initialItem.id && 'is-current']} type="button" data-record-id={item.id}>
                    <span>{item.displayName}</span><small>{item.reading === 'online' ? copy.online : copy.reference}</small>
                  </button>
                ))}
              </div>
            </section>

            <article class="record-card" id="record-card" data-reading={initialItem.reading} aria-live="polite">
              <header class="record-heading">
                <div class="record-eyebrow"><span>{initialItem.city}</span><span>{initialItem.statusLabel}</span>{initialItem.period && <span>{initialItem.period}</span>}</div>
                <h2>{initialItem.displayName}</h2>
                <p>{copy.publisher}：{initialItem.publisher}</p>
                {initialItem.firstPublished && <p class="record-first-published"><b>{copy.firstPublished}</b><span>{initialItem.firstPublished}</span></p>}
              </header>
              <div class="record-scroll">
                <section class="record-about"><h3>{copy.about}</h3><p>{initialItem.description}</p>{initialItem.note && <small class="record-note">{initialItem.note}</small>}</section>
                {initialItem.platforms.length > 0 && <section class="record-links record-platforms"><h3>{copy.platformReading}</h3><div class="record-link-grid">{initialItem.platforms.map((link) => (
                  <a href={link.url} target="_blank" rel="noreferrer"><span><strong>{link.label}</strong><small>{link.detail || (link.access === 'borrow' ? copy.borrowOnline : copy.buyPreview)}</small></span><b>{link.access === 'borrow' ? copy.borrowOnline : copy.buyPreview} ↗</b></a>
                ))}</div></section>}
                {initialItem.socials.length > 0 && <section class="record-links record-socials"><h3>{copy.teamLinks}</h3><div class="record-link-grid">{initialItem.socials.map((link) => (
                  <a href={link.url} target="_blank" rel="noreferrer"><span><strong>{link.label}</strong><small>{copy.visitSocial}</small></span><b>{copy.visitSocial} ↗</b></a>
                ))}</div></section>}
                {initialItem.issues.length > 0 && <section class="record-issues"><h3>{initialItem.publicReading || initialItem.platforms.length ? copy.recommended : copy.introIssues}</h3>{initialItem.issues.map((issue, index) => (
                  <a href={issue.url} target="_blank" rel="noreferrer"><b>{String(index + 1).padStart(2, '0')}</b><span><small>{issue.label}</small><strong>{issue.title}</strong><em>{issue.reason}</em></span><i>↗</i></a>
                ))}</section>}
                {initialItem.coverage.length > 0 && <section class="record-coverage"><h3>{copy.reports}</h3>{initialItem.coverage.map((report) => (
                  <a href={report.url} target="_blank" rel="noreferrer"><span><small>{report.outlet}{report.date ? ` · ${report.date}` : ''}</small><strong>{report.title}</strong><em>{report.summary}</em></span><i>↗</i></a>
                ))}</section>}
              </div>
              <footer class="record-footer"><span>{initialItem.publicReading ? copy.hasOnline : initialItem.platforms.length ? copy.platformOnline : !initialItem.hasLink ? copy.paperSource : initialItem.hasDirectIntro ? copy.hasIntro : copy.noIntro}</span>{initialItem.hasLink && <a href={initialItem.url} target="_blank" rel="noreferrer">{initialItem.publicReading ? copy.readOfficial : initialItem.hasDirectIntro ? copy.viewIntro : copy.viewSource} ↗</a>}</footer>
            </article>
          </aside>
        </section>

        <section class="research-window" aria-labelledby="research-title">
          <header class="pane-titlebar"><span>▤ local_publication_studies.lib</span><i>— □</i></header>
          <div class="research-heading">
            <div><p>READING THE PUBLISHING LANDSCAPE_</p><h2 id="research-title">{copy.researchTitle}</h2></div>
            <span>{researchReading.length} ARTICLES · 2019—2024</span>
          </div>
          <div class="research-layout">
            <a class="research-feature" href={featuredResearch.url} target="_blank" rel="noreferrer">
              <div class="research-feature-top"><span>{featuredResearch.year}</span><small>FEATURED ESSAY ✦</small></div>
              <small>{featuredResearch.outlet}</small>
              <h3>《{featuredResearch.title}》</h3>
              <p>{featuredResearch.summary}</p>
              <div class="research-tags">{featuredResearch.tags.map((tag) => <span>{tag}</span>)}</div>
              <footer><span>{copy.researchLead}</span><b>{copy.readFull} ↗</b></footer>
            </a>
            <div class="research-index">
              {researchIndex.map((article, index) => (
                <a class:list={['research-index-card', `research-card-${index + 1}`]} href={article.url} target="_blank" rel="noreferrer">
                  <span class="research-card-visual" aria-hidden="true">
                    <strong>{article.year}</strong><small>{researchVisualLabels[index]}</small><i></i><i></i><i></i>
                  </span>
                  <div class="research-card-copy">
                    <small class="research-outlet">{article.outlet}</small>
                    <h3>《{article.title}》</h3>
                    <p>{article.summary}</p>
                    <span class="research-card-link">{copy.readOriginal}</span>
                  </div>
                  <b class="research-card-arrow" aria-hidden="true">↗</b>
                </a>
              ))}
            </div>
          </div>
        </section>

        <aside class="support-pocket" aria-labelledby="support-pocket-title">
          <header class="support-titlebar"><span id="support-pocket-title">{copy.supportTitle}</span><i aria-hidden="true">PAY_♡</i></header>
          <div class="support-pocket-body">
            <div class="support-intro">
              <p>{copy.supportIntro}</p>
              <small>{copy.supportPromise}</small>
            </div>
            <section class="support-method support-paypal">
              <div class="support-method-heading">
                <small>01</small>
                <h3>PayPal</h3>
                <span>{copy.paypalRegion}</span>
              </div>
              <a class="support-action" href={paypalSupportUrl} target="_blank" rel="noopener noreferrer">{copy.paypalAction}</a>
            </section>
            <section class="support-method support-wechat">
              <div class="support-method-heading">
                <small>02</small>
                <h3>{copy.wechatTitle}</h3>
                <span>{copy.wechatRegion}</span>
              </div>
              <button class="support-action" id="open-wechat-support" type="button">{copy.wechatAction}</button>
            </section>
          </div>
        </aside>

      </div>

      <footer class="window-taskbar"><div><a href={paths.home}>{copy.taskHome}</a><a class="task-credit" href={paths.about}>{copy.projectByline}</a><span>{copy.taskTitle}</span></div><div><span id="selection-status">{initialCounty} · {initialItem.displayName}</span><span id="clock">--:--</span></div></footer>
    </main>

    <aside class="suggest-float" id="suggest-float" aria-label={copy.suggestAria}>
      <header class="float-titlebar" id="suggest-drag-handle"><span>✉ zine_dropbox.msg</span><i>↕</i></header>
      <a class="float-body" href={suggestionFormUrl} target="_blank" rel="noreferrer">
        <span class="float-sticker" aria-hidden="true">NEW!</span>
        <span class="float-mail" aria-hidden="true">✉</span>
        <strong>{copy.missed}</strong>
        <small>{copy.submitHint}<br />{copy.dragHint}</small>
        <span class="float-ticker"><i>{copy.ticker}</i></span>
      </a>
    </aside>

    <dialog class="suggest-dialog" id="suggest-dialog">
      <form method="dialog" class="dialog-window" id="suggest-form">
        <header class="pane-titlebar"><span>✉ add_a_zine.msg</span><button type="button" id="close-suggestion" aria-label={copy.close}>×</button></header>
        <div class="dialog-body"><p>COMMUNITY DROPBOX_</p><h2>{copy.dialogTitle}</h2><small>{copy.dialogNote}</small>
          <div class="dialog-fields"><label><span>{copy.publicationName}</span><input name="publication" required /></label><label><span>{copy.place}</span><input name="place" required /></label><label class="wide"><span>{copy.link}</span><input name="url" type="url" required placeholder="https://" /></label><label class="wide"><span>{copy.notes}</span><textarea name="note" rows="3"></textarea></label></div>
        </div>
        <footer class="dialog-actions"><button type="button" id="cancel-suggestion">{copy.cancel}</button><button type="submit" value="default">{copy.compose}</button></footer>
      </form>
    </dialog>

    <dialog class="support-qr-dialog" id="wechat-support-dialog" aria-labelledby="wechat-support-title">
      <div class="support-qr-window">
        <header class="support-qr-titlebar"><span id="wechat-support-title">♡ {copy.wechatDialogTitle}</span><button type="button" id="close-wechat-support" aria-label={copy.close}>×</button></header>
        <div class="support-qr-body">
          <p>WECHAT APPRECIATION CODE_</p>
          <img src={wechatSupportImage} alt={copy.wechatDialogTitle} width="1080" height="1080" />
          <small>{copy.wechatDialogHint}</small>
        </div>
      </div>
    </dialog>

    <script id="zine-data" type="application/json" set:html={serializedPayload}></script>
    <script id="zine-ui" type="application/json" set:html={serializedUi}></script>
    <script is:inline>
      const records = JSON.parse(document.querySelector('#zine-data')?.textContent || '[]');
      const ui = JSON.parse(document.querySelector('#zine-ui')?.textContent || '{}');
      const counties = [...new Set(records.map((record) => record.county))];
      const directory = document.querySelector('#directory-list');
      const directoryTitle = document.querySelector('#directory-title');
      const recordCard = document.querySelector('#record-card');
      const selectedCountyLabel = document.querySelector('#selected-county');
      const selectionStatus = document.querySelector('#selection-status');
      const search = document.querySelector('#zine-search');
      const countyJump = document.querySelector('#county-jump');
      const readingFilterButtons = [...document.querySelectorAll('[data-reading-filter]')];
      let selectedCounty = counties.includes(decodeURIComponent(location.hash.slice(1))) ? decodeURIComponent(location.hash.slice(1)) : '臺北市';
      let selectedRecordId = '';
      let activeReadingFilter = '';

      const escapeHtml = (value = '') => String(value).replace(/[&<>"]/g, (character) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[character]);
      const countyRecords = (county) => records.filter((record) => record.county === county).sort((a, b) => (a.reading === b.reading ? 0 : a.reading === 'online' ? -1 : 1));
      const filteredRecords = (items) => activeReadingFilter ? items.filter((record) => record.reading === activeReadingFilter) : items;

      function updateReadingFilters() {
        readingFilterButtons.forEach((button) => {
          const current = button.dataset.readingFilter === activeReadingFilter;
          button.classList.toggle('is-active', current);
          button.setAttribute('aria-pressed', String(current));
        });
      }

      function updateMap() {
        document.querySelectorAll('[data-county-select]').forEach((zone) => {
          const current = zone.dataset.countySelect === selectedCounty;
          zone.classList.toggle('is-current', current);
          zone.setAttribute('aria-pressed', String(current));
        });
        document.querySelectorAll('[data-county-label]').forEach((label) => label.classList.toggle('is-current', label.dataset.countyLabel === selectedCounty));
        if (selectedCountyLabel) selectedCountyLabel.textContent = selectedCounty;
        if (countyJump) countyJump.value = selectedCounty;
      }

      function renderDirectory(items, heading) {
        if (!directory || !directoryTitle) return;
        const visibleItems = filteredRecords(items);
        const filterLabel = activeReadingFilter === 'online' ? ` · ${ui.online}` : activeReadingFilter === 'reference' ? ` · ${ui.reference}` : '';
        directoryTitle.textContent = `${heading}${filterLabel} · ${visibleItems.length}${ui.unit}`;
        directory.innerHTML = visibleItems.length ? visibleItems.map((record) => `<button class="directory-item is-${record.reading}${record.id === selectedRecordId ? ' is-current' : ''}" type="button" data-record-id="${record.id}"><span>${escapeHtml(record.displayName)}</span><small>${record.reading === 'online' ? escapeHtml(ui.online) : escapeHtml(ui.reference)}</small></button>`).join('') : `<p class="directory-empty">${escapeHtml(ui.noMatch)}</p>`;
      }

      function renderRecord(record) {
        if (!recordCard) return;
        if (!record) {
          const filterLabel = activeReadingFilter === 'online' ? ui.readable : ui.referenceLong;
          recordCard.dataset.reading = activeReadingFilter || 'reference';
          recordCard.innerHTML = `<div class="record-empty-filter"><small>NO MATCH_</small><h2>${escapeHtml(selectedCounty)} · ${escapeHtml(ui.nonePrefix)}${escapeHtml(filterLabel)}${escapeHtml(ui.noneSuffix)}</h2><p>${escapeHtml(ui.switchHint)}</p><button id="clear-reading-filter" type="button">${escapeHtml(ui.showAll)}</button></div>`;
          document.querySelector('#clear-reading-filter')?.addEventListener('click', () => { activeReadingFilter = ''; updateReadingFilters(); selectCounty(selectedCounty); });
          if (selectionStatus) selectionStatus.textContent = `${selectedCounty} · ${ui.noResults}`;
          return;
        }
        selectedRecordId = record.id;
        recordCard.dataset.reading = record.reading;
        const platforms = record.platforms.length ? `<section class="record-links record-platforms"><h3>${escapeHtml(ui.platformReading)}</h3><div class="record-link-grid">${record.platforms.map((link) => `<a href="${link.url}" target="_blank" rel="noreferrer"><span><strong>${escapeHtml(link.label)}</strong><small>${escapeHtml(link.detail || (link.access === 'borrow' ? ui.borrowOnline : ui.buyPreview))}</small></span><b>${escapeHtml(link.access === 'borrow' ? ui.borrowOnline : ui.buyPreview)} ↗</b></a>`).join('')}</div></section>` : '';
        const socials = record.socials.length ? `<section class="record-links record-socials"><h3>${escapeHtml(ui.teamLinks)}</h3><div class="record-link-grid">${record.socials.map((link) => `<a href="${link.url}" target="_blank" rel="noreferrer"><span><strong>${escapeHtml(link.label)}</strong><small>${escapeHtml(ui.visitSocial)}</small></span><b>${escapeHtml(ui.visitSocial)} ↗</b></a>`).join('')}</div></section>` : '';
        const issues = record.issues.length ? `<section class="record-issues"><h3>${record.publicReading || record.platforms.length ? escapeHtml(ui.recommended) : escapeHtml(ui.introIssues)}</h3>${record.issues.map((issue, index) => `<a href="${issue.url}" target="_blank" rel="noreferrer"><b>${String(index + 1).padStart(2, '0')}</b><span><small>${escapeHtml(issue.label)}</small><strong>${escapeHtml(issue.title)}</strong><em>${escapeHtml(issue.reason)}</em></span><i>↗</i></a>`).join('')}</section>` : '';
        const coverage = record.coverage.length ? `<section class="record-coverage"><h3>${escapeHtml(ui.reports)}</h3>${record.coverage.map((report) => `<a href="${report.url}" target="_blank" rel="noreferrer"><span><small>${escapeHtml(report.outlet)}${report.date ? ` · ${escapeHtml(report.date)}` : ''}</small><strong>${escapeHtml(report.title)}</strong><em>${escapeHtml(report.summary)}</em></span><i>↗</i></a>`).join('')}</section>` : '';
        const sourceStatus = record.publicReading ? ui.hasOnline : record.platforms.length ? ui.platformOnline : !record.hasLink ? ui.paperSource : record.hasDirectIntro ? ui.hasIntro : ui.noIntro;
        const sourceAction = record.hasLink ? `<a href="${record.url}" target="_blank" rel="noreferrer">${record.publicReading ? escapeHtml(ui.readOfficial) : record.hasDirectIntro ? escapeHtml(ui.viewIntro) : escapeHtml(ui.viewSource)} ↗</a>` : '';
        const period = record.period ? `<span>${escapeHtml(record.period)}</span>` : '';
        const note = record.note ? `<small class="record-note">${escapeHtml(record.note)}</small>` : '';
        const firstPublished = record.firstPublished ? `<p class="record-first-published"><b>${escapeHtml(ui.firstPublished)}</b><span>${escapeHtml(record.firstPublished)}</span></p>` : '';
        recordCard.innerHTML = `<header class="record-heading"><div class="record-eyebrow"><span>${escapeHtml(record.city)}</span><span>${escapeHtml(record.statusLabel)}</span>${period}</div><h2>${escapeHtml(record.displayName)}</h2><p>${escapeHtml(ui.publisher)}：${escapeHtml(record.publisher)}</p>${firstPublished}</header><div class="record-scroll"><section class="record-about"><h3>${escapeHtml(ui.about)}</h3><p>${escapeHtml(record.description)}</p>${note}</section>${platforms}${socials}${issues}${coverage}</div><footer class="record-footer"><span>${escapeHtml(sourceStatus)}</span>${sourceAction}</footer>`;
        if (selectionStatus) selectionStatus.textContent = `${record.county} · ${record.displayName}`;
      }

      function selectCounty(county, preferredRecordId = '') {
        if (!counties.includes(county)) return;
        selectedCounty = county;
        const items = countyRecords(county);
        const visibleItems = filteredRecords(items);
        const selected = visibleItems.find((item) => item.id === preferredRecordId) || visibleItems[0];
        selectedRecordId = selected?.id || '';
        updateMap(); renderDirectory(items, county); renderRecord(selected);
        history.replaceState(null, '', `#${encodeURIComponent(county)}`);
      }

      document.querySelectorAll('[data-county-select]').forEach((zone) => {
        const choose = () => { if (search) search.value = ''; selectCounty(zone.dataset.countySelect); };
        zone.addEventListener('click', choose);
        zone.addEventListener('keydown', (event) => { if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); choose(); } });
      });
      countyJump?.addEventListener('change', () => { if (search) search.value = ''; selectCounty(countyJump.value); });
      readingFilterButtons.forEach((button) => button.addEventListener('click', () => {
        activeReadingFilter = activeReadingFilter === button.dataset.readingFilter ? '' : button.dataset.readingFilter;
        updateReadingFilters();
        selectCounty(selectedCounty, selectedRecordId);
      }));
      directory?.addEventListener('click', (event) => {
        const button = event.target.closest('[data-record-id]'); if (!button) return;
        const record = records.find((item) => item.id === button.dataset.recordId); if (!record) return;
        if (record.county !== selectedCounty || search?.value) { if (search) search.value = ''; selectCounty(record.county, record.id); return; }
        selectedRecordId = record.id; renderDirectory(countyRecords(selectedCounty), selectedCounty); renderRecord(record);
      });
      search?.addEventListener('input', () => {
        const query = search.value.toLocaleLowerCase('zh-Hant').trim();
        if (!query) { renderDirectory(countyRecords(selectedCounty), selectedCounty); return; }
        const matches = records.filter((record) => `${record.name} ${record.city} ${record.publisher} ${record.description}`.toLocaleLowerCase('zh-Hant').includes(query));
        renderDirectory(matches, ui.searchResults);
      });

      const dialog = document.querySelector('#suggest-dialog');
      document.querySelector('#open-suggestion')?.addEventListener('click', () => dialog?.showModal());
      document.querySelector('#close-suggestion')?.addEventListener('click', () => dialog?.close());
      document.querySelector('#cancel-suggestion')?.addEventListener('click', () => dialog?.close());
      const floatWindow = document.querySelector('#suggest-float');
      const dragHandle = document.querySelector('#suggest-drag-handle');
      let floatDragOffset = 0;
      let draggingFloat = false;

      function positionFloat(clientY) {
        if (!floatWindow) return;
        const edge = window.innerWidth <= 640 ? 42 : 48;
        const maxTop = Math.max(edge, window.innerHeight - floatWindow.offsetHeight - edge);
        const top = Math.min(maxTop, Math.max(edge, clientY - floatDragOffset));
        floatWindow.style.top = top + 'px';
      }

      dragHandle?.addEventListener('pointerdown', (event) => {
        if (!floatWindow) return;
        draggingFloat = true;
        floatWindow.classList.add('is-dragging');
        floatDragOffset = event.clientY - floatWindow.getBoundingClientRect().top;
        dragHandle.setPointerCapture(event.pointerId);
      });
      dragHandle?.addEventListener('pointermove', (event) => {
        if (draggingFloat) positionFloat(event.clientY);
      });
      const stopFloatDrag = (event) => {
        draggingFloat = false;
        floatWindow?.classList.remove('is-dragging');
        if (dragHandle?.hasPointerCapture(event.pointerId)) dragHandle.releasePointerCapture(event.pointerId);
      };
      dragHandle?.addEventListener('pointerup', stopFloatDrag);
      dragHandle?.addEventListener('pointercancel', stopFloatDrag);
      window.addEventListener('resize', () => {
        if (!floatWindow) return;
        const rect = floatWindow.getBoundingClientRect();
        floatDragOffset = rect.height / 2;
        positionFloat(rect.top + floatDragOffset);
      });
      document.querySelector('#suggest-form')?.addEventListener('submit', (event) => {
        event.preventDefault(); const data = new FormData(event.currentTarget);
        const subject = `${ui.mailSubject}｜${data.get('publication') || ''}`;
        const body = `${ui.mailPublication}：${data.get('publication') || ''}\n${ui.mailPlace}：${data.get('place') || ''}\n${ui.mailLink}：${data.get('url') || ''}\n${ui.mailNote}：${data.get('note') || ui.mailNone}\n\n${ui.mailFrom}`;
        location.href = `mailto:iiicarus1217@gmail.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      });
      dialog?.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
      const wechatDialog = document.querySelector('#wechat-support-dialog');
      document.querySelector('#open-wechat-support')?.addEventListener('click', () => wechatDialog?.showModal());
      document.querySelector('#close-wechat-support')?.addEventListener('click', () => wechatDialog?.close());
      wechatDialog?.addEventListener('click', (event) => { if (event.target === wechatDialog) wechatDialog.close(); });

      function updateClock() { const clock = document.querySelector('#clock'); const now = new Date(); if (clock) clock.textContent = `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`; }
      updateReadingFilters(); selectCounty(selectedCounty); updateClock(); setInterval(updateClock, 30000);
    </script>
  </body>
</html>

<style is:global>
  html { scroll-behavior: smooth; }
  body { overflow-x: hidden; }
  button, input, textarea { font: inherit; }
  .zine-window {
    position: relative; width: calc(100% - 120px); max-width: 1180px; margin: 18px auto;
    overflow: visible; border: 2px dashed var(--candy-purple); border-radius: 15px;
    background: var(--soft-white); box-shadow: 6px 6px 0 rgba(199,179,232,.34); transform: translateX(-28px);
  }
  .window-titlebar, .window-taskbar, .pane-titlebar { color: var(--ink); font: 9px var(--font-pixel); }
  .window-titlebar {
    display: flex; align-items: center; justify-content: space-between; gap: 16px;
    padding: 8px 14px; border-bottom: 2px dashed var(--candy-purple); background: var(--candy-mint);
  }
  .window-titlebar > div, .window-titlebar nav, .window-taskbar > div { display: flex; align-items: center; gap: 11px; }
  .window-titlebar nav a, .window-taskbar a { color: var(--ink); }
