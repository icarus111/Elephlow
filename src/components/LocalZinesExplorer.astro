---
import '../styles/global.css';
import {
  accessLabels,
  lastVerified,
  localPublications,
  statusLabels,
} from '../data/taiwan-local-publications';
import { taiwanCountyPaths } from '../data/taiwan-county-paths';

type Coverage = { title: string; outlet: string; date?: string; summary: string; url: string };

const countyOrder = [
  '基隆市', '臺北市', '新北市', '桃園市', '新竹市', '新竹縣', '苗栗縣',
  '臺中市', '彰化縣', '南投縣', '雲林縣', '嘉義市', '嘉義縣', '臺南市',
  '高雄市', '屏東縣', '宜蘭縣', '花蓮縣', '臺東縣', '澎湖縣', '金門縣', '連江縣',
] as const;

const countyLabelPositions: Record<string, { x: number; y: number; short: string }> = {
  基隆市: { x: 631, y: 91, short: '基隆' }, 臺北市: { x: 575, y: 106, short: '臺北' },
  新北市: { x: 592, y: 139, short: '新北' }, 桃園市: { x: 490, y: 133, short: '桃園' },
  新竹市: { x: 427, y: 171, short: '竹市' }, 新竹縣: { x: 477, y: 187, short: '竹縣' },
  苗栗縣: { x: 407, y: 224, short: '苗栗' }, 臺中市: { x: 397, y: 277, short: '臺中' },
  彰化縣: { x: 331, y: 319, short: '彰化' }, 南投縣: { x: 450, y: 354, short: '南投' },
  雲林縣: { x: 327, y: 382, short: '雲林' }, 嘉義市: { x: 344, y: 426, short: '嘉市' },
  嘉義縣: { x: 391, y: 425, short: '嘉縣' }, 臺南市: { x: 305, y: 482, short: '臺南' },
  高雄市: { x: 397, y: 535, short: '高雄' }, 屏東縣: { x: 382, y: 622, short: '屏東' },
  宜蘭縣: { x: 600, y: 194, short: '宜蘭' }, 花蓮縣: { x: 540, y: 362, short: '花蓮' },
  臺東縣: { x: 478, y: 527, short: '臺東' }, 澎湖縣: { x: 143, y: 373, short: '澎湖' },
  金門縣: { x: 137, y: 558, short: '金門' }, 連江縣: { x: 145, y: 157, short: '馬祖' },
};

const countyTone: Record<string, string> = Object.fromEntries(countyOrder.map((county) => {
  if (['澎湖縣', '金門縣', '連江縣'].includes(county)) return [county, 'islands'];
  if (['宜蘭縣', '花蓮縣', '臺東縣'].includes(county)) return [county, 'east'];
  if (['嘉義市', '嘉義縣', '臺南市', '高雄市', '屏東縣'].includes(county)) return [county, 'south'];
  if (['苗栗縣', '臺中市', '彰化縣', '南投縣', '雲林縣'].includes(county)) return [county, 'central'];
  return [county, 'north'];
}));

const coverageByName: Record<string, Coverage[]> = {
  看見臺東: [{
    title: '《看見臺東》改版，以地方刊物描繪山海日常', outlet: '今周刊', date: '2025.04',
    summary: '報導新版刊物如何從政策刊物轉向人物、旅行與地方生活敘事。',
    url: 'https://www.businesstoday.com.tw/article/category/183031/post/202504020025/',
  }],
  臺東部落食尚誌: [{
    title: '從部落餐桌認識臺東風土', outlet: 'Green Media 綠媒體',
    summary: '由飲食、旅行與部落文化切入，介紹刊物背後的地方採集方法。',
    url: 'https://greenmedia.today/article_detail.php?cid=260&mid=1277',
  }],
  苑裡掀海風: [{
    title: '地方刊物《苑裡掀海風》的返鄉書寫', outlet: '窩客島',
    summary: '從苑裡青年行動與在地採訪，回看刊物如何累積小鎮記憶。',
    url: 'https://www.walkerland.com.tw/article/view/271191',
  }],
  埔里鄉情: [{
    title: '《埔里鄉情》記錄地方四十年的變化', outlet: 'PeoPo 公民新聞',
    summary: '整理刊物發展、編輯社群與長期地方書寫的歷史脈絡。',
    url: 'https://www.peopo.org/news/580856',
  }],
  正興聞: [{
    title: '一份街區刊物如何串起正興街', outlet: '關鍵評論網',
    summary: '由店家與街區共同編輯的角度，介紹《正興聞》的社群方法。',
    url: 'https://www.thenewslens.com/article/31511',
  }],
  大雄誌: [{
    title: '高雄地方刊物的城市觀察', outlet: '關鍵評論網',
    summary: '從獨立出版與地方採訪，閱讀《大雄誌》如何描寫高雄。',
    url: 'https://www.thenewslens.com/article/117543',
  }],
  什貨生活: [{
    title: '鹽埕地方刊物與生活採集', outlet: 'VERSE',
    summary: '回顧刊物如何用人物、店家與老街日常保存鹽埕的地方感。',
    url: 'https://www.verse.com.tw/article/local-publications-yancheng',
  }],
  東透可: [{
    title: '從四本刊物看臺東的地方出版', outlet: '臺東藝文', date: '2024.02',
    summary: '專題並讀《東透可》、《看見臺東》、《部落食尚誌》與《Zoom in Taitung》。',
    url: 'https://culture.taitung.gov.tw/magazine/113-02',
  }],
  'Zoom in Taitung': [{
    title: '從四本刊物看臺東的地方出版', outlet: '臺東藝文', date: '2024.02',
    summary: '以地方編輯、影像紀實與生活觀察，整理臺東刊物的不同路徑。',
    url: 'https://culture.taitung.gov.tw/magazine/113-02',
  }],
  新莊騷: [{
    title: '臥房城市的精神覺醒：新莊騷串起舊記憶與新文化', outlet: '微笑台灣', date: '2023.09',
    summary: '從紙上策展與地方品牌的角度，回看刊物如何讓居民重新認識新莊。',
    url: 'https://smiletaiwan.cw.com.tw/article/7653',
  }],
  臺東土黏黏: [{
    title: '臺東土黏黏十周年，學生深入卑南海岸記錄地方故事', outlet: '國立臺東大學', date: '2026.01',
    summary: '第十輯以卑南海岸為田野，整理十一篇人物、海洋生活與返鄉創生報導。',
    url: 'https://enews.nttu.edu.tw/p/406-1045-171642%2Cr923.php',
  }],
  逐步東行: [{
    title: '母語創作、用心玩出家鄉驕傲', outlet: '見域', date: '2025.12',
    summary: '回顧竹東國中團隊十年來如何從紙本刊物走向母語歌曲與地方藝術行動。',
    url: 'https://www.citilens.cc/nest16-welovejudong',
  }],
  深溝年報: [{
    title: '宜蘭深溝田文社：種田也能種成地方媒體', outlet: '獨立評論', date: '2019.09',
    summary: '介紹年報的手作編輯、年度色票，以及田文社如何在農村持續記錄。',
    url: 'https://opinion.cw.com.tw/blog/profile/380/article/8477',
  }],
  'AMAZING PINGTUNG 驚豔屏東': [{
    title: '屏東縣刊變身生活風格雜誌', outlet: '中央社', date: '2020.08',
    summary: '從改版理念與地方美學，理解公部門刊物如何跳脫制式宣傳。',
    url: 'https://www.cna.com.tw/news/acul/202008220022.aspx?topic=2214',
  }],
};

const rootCounty = (city: string) => city.split('・')[0];
const isReference = (item: (typeof localPublications)[number]) => item.reading === 'reference' || item.access === 'catalog';
const withStatusSuffix = (name: string, status: (typeof localPublications)[number]['status']) => {
  if (status === 'hiatus') return name + '（已休刊）';
  if (status === 'ceased') return name + '（已停刊）';
  return name;
};
const payload = localPublications.map((item, index) => ({
  ...item,
  id: `zine-${index}`,
  county: rootCounty(item.city),
  displayName: withStatusSuffix(item.name, item.status),
  reading: isReference(item) ? 'reference' : 'online',
  statusLabel: statusLabels[item.status],
  accessLabel: accessLabels[item.access],
  coverage: coverageByName[item.name] || [],
}));

const initialCounty = '臺北市';
const initialPublications = payload.filter((item) => item.county === initialCounty);
const initialItem = initialPublications.find((item) => item.reading === 'online') || initialPublications[0];
const onlineCount = payload.filter((item) => item.reading === 'online').length;
const referenceCount = payload.length - onlineCount;
const serializedPayload = JSON.stringify(payload).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="臺灣 22 縣市地方刊物互動閱讀地圖。" />
    <meta name="theme-color" content="#C8E9B0" />
    <title>臺灣地方刊物閱讀地圖 · elephlow</title>
  </head>
  <body>
    <main class="zine-window">
      <header class="window-titlebar">
        <div><span class="title-dots" aria-hidden="true"><i></i><i></i><i></i></span><span>C:\ELEPHLOW\LOCAL_ZINES\reading-map.exe</span></div>
        <nav aria-label="頁面捷徑"><a href="/zh-tw/">⌂ 回小窩</a><span>繁</span></nav>
      </header>

      <div class="window-body">
        <header class="desk-heading">
          <span class="banner-charm charm-star" aria-hidden="true">✦</span>
          <span class="banner-charm charm-heart" aria-hidden="true">♡</span>
          <div class="heading-emblem" aria-hidden="true"><span>22</span><small>COUNTY<br />FILES</small></div>
          <div class="heading-copy">
            <p>TAIWAN LOCAL PUBLICATION DESK_</p>
            <h1>臺灣地方刊物閱讀地圖</h1>
            <small>點一個縣市，先看哪些刊物可以直接線上翻閱。</small>
          </div>
          <div class="heading-side">
            <span class="banner-ribbon">ISLAND READING CLUB</span>
            <div class="desk-counts" aria-label="刊物收錄數量">
              <span><b>{onlineCount}</b> 線上閱讀</span><span><b>{referenceCount}</b> 發行線索</span><span><b>22</b> 縣市</span>
            </div>
          </div>
        </header>

        <section class="reading-desktop" aria-label="地方刊物互動閱讀桌面">
          <section class="map-window" aria-labelledby="map-window-title">
            <header class="pane-titlebar"><span>▧ county_map.svg</span><i>— □</i></header>
            <div class="map-toolbar">
              <div><small>NOW SELECTED</small><strong id="selected-county">{initialCounty}</strong></div>
              <div class="name-legend"><span class="online-sample">可線上閱讀</span><span class="reference-sample">發行／館藏線索</span><button class="cross-county-button" type="button" data-county-select="跨縣市" aria-pressed="false">↗ 全臺／跨域</button></div>
            </div>
            <div class="map-canvas">
              <svg class="county-map" viewBox="0 0 720 760" role="img" aria-labelledby="map-title map-desc">
                <title id="map-title">臺灣二十二縣市互動地圖</title>
                <desc id="map-desc">點選縣市後，右側會顯示該縣市的地方刊物名稱。</desc>
                {countyOrder.map((county) => (
                  <g
                    class:list={['county-zone', `tone-${countyTone[county]}`, county === initialCounty && 'is-current']}
                    data-county-select={county}
                    role="button"
                    tabindex="0"
                    aria-label={`查看${county}地方刊物`}
                    aria-pressed={county === initialCounty ? 'true' : 'false'}
                  >
                    <title>{county}</title>
                    <path d={taiwanCountyPaths[county]}></path>
                  </g>
                ))}
                {countyOrder.map((county) => {
                  const label = countyLabelPositions[county];
                  return (
                    <g class:list={['county-label', county === initialCounty && 'is-current']} data-county-label={county} aria-hidden="true">
                      <circle cx={label.x} cy={label.y} r="3.5"></circle>
                      <text x={label.x + 7} y={label.y + 3}>{label.short}</text>
                    </g>
                  );
                })}
              </svg>
              <span class="map-decoration map-star">✦</span><span class="map-decoration map-note">22 COUNTY FILES</span>
            </div>
            <footer class="map-source">界線資料：<a href="https://data.gov.tw/dataset/7442" target="_blank" rel="noreferrer">政府資料開放平臺</a> · 最後核對 {lastVerified}</footer>
          </section>

          <aside class="library-pane">
            <section class="directory-window" aria-labelledby="directory-title">
              <header class="pane-titlebar"><span>▤ publication_index.txt</span><i>— □</i></header>
              <div class="directory-tools">
                <div><p>COUNTY SHELF</p><h2 id="directory-title">{initialCounty} · {initialPublications.length} 本</h2></div>
                <label class="directory-search"><span>⌕</span><input id="zine-search" type="search" placeholder="搜尋刊名或縣市" autocomplete="off" /></label>
              </div>
              <div class="directory-list" id="directory-list">
                {initialPublications.map((item) => (
                  <button class:list={['directory-item', `is-${item.reading}`, item.id === initialItem.id && 'is-current']} type="button" data-record-id={item.id}>
                    <span>{item.displayName}</span><small>{item.reading === 'online' ? '線上閱讀' : '發行線索'}</small>
                  </button>
                ))}
              </div>
            </section>

            <article class="record-card" id="record-card" data-reading={initialItem.reading} aria-live="polite">
              <header class="record-heading">
                <div class="record-eyebrow"><span>{initialItem.city}</span><span>{initialItem.statusLabel}</span><span>{initialItem.period}</span></div>
                <h2>{initialItem.displayName}</h2>
                <p>發行：{initialItem.publisher}</p>
              </header>
              <div class="record-scroll">
                <section class="record-about"><h3>刊物在讀什麼</h3><p>{initialItem.description}</p></section>
                <section class="record-issues"><h3>{initialItem.reading === 'online' ? '推薦單期' : '單期／資料線索'}</h3>{initialItem.issues.map((issue, index) => (
                  <a href={issue.url} target="_blank" rel="noreferrer"><b>{String(index + 1).padStart(2, '0')}</b><span><small>{issue.label}</small><strong>{issue.title}</strong><em>{issue.reason}</em></span><i>↗</i></a>
                ))}</section>
                {initialItem.coverage.length > 0 && <section class="record-coverage"><h3>相關報導</h3>{initialItem.coverage.map((report) => (
                  <a href={report.url} target="_blank" rel="noreferrer"><span><small>{report.outlet}{report.date ? ` · ${report.date}` : ''}</small><strong>{report.title}</strong><em>{report.summary}</em></span><i>↗</i></a>
                ))}</section>}
              </div>
              <footer class="record-footer"><span>{initialItem.reading === 'online' ? '有公開線上版本' : '目前僅有發行／館藏線索'}</span><a href={initialItem.url} target="_blank" rel="noreferrer">{initialItem.reading === 'online' ? '前往官方閱讀' : '查看發行資料'} ↗</a></footer>
            </article>
          </aside>
        </section>

      </div>

      <footer class="window-taskbar"><div><a href="/zh-tw/">⊞ 小窩</a><span>▣ 臺灣地方刊物閱讀地圖</span></div><div><span id="selection-status">{initialCounty} · {initialItem.displayName}</span><span id="clock">--:--</span></div></footer>
    </main>

    <aside class="suggest-float" id="suggest-float" aria-label="補充地方刊物">
      <header class="float-titlebar" id="suggest-drag-handle"><span>✉ zine_dropbox.msg</span><i>↕</i></header>
      <button class="float-body" id="open-suggestion" type="button" aria-haspopup="dialog">
        <span class="float-sticker" aria-hidden="true">NEW!</span>
        <span class="float-mail" aria-hidden="true">✉</span>
        <strong>漏網刊物？</strong>
        <small>點一下投遞<br />拖著標題列上下移動</small>
        <span class="float-ticker"><i>補充一本 ✦ 補充一本 ✦ 補充一本 ✦</i></span>
      </button>
    </aside>

    <dialog class="suggest-dialog" id="suggest-dialog">
      <form method="dialog" class="dialog-window" id="suggest-form">
        <header class="pane-titlebar"><span>✉ add_a_zine.msg</span><button type="button" id="close-suggestion" aria-label="關閉">×</button></header>
        <div class="dialog-body"><p>COMMUNITY DROPBOX_</p><h2>補充一本地方刊物</h2><small>送出時會打開郵件程式，網頁本身不儲存資料。</small>
          <div class="dialog-fields"><label><span>刊物名稱 *</span><input name="publication" required /></label><label><span>縣市／地區 *</span><input name="place" required /></label><label class="wide"><span>閱讀、發行或介紹連結 *</span><input name="url" type="url" required placeholder="https://" /></label><label class="wide"><span>補充說明</span><textarea name="note" rows="3"></textarea></label></div>
        </div>
        <footer class="dialog-actions"><button type="button" id="cancel-suggestion">取消</button><button type="submit" value="default">整理成郵件 ↗</button></footer>
      </form>
    </dialog>

    <script id="zine-data" type="application/json" set:html={serializedPayload}></script>
    <script is:inline>
      const records = JSON.parse(document.querySelector('#zine-data')?.textContent || '[]');
      const counties = [...new Set(records.map((record) => record.county))];
      const directory = document.querySelector('#directory-list');
      const directoryTitle = document.querySelector('#directory-title');
      const recordCard = document.querySelector('#record-card');
      const selectedCountyLabel = document.querySelector('#selected-county');
      const selectionStatus = document.querySelector('#selection-status');
      const search = document.querySelector('#zine-search');
      let selectedCounty = counties.includes(decodeURIComponent(location.hash.slice(1))) ? decodeURIComponent(location.hash.slice(1)) : '臺北市';
      let selectedRecordId = '';

      const escapeHtml = (value = '') => String(value).replace(/[&<>"]/g, (character) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[character]);
      const countyRecords = (county) => records.filter((record) => record.county === county).sort((a, b) => (a.reading === b.reading ? 0 : a.reading === 'online' ? -1 : 1));

      function updateMap() {
        document.querySelectorAll('[data-county-select]').forEach((zone) => {
          const current = zone.dataset.countySelect === selectedCounty;
          zone.classList.toggle('is-current', current);
          zone.setAttribute('aria-pressed', String(current));
        });
        document.querySelectorAll('[data-county-label]').forEach((label) => label.classList.toggle('is-current', label.dataset.countyLabel === selectedCounty));
        if (selectedCountyLabel) selectedCountyLabel.textContent = selectedCounty;
      }

      function renderDirectory(items, heading) {
        if (!directory || !directoryTitle) return;
        directoryTitle.textContent = `${heading} · ${items.length} 本`;
        directory.innerHTML = items.length ? items.map((record) => `<button class="directory-item is-${record.reading}${record.id === selectedRecordId ? ' is-current' : ''}" type="button" data-record-id="${record.id}"><span>${escapeHtml(record.displayName)}</span><small>${record.reading === 'online' ? '線上閱讀' : '發行線索'}</small></button>`).join('') : '<p class="directory-empty">沒有找到相符刊物。</p>';
      }

      function renderRecord(record) {
        if (!recordCard || !record) return;
        selectedRecordId = record.id;
        recordCard.dataset.reading = record.reading;
        const issues = record.issues.map((issue, index) => `<a href="${issue.url}" target="_blank" rel="noreferrer"><b>${String(index + 1).padStart(2, '0')}</b><span><small>${escapeHtml(issue.label)}</small><strong>${escapeHtml(issue.title)}</strong><em>${escapeHtml(issue.reason)}</em></span><i>↗</i></a>`).join('');
        const coverage = record.coverage.length ? `<section class="record-coverage"><h3>相關報導</h3>${record.coverage.map((report) => `<a href="${report.url}" target="_blank" rel="noreferrer"><span><small>${escapeHtml(report.outlet)}${report.date ? ` · ${escapeHtml(report.date)}` : ''}</small><strong>${escapeHtml(report.title)}</strong><em>${escapeHtml(report.summary)}</em></span><i>↗</i></a>`).join('')}</section>` : '';
        recordCard.innerHTML = `<header class="record-heading"><div class="record-eyebrow"><span>${escapeHtml(record.city)}</span><span>${escapeHtml(record.statusLabel)}</span><span>${escapeHtml(record.period)}</span></div><h2>${escapeHtml(record.displayName)}</h2><p>發行：${escapeHtml(record.publisher)}</p></header><div class="record-scroll"><section class="record-about"><h3>刊物在讀什麼</h3><p>${escapeHtml(record.description)}</p></section><section class="record-issues"><h3>${record.reading === 'online' ? '推薦單期' : '單期／資料線索'}</h3>${issues}</section>${coverage}</div><footer class="record-footer"><span>${record.reading === 'online' ? '有公開線上版本' : '目前僅有發行／館藏線索'}</span><a href="${record.url}" target="_blank" rel="noreferrer">${record.reading === 'online' ? '前往官方閱讀' : '查看發行資料'} ↗</a></footer>`;
        if (selectionStatus) selectionStatus.textContent = `${record.county} · ${record.displayName}`;
      }

      function selectCounty(county, preferredRecordId = '') {
        if (!counties.includes(county)) return;
        selectedCounty = county;
        const items = countyRecords(county);
        const selected = items.find((item) => item.id === preferredRecordId) || items[0];
        selectedRecordId = selected?.id || '';
        updateMap(); renderDirectory(items, county); renderRecord(selected);
        history.replaceState(null, '', `#${encodeURIComponent(county)}`);
      }

      document.querySelectorAll('[data-county-select]').forEach((zone) => {
        const choose = () => { if (search) search.value = ''; selectCounty(zone.dataset.countySelect); };
        zone.addEventListener('click', choose);
        zone.addEventListener('keydown', (event) => { if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); choose(); } });
      });
      directory?.addEventListener('click', (event) => {
        const button = event.target.closest('[data-record-id]'); if (!button) return;
        const record = records.find((item) => item.id === button.dataset.recordId); if (!record) return;
        if (record.county !== selectedCounty || search?.value) { if (search) search.value = ''; selectCounty(record.county, record.id); return; }
        selectedRecordId = record.id; renderDirectory(countyRecords(selectedCounty), selectedCounty); renderRecord(record);
      });
      search?.addEventListener('input', () => {
        const query = search.value.toLocaleLowerCase('zh-Hant').trim();
        if (!query) { renderDirectory(countyRecords(selectedCounty), selectedCounty); return; }
        const matches = records.filter((record) => `${record.name} ${record.city} ${record.publisher} ${record.description}`.toLocaleLowerCase('zh-Hant').includes(query));
        renderDirectory(matches, '搜尋結果');
      });

      const dialog = document.querySelector('#suggest-dialog');
      document.querySelector('#open-suggestion')?.addEventListener('click', () => dialog?.showModal());
      document.querySelector('#close-suggestion')?.addEventListener('click', () => dialog?.close());
      document.querySelector('#cancel-suggestion')?.addEventListener('click', () => dialog?.close());
      const floatWindow = document.querySelector('#suggest-float');
      const dragHandle = document.querySelector('#suggest-drag-handle');
      let floatDragOffset = 0;
      let draggingFloat = false;

      function positionFloat(clientY) {
        if (!floatWindow) return;
        const edge = window.innerWidth <= 640 ? 42 : 48;
        const maxTop = Math.max(edge, window.innerHeight - floatWindow.offsetHeight - edge);
        const top = Math.min(maxTop, Math.max(edge, clientY - floatDragOffset));
        floatWindow.style.top = top + 'px';
      }

      dragHandle?.addEventListener('pointerdown', (event) => {
        if (!floatWindow) return;
        draggingFloat = true;
        floatWindow.classList.add('is-dragging');
        floatDragOffset = event.clientY - floatWindow.getBoundingClientRect().top;
        dragHandle.setPointerCapture(event.pointerId);
      });
      dragHandle?.addEventListener('pointermove', (event) => {
        if (draggingFloat) positionFloat(event.clientY);
      });
      const stopFloatDrag = (event) => {
        draggingFloat = false;
        floatWindow?.classList.remove('is-dragging');
        if (dragHandle?.hasPointerCapture(event.pointerId)) dragHandle.releasePointerCapture(event.pointerId);
      };
      dragHandle?.addEventListener('pointerup', stopFloatDrag);
      dragHandle?.addEventListener('pointercancel', stopFloatDrag);
      window.addEventListener('resize', () => {
        if (!floatWindow) return;
        const rect = floatWindow.getBoundingClientRect();
        floatDragOffset = rect.height / 2;
        positionFloat(rect.top + floatDragOffset);
      });
      document.querySelector('#suggest-form')?.addEventListener('submit', (event) => {
        event.preventDefault(); const data = new FormData(event.currentTarget);
        const subject = `地方刊物補充｜${data.get('publication') || ''}`;
        const body = `刊物名稱：${data.get('publication') || ''}\n縣市／地區：${data.get('place') || ''}\n查證連結：${data.get('url') || ''}\n補充說明：${data.get('note') || '（無）'}\n\n來自臺灣地方刊物閱讀地圖的訪客投稿`;
        location.href = `mailto:iiicarus1217@gmail.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      });
      dialog?.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });

      function updateClock() { const clock = document.querySelector('#clock'); const now = new Date(); if (clock) clock.textContent = `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`; }
      selectCounty(selectedCounty); updateClock(); setInterval(updateClock, 30000);
    </script>
  </body>
