  .directory-list { min-height: 0; display: grid; grid-template-columns: 1fr; align-content: start; gap: 5px; overflow-y: auto; padding: 8px 10px 10px; scrollbar-color: var(--candy-mint) transparent; }
  .directory-item { display: flex; align-items: baseline; justify-content: space-between; gap: 8px; min-width: 0; padding: 5px 6px; border: 0; border-radius: 4px; background: transparent; text-align: left; cursor: pointer; }
