  .research-card-4 .research-card-visual i:nth-of-type(1) { left: 63px; top: 42px; width: 8px; height: 8px; }
  .research-card-4 .research-card-visual i:nth-of-type(2) { left: 76px; top: 71px; width: 6px; height: 6px; background: var(--candy-purple); }
