  .research-feature h3 { margin: 9px 0 12px; font: 700 clamp(23px,2.25vw,30px)/1.34 var(--font-serif-tc); letter-spacing: .035em; }
  .research-feature > p { color: var(--ink-light); font: 12px/1.9 var(--font-serif-tc); }
  .research-tags { display: flex; flex-wrap: wrap; gap: 5px; margin: 15px 0; }
