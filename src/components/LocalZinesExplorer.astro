  .research-card-5 .research-card-visual i:nth-of-type(1) { left: 25px; }
  .research-card-5 .research-card-visual i:nth-of-type(2) { left: 54px; background: var(--candy-pink); }
  .research-card-5 .research-card-visual i:nth-of-type(3) { left: 83px; background: var(--candy-mint); }

  /* 支持計畫：桌面像掛在小窩外框上的小票券，窄螢幕回到內容流。 */
  .support-pocket { position: relative; z-index: 44; width: min(100%,560px); margin: 14px 0 3px auto; overflow: visible; border: 1.5px dashed var(--candy-purple); border-radius: 10px; background: var(--soft-white); box-shadow: 4px 4px 0 rgba(247,213,217,.55),7px 7px 0 rgba(181,232,224,.3); }
  .support-pocket::before { content: ''; position: absolute; z-index: 3; top: -8px; right: 18px; width: 48px; height: 13px; border: 1px dashed rgba(155,122,168,.55); background: rgba(255,242,187,.85); transform: rotate(3deg); pointer-events: none; }
  .support-titlebar { min-height: 29px; display: flex; align-items: center; justify-content: space-between; gap: 7px; padding: 7px 9px; border-bottom: 1px dashed var(--candy-purple); border-radius: 8px 8px 0 0; background: color-mix(in srgb,var(--candy-pink) 65%,white); font: 700 10px/1.3 var(--font-rounded); letter-spacing: .04em; }
