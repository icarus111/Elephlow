  .island-insets {
    position: absolute; z-index: 6; left: 13px; top: 14px; width: 94px; display: grid; gap: 8px;
    padding: 19px 7px 8px; border: 1.5px dashed rgba(155,122,168,.78); border-radius: 11px;
