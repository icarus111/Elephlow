  .directory-item:hover, .directory-item.is-current { background: color-mix(in srgb, var(--candy-mint) 48%, white); outline: 1px dashed var(--candy-purple); }
  .directory-empty { grid-column: 1 / -1; padding: 17px; color: var(--ink-light); font: 9px var(--font-rounded); text-align: center; }

  .record-card { min-height: 0; display: grid; grid-template-rows: auto minmax(0,1fr) auto; border-color: #8fcdb1; animation: record-in .22s ease; }
  .record-card[data-reading='reference'] { border-color: #c6a2ce; box-shadow: 4px 4px 0 rgba(199,179,232,.28); }
