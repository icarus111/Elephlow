const rootCounty = (city: string) => city.split('・')[0];
const normalizedCounty = (city: string) => rootCounty(city) === '跨縣市' ? copy.nationwide : rootCounty(city);
const normalizedCity = (city: string) => city.replace(/^跨縣市/, copy.nationwide);
const isReference = (item: (typeof localPublications)[number]) => item.reading === 'reference' || item.access === 'catalog';
const withStatusSuffix = (name: string, status: (typeof localPublications)[number]['status']) => {
  if (status === 'hiatus') return name + copy.hiatusSuffix;
  if (status === 'ceased') return name + copy.ceasedSuffix;
  return name;
};
const socialFromUrl = (url: string): SocialLink[] => {
  if (/facebook\.com/i.test(url)) return [{ label: 'Facebook', url }];
  if (/instagram\.com/i.test(url)) return [{ label: 'Instagram', url }];
  return [];
};
const payload = localPublications.map((item, index) => {
  const curatedLinks = publicationLinksByName[item.name] || {};
  const platforms = curatedLinks.platforms || [];
  const socials = [
    ...(publicationSocialsByPublisher[item.publisher] || []),
    ...(curatedLinks.socials || []),
    ...socialFromUrl(item.url),
  ].filter((link, linkIndex, links) => {
    const normalizedUrl = link.url.replace(/\/$/, '');
    return links.findIndex((candidate) => candidate.url.replace(/\/$/, '') === normalizedUrl) === linkIndex;
  });
  const publicReading = !isReference(item);
  return {
    ...item,
    city: normalizedCity(item.city),
    id: `zine-${index}`,
    county: normalizedCounty(item.city),
    displayName: withStatusSuffix(item.name, item.status),
    publicReading,
    reading: publicReading || platforms.length > 0 ? 'online' : 'reference',
    statusLabel: copy.status[item.status],
    accessLabel: copy.access[item.access],
    hasLink: Boolean(item.url),
    hasDirectIntro: Boolean(item.url),
    platforms,
    socials,
    coverage: coverageByName[item.name] || [],
  };
});

const initialCounty = '臺北市';
const initialPublications = payload.filter((item) => item.county === initialCounty);
const initialItem = initialPublications.find((item) => item.reading === 'online') || initialPublications[0];
const onlineCount = payload.filter((item) => item.reading === 'online').length;
const referenceCount = payload.length - onlineCount;
const serializedPayload = JSON.stringify(payload).replace(/</g, '\\u003c');
const serializedUi = JSON.stringify(copy).replace(/</g, '\\u003c');
