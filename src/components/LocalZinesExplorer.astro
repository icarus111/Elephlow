  .research-heading > span {
    padding: 5px 8px; border: 1px dashed var(--candy-purple); border-radius: 99px; background: white;
    color: var(--ink-light); font: 6px var(--font-pixel); white-space: nowrap;
  }
  .research-layout {
    position: relative; display: grid; grid-template-columns: minmax(300px,.86fr) minmax(0,1.32fr); align-items: start; gap: 18px; padding: 18px 20px 22px;
    background:
      radial-gradient(circle at 8% 14%,rgba(247,213,217,.36) 0 42px,transparent 43px),
