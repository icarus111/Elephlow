  .research-card-4 .research-card-visual::after { content: '+'; position: absolute; z-index: 2; right: 18px; top: 18px; width: 24px; height: 24px; display: grid; place-items: center; border: 1px solid var(--candy-purple); border-radius: 50%; background: white; font: 11px var(--font-pixel); }
