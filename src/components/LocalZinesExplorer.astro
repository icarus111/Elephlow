  .map-note { right: 17px; bottom: 18px; padding: 4px 7px; border: 1px dashed var(--candy-purple); background: var(--candy-cream); font: 6px var(--font-pixel); transform: rotate(2deg); }
  @keyframes star-turn { to { transform: rotate(360deg); } }
  .map-source { padding: 5px 9px; border-top: 1px dashed var(--candy-mint); color: var(--ink-light); font: 6px var(--font-pixel); text-align: right; }
  .map-source a { color: var(--ink-light); }

  .library-pane { min-height: 0; height: 760px; display: grid; grid-template-columns: minmax(0,1fr); grid-template-rows: minmax(220px,.42fr) minmax(0,1fr); gap: 12px; }
  .directory-window { display: grid; grid-template-rows: auto auto minmax(0,1fr); }
