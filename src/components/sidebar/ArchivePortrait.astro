---
<div class="archive-portrait">
  <svg viewBox="0 0 80 80" xmlns="http://www.w3.org/2000/svg" shape-rendering="crispEdges">
    <rect x="6"  y="8"  width="68" height="6"  fill="#8A6F3F"/>
    <rect x="10" y="14" width="60" height="54" fill="#8A6F3F"/>
    <rect x="14" y="18" width="52" height="14" fill="#F0DFB5"/>
    <rect x="34" y="24" width="12" height="3"  fill="#C9A24A"/>
    <rect x="14" y="34" width="52" height="14" fill="#F0DFB5"/>
    <rect x="34" y="40" width="12" height="3"  fill="#C9A24A"/>
    <rect x="14" y="50" width="52" height="14" fill="#F0DFB5"/>
    <rect x="34" y="56" width="12" height="3"  fill="#C9A24A"/>
    <rect x="12" y="68" width="6"  height="4"  fill="#8A6F3F"/>
    <rect x="62" y="68" width="6"  height="4"  fill="#8A6F3F"/>
    <rect x="2"  y="22" width="2"  height="2"  fill="#C9A24A"/>
    <rect x="76" y="38" width="2"  height="2"  fill="#C9A24A"/>
    <rect x="4"  y="60" width="2"  height="2"  fill="#C9A24A"/>
  </svg>
  <p class="archive-id">elephlow.archive</p>
  <p class="archive-est"><em>est. 2022</em></p>
</div>

<style>
  .archive-portrait {
    background: var(--archive-cream);
    border: 1.5px dashed var(--archive-gold);
    border-radius: 14px;
    padding: 20px 16px;
    text-align: center;
    box-shadow: 4px 4px 0 rgba(201, 168, 118, 0.25);
    margin-bottom: 14px;
  }
  .archive-portrait svg {
    width: 96px;
    height: auto;
    display: block;
    margin: 0 auto;
  }
  .archive-id {
    font-family: var(--font-pixel);
    font-size: 12px;
    color: #6B5215;
    margin-top: 10px;
    letter-spacing: 0.15em;
  }
  .archive-est {
    font-size: 10px;
    color: #8A7B4F;
    margin-top: 4px;
  }
</style>
