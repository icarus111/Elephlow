---
// No locale-specific content — elephlow.archive & est. 2022 kept as-is across all locales
---
<div class="archive-portrait">
  <img src="/archive.svg" alt="Archive Cabinet" class="archive-icon" />
  
  <p class="archive-id">elephlow.archive</p>
  <p class="archive-est"><em>est. 2022</em></p>
</div>

<style>
  .archive-portrait {
    /* 這裡換成柔和白底、粉紅色虛線邊框和粉紅陰影 */
    background: var(--soft-white);
    border: 2px dashed var(--candy-pink);
    border-radius: 14px;
    padding: 20px 16px;
    text-align: center;
    box-shadow: 4px 4px 0 rgba(255, 182, 217, 0.35);
    margin-bottom: 14px;
  }
  
  .archive-icon {
    width: 130px;
    height: auto;
    display: block;
    margin: 0 auto;
  }

  .archive-id {
    font-family: var(--font-pixel);
    font-size: 11px;
    color: var(--ink-light); /* 換成柔和的文字顏色，不再是舊的深咖啡色 */
    margin-top: 10px;
    letter-spacing: 2px;
  }
  
  .archive-est {
    font-family: var(--font-pixel);
    font-size: 10px;
    color: var(--candy-purple); /* 讓 est. 2022 變成可愛的糖果紫 */
    margin-top: 4px;
  }
</style>