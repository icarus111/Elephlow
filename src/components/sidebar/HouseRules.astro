---
interface Props { locale?: string }
const { locale = 'zh-tw' } = Astro.props;

const rules: Record<string, string[]> = {
  'zh-tw': ['真誠勝過完美', '異議也是禮物', '認真讀每一篇來信', '歡迎創作者自薦！'],
  'zh-cn': ['真诚胜过完美', '异议也是礼物', '认真读每一封来信', '欢迎创作者自荐！'],
  'en':    ['Authenticity over perfection', 'Disagreement is also a gift', 'I read every letter carefully', 'Creators, feel free to pitch yourself!'],
};
const list = rules[locale] ?? rules['zh-tw'];
---
<div class="house-rules">
  <h3 class="rules-title">✦ house rules ✦</h3>
  <ul class="rules-list">
    {list.map(rule => <li>❀ {rule}</li>)}
  </ul>
</div>

<style>
  .house-rules {
    background: var(--room-lilac);
    border: 1.5px dashed var(--room-mauve);
    border-radius: 14px;
    padding: 16px;
    box-shadow: 3px 3px 0 rgba(184, 157, 208, 0.3);
    margin-bottom: 14px;
  }
  .rules-title {
    font-family: var(--font-pixel);
    font-size: 12px;
    color: var(--ink-light);
    text-align: center;
    letter-spacing: 4px;
    margin-bottom: 12px;
    padding-bottom: 8px;
    border-bottom: 1px dashed var(--room-mauve);
  }
  .rules-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .rules-list li {
    font-family: var(--font-serif-tc);
    font-size: 12.5px;
    line-height: 1.65;
    color: var(--ink);
  }
</style>
