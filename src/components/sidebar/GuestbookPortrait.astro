---
interface Props { locale?: string }
const { locale = 'zh-tw' } = Astro.props;

const captions: Record<string, string> = {
  'zh-tw': '茶剛泡好',
  'zh-cn': '茶刚泡好',
  'en':    'tea is ready',
};
const caption = captions[locale] ?? captions['zh-tw'];
---
<div class="room-portrait">
  <!-- 這裡換成你的新圖標 guestbook.svg -->
  <img src="/guestbook.svg" alt="A quiet little room" class="room-icon" />
  
  <p class="room-name">a quiet little room</p>
  <p class="room-status"><em>{caption}</em></p>
</div>

<style>
 .room-portrait {
    /* 背景改為柔和白，更能襯托出茶壺的奶茶色 */
    background: var(--soft-white); 
    
    /* 邊框換成溫暖的蜜桃橘（或是你想保留紫色也可以用 var(--candy-purple)） */
    border: 2px dashed var(--candy-peach); 
    border-radius: 14px;
    padding: 24px 16px;
    text-align: center;
    
    /* 陰影也配合邊框改成蜜桃色系 */
    box-shadow: 4px 4px 0 rgba(255, 200, 160, 0.4); 
    margin-bottom: 14px;
  }
  
  .room-icon {
    /* 控制新茶壺的大小，可根據你的圖標微調數字 */
    width: 110px;
    height: auto;
    display: block;
    margin: 0 auto 12px auto;
    transition: transform 0.2s ease-in-out;
  }

  /* 滑鼠懸停時，茶壺會微微往上浮動的可愛效果 */
  .room-portrait:hover .room-icon {
    transform: translateY(-4px);
  }

  .room-name {
    font-family: var(--font-pixel);
    font-size: 11px;
    color: var(--ink-light);
    margin-top: 0;
    margin-bottom: 6px;
    letter-spacing: 0.08em;
  }
  
  .room-status {
    font-family: var(--font-serif-tc);
    font-size: 12px;
    color: var(--candy-purple); /* 讓狀態文字變成可愛的紫色 */
    margin: 0;
    font-style: italic;
    letter-spacing: 1px;
  }
  .room-icon {
  width: 110px; /* 這裡控制茶壺的最終大小 */
  height: auto;
  display: block;
  margin: 0 auto 12px auto;
  transition: transform 0.2s ease-in-out;
}

</style>