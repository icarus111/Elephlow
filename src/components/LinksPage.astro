    .bookmark-row:last-child { border-bottom: 0; }
    .bookmark-row:hover {
      background: var(--soft-white);
      transform: translateX(2px);
    }
    .bookmark-no {
      font-family: var(--font-pixel);
      font-size: 10px;
      color: var(--candy-purple);
      padding-top: 4px;
    }
    .bookmark-main h3 {
      font-family: var(--font-serif-tc);
      font-size: 15.5px;
      line-height: 1.45;
      color: var(--ink);
      margin-bottom: 5px;
    }
    .bookmark-main p {
      font-family: var(--font-serif-tc);
      font-size: 13px;
      line-height: 1.65;
      color: #54483f;
    }
    .bookmark-meta {
      min-width: 0;
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 8px;
      justify-content: center;
