    }
    .bookmark-meta a {
      display: inline-block;
      padding: 5px 11px;
      font-family: var(--font-rounded);
      font-size: 12px;
      font-weight: 700;
      color: var(--ink);
      text-decoration: none;
      background: var(--candy-cream);
      border: 1.5px dashed var(--candy-purple);
      border-radius: 999px;
      box-shadow: 2px 2px 0 rgba(199, 179, 232, 0.3);
    }
    .bookmark-meta a:hover {
      background: var(--candy-mint);
      text-decoration: none;
    }

    .board-footer {
      text-align: center;
      margin-top: 24px;
      padding: 16px 0 8px;
      border-top: 1px dashed var(--candy-mint);
      font-family: var(--font-pixel);
      font-size: 11px;
      color: var(--ink-light);
      letter-spacing: 2px;
    }

    .menu-card {
      background: var(--soft-white);
      border: 1.5px dashed var(--candy-mint);
      border-radius: 12px;
      padding: 8px;
      box-shadow: 3px 3px 0 rgba(181, 232, 224, 0.4);
      margin-bottom: 12px;
    }
    .menu-title {
      font-family: var(--font-pixel);
      font-size: 12px;
      text-align: center;
      padding: 8px 4px;
      margin: 0 0 6px;
      color: var(--ink-light);
      background: var(--candy-cream);
      border-radius: 6px;
    }
    .menu-list { list-style: none; padding: 0; margin: 0; }
    .menu-list li { margin-bottom: 4px; }
    .menu-list a,
    .menu-current {
      display: block;
      padding: 10px 12px;
      text-align: center;
      font-family: var(--font-rounded);
      font-weight: 700;
      font-size: 13px;
      color: var(--ink);
      text-decoration: none;
      border-radius: 8px;
      border: 1.5px dashed var(--candy-purple);
      text-shadow: -1px -1px 0 var(--soft-white), 1px -1px 0 var(--soft-white), -1px 1px 0 var(--soft-white), 1px 1px 0 var(--soft-white);
