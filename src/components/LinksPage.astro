---
import '../styles/global.css';
import friendsData from '../data/friends.json';

type Locale = 'zh-cn' | 'zh-tw' | 'en';
interface Props { locale: Locale; }
const { locale } = Astro.props;

const copy = {
  'zh-cn': {
    htmlLang: 'zh-CN', title: '灵感地图 | 推开部屋的门',
    titlebar: '灵感地图', pageTitle: '灵感地图',
    subtitle: '像一张还在生长的地图，每一条链接都是一个可以出发的路口。',
    intro: '这里收着影像、独立出版、学术期刊、地方记忆、酷儿研究、音乐声响与开放课程等入口。有些像资料库，有些像编辑部，有些像还亮着灯的小房间。',
    zones: '分区', pins: '标记点', updated: '2026.05',
    home: '🏠 主页', about: '✍️ 创作者说', archive: '📚 往期目录',
    links: '🗺️ 灵感地图', guestbook: '💬 留言板', subscribe: '★ 订阅 ★',
    footer: '(｡♡‿♡｡) end of map ✿', task: '▣ 灵感地图',
    sites: '个站点', addrBase: 'elephlow.cc/zh-cn/links',
  },
  'zh-tw': {
    htmlLang: 'zh-TW', title: '靈感地圖 | 推開部屋的門',
    titlebar: '靈感地圖', pageTitle: '靈感地圖',
    subtitle: '像一張還在生長的地圖，每一條連結都是一個可以出發的路口。',
    intro: '這裡收著影像、獨立出版、學術期刊、地方記憶、酷兒研究、音樂聲響與開放課程等入口。有些像資料庫，有些像編輯部，有些像還亮著燈的小房間。',
    zones: '分區', pins: '標記點', updated: '2026.05',
    home: '🏠 主頁', about: '✍️ 創作者說', archive: '📚 往期目錄',
    links: '🗺️ 靈感地圖', guestbook: '💬 留言板', subscribe: '★ 訂閱 ★',
    footer: '(｡♡‿♡｡) end of map ✿', task: '▣ 靈感地圖',
    sites: '個站點', addrBase: 'elephlow.cc/zh-tw/links',
  },
  en: {
    htmlLang: 'en', title: 'Inspiration Map | Push The Door',
    titlebar: 'Inspiration Map', pageTitle: 'Inspiration Map',
    subtitle: 'A map still growing. Every link is a crossroads you can leave from.',
    intro: 'Film archives, independent publishing, journals, local memory, queer studies, music resources, open courses — some feel like databases, some like editorial rooms, some like small windows with the light on.',
    zones: 'zones', pins: 'pins', updated: '2026.05',
    home: '🏠 Home', about: "✍️ Editor's Note", archive: '📚 Archive',
    links: '🗺️ Map', guestbook: '💬 Guestbook', subscribe: '★ Subscribe ★',
    footer: '(｡♡‿♡｡) end of map ✿', task: '▣ Inspiration Map',
    sites: 'sites', addrBase: 'elephlow.cc/en/links',
  },
}[locale];

const paths = {
  home:      locale === 'en' ? '/en/'          : `/${locale}/`,
  about:     locale === 'en' ? '/en/about'     : `/${locale}/about`,
  archive:   locale === 'en' ? '/en/archive'   : `/${locale}/archive`,
  links:     locale === 'en' ? '/en/links'     : `/${locale}/links`,
  guestbook: locale === 'en' ? '/en/guestbook' : `/${locale}/guestbook`,
};

const langLinks = [
  { href: '/zh-cn/links', label: '简', active: locale === 'zh-cn' },
  { href: '/zh-tw/links', label: '繁', active: locale === 'zh-tw' },
  { href: '/en/links',    label: 'EN', active: locale === 'en'    },
];

const navItems = [
  { href: paths.home,      label: copy.home,      cls: 'menu-mint'   },
  { href: paths.about,     label: copy.about,     cls: 'menu-pink'   },
  { href: paths.archive,   label: copy.archive,   cls: 'menu-aqua'   },
  { href: paths.links,     label: copy.links,     cls: 'menu-cream'  },
  { href: paths.guestbook, label: copy.guestbook, cls: 'menu-purple' },
  { href: 'https://tally.so/r/4415XB', label: copy.subscribe, cls: 'menu-pink', external: true },
];

const nameTW: Record<string, string> = {
  'words-and-books':    '字與書',
  'moving-image':       '光影',
  'sound':              '聲響',
  'on-the-ground':      '在地報導',
  'periodicals':        '刊物',
  'zines-and-archives': '小誌與檔案',
  'visual-field':       '視覺誌',
  'self-study':         '自習室',
  'bookshops':          '書店地圖',
  'womens-place':       '女性的位置',
  'queer-landscapes':   '酷兒地景',
};

// 策展高光：填入完整 URL → 'wide' | 'large'（不填則首張自動 wide）
const featuredUrls: Record<string, 'wide' | 'large'> = {
};

const catMeta: Record<string, { icon: string; accent: string; bg: string }> = {
  'words-and-books':    { icon: '📖', accent: '#E8649A', bg: '#FEF0F5' },
  'moving-image':       { icon: '🎞️', accent: '#7B5CC8', bg: '#F6F2FD' },
  'sound':              { icon: '🎧', accent: '#38A898', bg: '#EEF9F7' },
  'on-the-ground':      { icon: '📰', accent: '#2890B8', bg: '#EEF6FC' },
  'periodicals':        { icon: '📋', accent: '#C89818', bg: '#FDF9EC' },
  'zines-and-archives': { icon: '📚', accent: '#7B5CC8', bg: '#F6F2FD' },
  'visual-field':       { icon: '🎨', accent: '#D04878', bg: '#FDF0F5' },
  'self-study':         { icon: '🧭', accent: '#2890B8', bg: '#EEF6FC' },
  'bookshops':          { icon: '🏪', accent: '#3A9848', bg: '#EEF9F0' },
  'womens-place':       { icon: '✊', accent: '#D83080', bg: '#FEF0F7' },
  'queer-landscapes':   { icon: '🌈', accent: '#8040C8', bg: '#F5EFFE' },
};

// 五種貼紙底紋，按卡片順序輪換
const stickerThemes = ['lace', 'doll', 'moon', 'mint', 'angel'] as const;

const totalLinks = friendsData.categories.reduce((s, c) => s + c.links.length, 0);

const categories = friendsData.categories.map((cat, i) => {
  const meta = catMeta[cat.id] ?? { icon: '✦', accent: '#C7B3E8', bg: '#F6F2FD' };
  const displayName =
    locale === 'en'    ? cat.name_en :
    locale === 'zh-tw' ? (nameTW[cat.id] ?? cat.name_zh) :
    cat.name_zh;
  return {
    id: cat.id,
    name: displayName,
    nameAlt: locale === 'en' ? (nameTW[cat.id] ?? cat.name_zh) : cat.name_en,
    description: cat.description,
    chapterNum: String(i + 1).padStart(2, '0'),
    icon: meta.icon,
    accent: meta.accent,
    bg: meta.bg,
    links: cat.links.map((link, j) => ({
      title: link.title,
      url: link.url,
      region: locale === 'en' ? link.region_en : link.region_zh,
      note: (link as { note?: string }).note ?? '',
      // 首張卡自動 featured-wide，featuredUrls 可覆蓋
      featured: featuredUrls[link.url] ?? (j === 0 ? 'wide' : null),
      theme: stickerThemes[j % stickerThemes.length],
    })),
  };
});
---
<!DOCTYPE html>
<html lang={copy.htmlLang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{copy.title}</title>
</head>
<body>

<main class="home-window">

  <!-- ① Titlebar -->
  <header class="window-titlebar">
    <div class="titlebar-left">
      <span class="title-dots">● ● ●</span>
      <span class="titlebar-text">elephlow.cc / {copy.titlebar}</span>
    </div>
    <div class="titlebar-right">
      {langLinks.map(l => (
        <a href={l.href} class:list={['lang-link', { 'lang-active': l.active }]}>{l.label}</a>
      ))}
    </div>
  </header>

  <!-- ② Browser strip -->
  <div class="browser-strip">
    <div class="addr-box">
      <span class="addr-dot" style="background:var(--candy-pink)"></span>
      <span class="addr-dot" style="background:var(--candy-cream)"></span>
      <span class="addr-dot" style="background:var(--candy-mint)"></span>
      <span class="addr-text">{copy.addrBase}</span>
    </div>
    <div class="bs-stats">
      <span>{categories.length} {copy.zones}</span>
      <span>·</span>
      <span>{totalLinks} {copy.pins}</span>
    </div>
  </div>

  <!-- ③ Body -->
  <div class="win-body">
    <div class="map-layout">

      <!-- 左：分類內容區 -->
      <div class="map-main">

        <!-- Hero -->
        <div class="hero">
          <span class="corner corner-tl">✿</span>
          <span class="corner corner-tr">✦</span>
          <span class="corner corner-bl">☘</span>
          <span class="corner corner-br">♡</span>
          <p class="hero-kicker">◈ inspiration map ◈</p>
          <h1 class="hero-title">{copy.pageTitle}</h1>
          <p class="hero-tagline">{copy.subtitle}</p>
          <p class="hero-intro">{copy.intro}</p>
        </div>

        <!-- 分類 sections -->
        {categories.map(cat => (
          <section
            class="cat-section"
            id={cat.id}
            style={`--sec-acc: ${cat.accent}; --sec-bg: ${cat.bg}`}
          >
            <div class="sec-header">
              <span class="sh-num">{cat.chapterNum}</span>
              <span class="sh-icon">{cat.icon}</span>
              <span class="sh-name">{cat.name}</span>
              <span class="sh-sep">·</span>
              <span class="sh-alt">{cat.nameAlt}</span>
              <span class="sh-count">{cat.links.length} {copy.sites}</span>
            </div>

            <div class="sec-body">
              {cat.description && (
                <p class="sec-desc">{cat.description}</p>
              )}
              <div class="banner-grid">
                {cat.links.map(link => (
                  <a
                    class={`link-sticker theme-${link.theme}${link.featured ? ` featured-${link.featured}` : ''}`}
                    href={link.url}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <div class="ls-head">
                      <span class="ls-title">{link.title}</span>
                      <span class="ls-region">{link.region}</span>
                    </div>
                    {link.note && (
                      <span class="ls-note">{link.note}</span>
                    )}
                  </a>
                ))}
              </div>
            </div>
          </section>
        ))}

      </div><!-- /map-main -->

      <!-- 右：導航窗格（與其他頁面風格一致） -->
      <aside class="map-sidebar">

        <div class="menu-card">
          <h3 class="menu-title">▼ MENU ▼</h3>
          <ul class="menu-list">
            {navItems.map(item => (
              <li>
                <a
                  href={item.href}
                  class={item.cls}
                  {...(item.external ? { target: '_blank', rel: 'noopener' } : {})}
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div class="map-stats-box">
          <p class="stats-title">◈ map stats ◈</p>
          <div class="stats-row">
            <span class="stats-label">{copy.zones}</span>
            <span class="stats-val">{categories.length}</span>
          </div>
          <div class="stats-row">
            <span class="stats-label">{copy.pins}</span>
            <span class="stats-val">{totalLinks}</span>
          </div>
          <p class="stats-updated">upd. {copy.updated}</p>
        </div>

        <div class="guestbook-card">
          <a href={paths.guestbook}>
            <span class="gb-icon">✉</span>
            <span class="gb-text">sign my guestbook</span>
          </a>
        </div>

      </aside><!-- /map-sidebar -->

    </div><!-- /map-layout -->
  </div><!-- /win-body -->

  <!-- ④ Taskbar -->
  <footer class="window-taskbar">
    <div class="taskbar-left">
      <span class="taskbar-start">⊞ START</span>
      <span class="taskbar-item">{copy.task}</span>
    </div>
    <div class="taskbar-right">
      <span class="taskbar-status">(｡♡‿♡｡) currently online</span>
      <span class="taskbar-clock" id="clock">--:--</span>
    </div>
  </footer>

</main>

<script is:inline>
(function () {
  const cl = document.getElementById('clock');
  function tick() {
    const n = new Date();
    if (cl) cl.textContent =
      `${String(n.getHours()).padStart(2,'0')}:${String(n.getMinutes()).padStart(2,'0')}`;
  }
  tick(); setInterval(tick, 30000);
})();
</script>

<style>
  /* ══ Window shell ══ */
  .home-window {
    max-width: 1180px;
    width: calc(100% - 24px);
    margin: 24px auto;
    background: var(--soft-white);
    border: 2px dashed var(--candy-purple);
    border-radius: 16px;
    box-shadow: 6px 6px 0 rgba(199,179,232,.35);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  /* ── Titlebar ── */
  .window-titlebar {
    background: var(--candy-mint);
    padding: 8px 16px;
    display: flex; justify-content: space-between; align-items: center;
    border-bottom: 2px dashed var(--candy-purple);
    font-family: var(--font-pixel); font-size: 11px; color: var(--ink);
  }
  .titlebar-left { display: flex; align-items: center; gap: 12px; }
  .title-dots { color: var(--candy-purple); letter-spacing: 2px; }
  .titlebar-right { display: flex; gap: 4px; }
  .lang-link { padding: 2px 8px; color: var(--ink); text-decoration: none; border-radius: 3px; }
  .lang-link:hover { background: var(--candy-cream); }
  .lang-active { background: var(--candy-cream); font-weight: 700; }

  /* ── Browser strip ── */
  .browser-strip {
    display: flex; justify-content: space-between; align-items: center;
    padding: 8px 16px; background: var(--candy-cream);
    border-bottom: 2px dashed var(--candy-peach);
    font-family: var(--font-pixel); font-size: 11px; gap: 12px;
  }
  .addr-box {
    display: flex; align-items: center; gap: 7px; padding: 5px 10px;
    background: var(--soft-white); border: 1.5px dashed var(--candy-purple); border-radius: 6px;
    flex: 1; min-width: 0;
  }
  .addr-dot { width: 9px; height: 9px; border-radius: 50%; border: 1px solid rgba(0,0,0,.1); flex-shrink: 0; }
  .addr-text { color: var(--ink-light); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .bs-stats {
    display: flex; gap: 6px; align-items: center; flex-shrink: 0;
    color: var(--ink-light); font-size: 10px;
  }

  /* ── Win body ── */
  .win-body { padding: 20px 24px; }

  /* ══ Two-column layout ══ */
  .map-layout {
    display: flex;
    gap: 20px;
    align-items: flex-start;
  }

  .map-main {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  /* ── Hero ── */
  .hero {
    position: relative;
    border: 2px dashed var(--candy-purple); border-radius: 12px;
    background: var(--soft-white); box-shadow: 4px 4px 0 rgba(199,179,232,.4);
    padding: 28px 36px 20px; text-align: center;
  }
  .corner { position: absolute; font-size: 16px; }
  .corner-tl { top:6px; left:8px; color:var(--candy-purple); }
  .corner-tr { top:6px; right:8px; color:var(--candy-pink); }
  .corner-bl { bottom:6px; left:8px; color:var(--candy-mint); }
  .corner-br { bottom:6px; right:8px; color:var(--candy-peach); }
  .hero-kicker {
    font-family: var(--font-pixel); color: var(--candy-purple);
    font-size: 10px; letter-spacing: 3px; margin-bottom: 8px;
  }
  .hero-title {
    font-family: var(--font-rounded); font-size: 30px; font-weight: 700;
    text-shadow: 2px 2px 0 var(--candy-mint); margin-bottom: 8px; color: var(--ink);
  }
  .hero-tagline {
    font-family: var(--font-serif-tc); color: var(--ink-light);
    font-size: 13px; margin-bottom: 8px; line-height: 1.7;
  }
  .hero-intro {
    font-family: var(--font-serif-tc); font-size: 12px;
    color: rgba(107,88,71,.7); font-style: italic; max-width: 560px; margin: 0 auto;
    line-height: 1.8;
  }

  /* ══ Category section ══ */
  .cat-section {
    border: 2px dashed var(--sec-acc, var(--candy-purple));
    border-radius: 10px;
    scroll-margin-top: 20px;
  }

  .sec-header {
    display: flex; align-items: center; gap: 10px;
    padding: 10px 16px;
    background: var(--sec-bg, var(--soft-white));
    border-bottom: 2px dashed var(--sec-acc, var(--candy-purple));
    border-radius: 8px 8px 0 0;
    font-family: var(--font-pixel);
  }

  .sh-num {
    background: var(--sec-acc, var(--candy-purple));
    color: #fff;
    font-family: var(--font-pixel); font-size: 10px;
    padding: 3px 7px; border-radius: 4px; flex-shrink: 0;
    letter-spacing: 1px;
  }
  .sh-icon { font-size: 18px; flex-shrink: 0; }
  .sh-name {
    font-family: var(--font-rounded); font-weight: 700; font-size: 15px;
    color: var(--ink); white-space: nowrap;
  }
  .sh-sep { color: var(--ink-light); font-size: 12px; flex-shrink: 0; }
  .sh-alt {
    font-family: var(--font-pixel); font-size: 10px;
    color: var(--ink-light); white-space: nowrap;
  }
  .sh-count {
    margin-left: auto; flex-shrink: 0;
    font-family: var(--font-pixel); font-size: 9px;
    color: var(--ink-light);
    background: rgba(255,255,255,0.65);
    padding: 2px 8px; border-radius: 4px;
    border: 1px dashed var(--sec-acc, var(--candy-purple));
  }

  .sec-desc {
    font-family: var(--font-serif-tc); font-size: 11px;
    color: rgba(107,88,71,.65); font-style: italic;
    padding: 8px 16px 0; line-height: 1.7;
  }

  /* ══ Card grid ══ */
  .banner-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-rows: 80px;
    grid-auto-flow: dense;
    gap: 14px;
    padding: 14px 16px 18px;
  }

  /* ══ Sticker cards ══ */
  .link-sticker {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 10px 14px;
    height: 100%;
    border-radius: 8px;
    border: 2px solid #fff;
    text-decoration: none !important;
    overflow: hidden;
    box-shadow: 4px 4px 0 rgba(199,179,232,.35);
    transition: transform 0.2s cubic-bezier(0.34,1.2,0.64,1), box-shadow 0.2s;
  }
  .link-sticker:hover {
    transform: translate(-2px,-3px) rotate(-1deg);
    box-shadow: 6px 6px 0 rgba(199,179,232,.5);
    text-decoration: none !important;
    z-index: 10;
  }
  /* 裁剪線 */
  .link-sticker::after {
    content: '';
    position: absolute; inset: 4px;
    border: 1.5px dashed rgba(255,255,255,.85);
    border-radius: 4px; pointer-events: none; z-index: 10;
  }

  /* ── 策展高光 ── */
  .featured-wide  { grid-column: span 2; }
  .featured-large {
    grid-column: span 2; grid-row: span 2;
    justify-content: flex-start; padding: 18px 20px;
  }
  .featured-large .ls-title { font-size: 16px; white-space: normal; display: inline-block; margin-bottom: 6px; }
  .featured-large .ls-note  { -webkit-line-clamp: 4; font-size: 12px; line-height: 1.6; }

  /* ── 內部排版 ── */
  .ls-head {
    display: flex; align-items: flex-start;
    justify-content: space-between; gap: 8px;
    position: relative; z-index: 2;
  }
  .ls-title {
    font-family: var(--font-pixel); font-size: 12px; font-weight: bold;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    text-shadow:
      -1px -1px 0 rgba(255,255,255,.8),
       1px -1px 0 rgba(255,255,255,.8),
      -1px  1px 0 rgba(255,255,255,.8),
       1px  1px 0 rgba(255,255,255,.8);
  }
  .ls-region {
    font-family: var(--font-pixel); font-size: 9px;
    padding: 2px 6px;
    background: rgba(255,255,255,.8);
    color: var(--ink);
    border: 1px dashed var(--candy-purple); border-radius: 4px;
    flex-shrink: 0;
  }
  .ls-note {
    font-family: var(--font-serif-tc); font-size: 11px;
    margin-top: 5px; position: relative; z-index: 2;
    background: rgba(255,255,255,.7); padding: 2px 6px;
    border-radius: 4px; border: 1px dotted rgba(255,255,255,.9);
    display: -webkit-box; -webkit-line-clamp: 2;
    -webkit-box-orient: vertical; overflow: hidden;
  }

  /* ══ 五種主題底紋 ══ */

  /* 水平條紋 */
  .theme-angel {
    background-color: var(--candy-aqua);
    background-image: repeating-linear-gradient(
      0deg, transparent, transparent 3px,
      rgba(255,255,255,.55) 3px, rgba(255,255,255,.55) 5px
    );
    color: #2b5c54;
    box-shadow: 4px 4px 0 rgba(181,232,224,.6);
  }

  /* 格子（Checker） */
  .theme-doll {
    background-color: var(--candy-pink);
    background-image:
      repeating-linear-gradient(45deg, rgba(255,255,255,.45) 25%, transparent 25%, transparent 75%, rgba(255,255,255,.45) 75%),
      repeating-linear-gradient(45deg, rgba(255,255,255,.45) 25%, #FFF0F6 25%, #FFF0F6 75%, rgba(255,255,255,.45) 75%);
    background-position: 0 0, 10px 10px;
    background-size: 20px 20px;
    color: #8c2a54;
    box-shadow: 4px 4px 0 rgba(255,182,217,.6);
  }
  .theme-doll .ls-title,
  .theme-doll .ls-note {
    background: rgba(255,255,255,.65); padding: 1px 5px; border-radius: 3px; display: inline-block;
  }

  /* 波點 */
  .theme-moon {
    background-color: var(--candy-purple);
    background-image:
      radial-gradient(rgba(255,255,255,.65) 22%, transparent 22%),
      radial-gradient(rgba(255,255,255,.65) 22%, transparent 22%);
    background-size: 14px 14px;
    background-position: 0 0, 7px 7px;
    color: #3f2f5c;
    box-shadow: 4px 4px 0 rgba(199,179,232,.6);
  }

  /* 格紋（方格紙） */
  .theme-lace {
    background-color: var(--candy-cream);
    background-image:
      linear-gradient(rgba(210,180,140,.35) 1px, transparent 1px),
      linear-gradient(90deg, rgba(210,180,140,.35) 1px, transparent 1px);
    background-size: 11px 11px;
    color: #6b441c;
    box-shadow: 4px 4px 0 rgba(255,233,182,.8);
    border-color: #D2B48C;
  }
  .theme-lace::after { border-color: rgba(139,90,43,.2); }

  /* 斜紋 */
  .theme-mint {
    background-color: var(--candy-mint);
    background-image: repeating-linear-gradient(
      -45deg, transparent, transparent 6px,
      rgba(255,255,255,.6) 6px, rgba(255,255,255,.6) 12px
    );
    color: #3b5c2b;
    box-shadow: 4px 4px 0 rgba(200,233,176,.6);
  }

  /* ══ 右側導航窗格 ══ */
  .map-sidebar {
    width: 200px;
    flex-shrink: 0;
    position: sticky;
    top: 20px;
    align-self: flex-start;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  /* Menu card — 與首頁右欄一致 */
  .menu-card {
    background: var(--soft-white);
    border: 1.5px dashed var(--candy-mint);
    border-radius: 12px;
    padding: 8px;
    box-shadow: 3px 3px 0 rgba(181,232,224,.4);
  }
  .menu-title {
    font-family: var(--font-pixel); font-size: 11px;
    text-align: center; padding: 7px 4px; margin: 0 0 6px;
    color: var(--ink-light);
    background: var(--candy-cream); border-radius: 6px;
  }
  .menu-list { list-style: none; padding: 0; margin: 0; }
  .menu-list li { margin-bottom: 4px; }
  .menu-list a {
    display: block; padding: 9px 12px;
    text-align: center;
    font-family: var(--font-rounded); font-weight: 700; font-size: 12px;
    color: var(--ink); text-decoration: none;
    border-radius: 8px; border: 1.5px dashed var(--candy-purple);
    transition: transform .15s;
    text-shadow: -1px -1px 0 var(--soft-white), 1px -1px 0 var(--soft-white),
                 -1px  1px 0 var(--soft-white), 1px  1px 0 var(--soft-white);
  }
  .menu-list a:hover {
    transform: translate(-2px,-2px);
    box-shadow: 2px 2px 0 rgba(199,179,232,.4);
    text-decoration: none;
  }
  .menu-mint   { background: var(--candy-mint); }
  .menu-aqua   { background: var(--candy-aqua); }
  .menu-pink   { background: var(--candy-pink); }
  .menu-purple { background: var(--candy-purple); }
  .menu-cream  { background: var(--candy-cream); }

  /* Map stats box */
  .map-stats-box {
    background: var(--soft-white);
    border: 1.5px dashed var(--candy-purple);
    border-radius: 10px;
    padding: 12px;
    box-shadow: 3px 3px 0 rgba(199,179,232,.35);
  }
  .stats-title {
    font-family: var(--font-pixel); font-size: 9px;
    color: var(--candy-purple); letter-spacing: 2px;
    text-align: center; margin-bottom: 10px;
  }
  .stats-row {
    display: flex; justify-content: space-between; align-items: center;
    padding: 5px 0;
    border-bottom: 1px dashed rgba(199,179,232,.4);
  }
  .stats-label { font-family: var(--font-pixel); font-size: 9px; color: var(--ink-light); }
  .stats-val   { font-family: var(--font-pixel); font-size: 18px; color: var(--candy-purple); line-height: 1; }
  .stats-updated {
    font-family: var(--font-pixel); font-size: 9px;
    color: var(--ink-light); text-align: right; margin-top: 8px;
  }

  /* Guestbook card */
  .guestbook-card a {
    display: flex; flex-direction: column; align-items: center;
    padding: 14px;
    background: var(--candy-cream);
    border: 1.5px dashed var(--candy-pink);
    border-radius: 12px;
    box-shadow: 3px 3px 0 rgba(255,182,217,.4);
    text-decoration: none; color: var(--ink);
  }
  .guestbook-card a:hover { text-decoration: none; transform: translate(-1px,-1px); }
  .gb-icon { font-size: 22px; margin-bottom: 4px; }
  .gb-text  { font-family: var(--font-pixel); font-size: 9px; color: var(--ink-light); letter-spacing: 1px; }

  /* ══ Taskbar ══ */
  .window-taskbar {
    background: var(--candy-mint); padding: 8px 16px;
    display: flex; justify-content: space-between; align-items: center;
    font-family: var(--font-pixel); font-size: 11px; color: var(--ink);
  }
  .taskbar-left  { display: flex; gap: 12px; align-items: center; }
  .taskbar-right { display: flex; gap: 12px; align-items: center; }
  .taskbar-start {
    background: rgba(255,255,255,.5); padding: 2px 8px;
    border-radius: 3px; border: 1px dashed var(--candy-purple);
  }
  .taskbar-item, .taskbar-status { color: var(--ink-light); }
  .taskbar-clock { font-weight: 700; }

  /* ══ Responsive ══ */
  @media (max-width: 760px) {
    .win-body { padding: 14px 16px; }
    .hero { padding: 22px 18px 16px; }
    .hero-title { font-size: 24px; }
    .map-sidebar { display: none; }
    .banner-grid {
      grid-template-columns: 1fr;
      grid-auto-rows: 70px;
      gap: 10px;
    }
    .featured-wide, .featured-large { grid-column: span 1; grid-row: span 1; }
    .sh-alt, .sh-sep { display: none; }
  }
</style>

</body>
</html>
