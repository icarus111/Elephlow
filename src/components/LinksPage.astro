---
import '../styles/global.css';
import { friendLinkCategories, friendLinkCount, getText, type Locale } from '../data/friend-links';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const copy = {
  'zh-cn': {
    htmlLang: 'zh-CN',
    title: '网页收藏夹 | 推开部屋的门',
    description: '推开部屋的门 - 小象的个人网页收藏夹与文化资源入口。',
    titlebar: '网页收藏夹',
    pageTitle: '网页收藏夹',
    shelfName: 'Elephlow Web Shelf',
    subtitle: '不是松散的网址列表，而是一只慢慢扩建的文化资料抽屉。',
    introTitle: '给慢慢搜索的人',
    intro:
      '这里收着影像、独立出版、学术期刊、地方记忆、酷儿研究、音乐声响与开放课程等入口。它们有些像资料库，有些像编辑部，有些像还亮着灯的小房间。',
    categoriesLabel: '资料夹',
    linksLabel: '书签',
    updatedLabel: '整理',
    updated: '2026.05',
    indexTitle: 'folder index',
    visit: '打开',
    home: '主页',
    about: '创作者说',
    archive: '往期目录',
    links: '网页收藏夹',
    guestbook: '留言板',
    subscribe: '订阅',
    footer: '(｡♡‿♡｡) end of shelf ✿',
    task: '▣ 网页收藏夹',
    nowPlaying: '文化资料入口 / open tabs / saved paths',
  },
  'zh-tw': {
    htmlLang: 'zh-TW',
    title: '網頁收藏夾 | 推開部屋的門',
    description: '推開部屋的門 - 小象的個人網頁收藏夾與文化資源入口。',
    titlebar: '網頁收藏夾',
    pageTitle: '網頁收藏夾',
    shelfName: 'Elephlow Web Shelf',
    subtitle: '不是鬆散的網址列表，而是一個慢慢擴建的文化資料抽屜。',
    introTitle: '給慢慢搜尋的人',
    intro:
      '這裡收著影像、獨立出版、學術期刊、地方記憶、酷兒研究、音樂聲響與開放課程等入口。它們有些像資料庫，有些像編輯部，有些像還亮著燈的小房間。',
    categoriesLabel: '資料夾',
    linksLabel: '書籤',
    updatedLabel: '整理',
    updated: '2026.05',
    indexTitle: 'folder index',
    visit: '打開',
    home: '主頁',
    about: '創作者說',
    archive: '往期目錄',
    links: '網頁收藏夾',
    guestbook: '留言板',
    subscribe: '訂閱',
    footer: '(｡♡‿♡｡) end of shelf ✿',
    task: '▣ 網頁收藏夾',
    nowPlaying: '文化資料入口 / open tabs / saved paths',
  },
  en: {
    htmlLang: 'en',
    title: 'Web Shelf | Push The Door',
    description: "Push The Door - Elephlow's personal web shelf and cultural resource directory.",
    titlebar: 'Web Shelf',
    pageTitle: 'Web Shelf',
    shelfName: 'Elephlow Web Shelf',
    subtitle: 'Not a link-exchange page, but a growing drawer of cultural references.',
    introTitle: 'For people who search slowly',
    intro:
      'A handpicked shelf of film archives, independent publishing, journals, local memory, queer studies, music resources, and open courses. Some are databases, some are editorial rooms, and some still feel like small windows with the light on.',
    categoriesLabel: 'Folders',
    linksLabel: 'Bookmarks',
    updatedLabel: 'Updated',
    updated: '2026.05',
    indexTitle: 'folder index',
    visit: 'Open',
    home: 'Home',
    about: "Editor's Note",
    archive: 'Archive',
    links: 'Web Shelf',
    guestbook: 'Guestbook',
    subscribe: 'Subscribe',
    footer: '(｡♡‿♡｡) end of shelf ✿',
    task: '▣ Web Shelf',
    nowPlaying: 'cultural resource shelf / open tabs / saved paths',
  },
}[locale];

const paths = {
  home: locale === 'en' ? '/en/' : `/${locale}/`,
  about: locale === 'en' ? '/en/about' : `/${locale}/about`,
  archive: locale === 'en' ? '/en/archive' : `/${locale}/archive`,
  links: locale === 'en' ? '/en/links' : `/${locale}/links`,
  guestbook: locale === 'en' ? '/en/guestbook' : `/${locale}/guestbook`,
};

const langLinks = [
  { href: '/zh-cn/links', label: '简', active: locale === 'zh-cn' },
  { href: '/zh-tw/links', label: '繁', active: locale === 'zh-tw' },
  { href: '/en/links', label: 'EN', active: locale === 'en' },
];

const categories = friendLinkCategories.map((category) => ({
  ...category,
  label: getText(category.title, locale),
  links: category.links.map((link) => ({
    ...link,
    label: getText(link.title, locale),
    descriptionText: getText(link.description, locale),
    host: new URL(link.url).hostname.replace(/^www\./, ''),
  })),
}));
---
<!DOCTYPE html>
<html lang={copy.htmlLang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{copy.title}</title>
  <meta name="description" content={copy.description} />
</head>
<body>

  <main class="home-window">

    <header class="window-titlebar">
      <div class="titlebar-left">
        <span class="title-dots">● ● ●</span>
        <span class="titlebar-text">elephlow.cc / {copy.titlebar}</span>
      </div>
      <div class="titlebar-right">
        {langLinks.map((link) => (
          <a href={link.href} class:list={['lang-link', { 'lang-active': link.active }]}>{link.label}</a>
        ))}
      </div>
    </header>

    <div class="browser-strip">
      <div class="address-box">
        <span class="address-dot bg-pink"></span>
        <span class="address-dot bg-cream"></span>
        <span class="address-dot bg-mint"></span>
        <span class="address-text">https://elephlow.cc/{locale}/web-shelf</span>
      </div>
      <div class="mini-tabs" aria-hidden="true">
        <span>film.db</span>
        <span>zine.zip</span>
        <span>sound.wav</span>
      </div>
    </div>

    <div class="window-content links-layout">

      <aside class="links-left sticky-sidebar">
        <div class="link-portrait">
          <img src="/logo.png" alt="elephlow" class="link-icon" />
          <p class="link-id">elephlow.web-shelf</p>
          <p class="link-est"><em>open tabs / saved paths</em></p>
        </div>

        <div class="link-stats">
          <h3 class="stats-title">✦ shelf stats ✦</h3>
          <dl class="stats-list">
            <div class="stats-row"><dt>{copy.categoriesLabel}</dt><dd>{friendLinkCategories.length}</dd></div>
            <div class="stats-row"><dt>{copy.linksLabel}</dt><dd>{friendLinkCount}</dd></div>
            <div class="stats-row"><dt>{copy.updatedLabel}</dt><dd>{copy.updated}</dd></div>
          </dl>
        </div>

        <div class="index-card">
          <h3 class="card-title">{copy.indexTitle}</h3>
          <nav class="folder-nav">
            {categories.map((category) => (
              <a href={`#${category.id}`} class:list={['folder-tab', `folder-${category.accent}`]}>
                <span>{category.icon}</span>
                <span>{category.label}</span>
              </a>
            ))}
          </nav>
        </div>
      </aside>

      <section class="links-center">
        <div class="shelf-panel">
          <section class="shelf-hero">
            <div>
              <p class="shelf-kicker">bookmarks / references / rabbit holes</p>
              <h1>{copy.pageTitle}</h1>
              <p class="shelf-subtitle">{copy.subtitle}</p>
            </div>
            <div class="shelf-badge">
              <span>{String(friendLinkCount).padStart(2, '0')}</span>
              <small>{copy.linksLabel}</small>
            </div>
          </section>

          <section class="shelf-note">
            <div class="note-pin">✿</div>
            <div>
              <h2>{copy.introTitle}</h2>
              <p>{copy.intro}</p>
            </div>
          </section>

          <div class="folder-stack">
            {categories.map((category, categoryIndex) => (
              <section id={category.id} class:list={['folder-section', `section-${category.accent}`]}>
                <header class="folder-heading">
                  <div>
                    <span class="folder-icon">{category.icon}</span>
                    <h2>{category.label}</h2>
                    <p>{category.subtitle}</p>
                  </div>
                  <span class="folder-count">{category.links.length}</span>
                </header>

                <div class="bookmark-list">
                  {category.links.map((link, linkIndex) => (
                    <article class="bookmark-row">
                      <span class="bookmark-no">{String(categoryIndex + 1).padStart(2, '0')}-{String(linkIndex + 1).padStart(2, '0')}</span>
                      <div class="bookmark-main">
                        <h3>{link.label}</h3>
                        <p>{link.descriptionText}</p>
                      </div>
                      <div class="bookmark-meta">
                        <span>{link.host}</span>
                        <a href={link.url} target="_blank" rel="noopener noreferrer">{copy.visit} ↗</a>
                      </div>
                    </article>
                  ))}
                </div>
              </section>
            ))}
          </div>

          <div class="board-footer">
            <p>{copy.footer}</p>
          </div>
        </div>
      </section>

      <aside class="links-right sticky-sidebar">
        <div class="menu-card">
          <h3 class="menu-title">▼ MENU ▼</h3>
          <ul class="menu-list">
            <li><a href={paths.home} class="menu-mint">🏠 {copy.home}</a></li>
            <li><a href={paths.about} class="menu-pink">✍️ {copy.about}</a></li>
            <li><a href={paths.archive} class="menu-aqua">📚 {copy.archive}</a></li>
            <li><span class="menu-peach menu-current">🔖 {copy.links}</span></li>
            <li><a href={paths.guestbook} class="menu-purple">💬 {copy.guestbook}</a></li>
            <li><a href="https://tally.so/r/4415XB" class="menu-cream">★ {copy.subscribe} ★</a></li>
          </ul>
        </div>

        <div class="minihome-deco">
          <div class="deco-row">✦ ✿ ☘ ♡ ✦</div>
          <div class="deco-text">
            <p>save for later</p>
            <p>read with care ｡^‿^｡</p>
          </div>
        </div>

        <div class="kawaii-player">
          <div class="kp-header">
            <span class="kp-dot"></span>♫ NOW BROWSING<span class="kp-dot"></span>
          </div>
          <div class="kp-screen">
            <div class="kp-marquee">
              <span>{copy.nowPlaying}</span>
            </div>
          </div>
          <div class="kp-controls">
            <span class="kp-btn">◁</span>
            <span class="kp-btn kp-play">▶</span>
            <span class="kp-btn">▷</span>
          </div>
        </div>

        <div class="kawaii-counter">
          <p class="kc-title">✦ SAVED LINKS ✦</p>
          <div class="kc-digits">
            {String(friendLinkCount).padStart(4, '0').split('').map((digit) => <span>{digit}</span>)}
          </div>
        </div>
      </aside>

    </div>

    <footer class="window-taskbar">
      <div class="taskbar-left">
        <span class="taskbar-start">⊞ START</span>
        <span class="taskbar-item">{copy.task}</span>
      </div>
      <div class="taskbar-right">
        <span class="taskbar-status">(｡♡‿♡｡) currently online</span>
        <span class="taskbar-clock" id="clock">--:--</span>
      </div>
    </footer>

  </main>

  <script is:inline>
    function updateClock() {
      const now = new Date();
      const h = String(now.getHours()).padStart(2, '0');
      const m = String(now.getMinutes()).padStart(2, '0');
      const el = document.getElementById('clock');
      if (el) el.innerText = `${h}:${m}`;
    }
    updateClock();
    setInterval(updateClock, 30000);

    document.querySelectorAll('.folder-nav a').forEach((anchor) => {
      anchor.addEventListener('click', function (e) {
        e.preventDefault();
        const targetId = this.getAttribute('href');
        const targetElement = document.querySelector(targetId);
        if (targetElement) targetElement.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });
  </script>

  <style>
    .home-window {
      max-width: 1220px;
      margin: 24px auto;
      background: var(--soft-white);
      border: 3px dashed var(--candy-mint);
      border-radius: 16px;
      box-shadow: 6px 6px 0 rgba(181, 232, 224, 0.6);
      display: flex;
      flex-direction: column;
    }
    .window-titlebar {
      background: var(--candy-mint);
      padding: 8px 16px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 2px dashed var(--candy-mint);
      border-radius: 13px 13px 0 0;
      font-family: var(--font-pixel);
      font-size: 11px;
      color: var(--ink);
    }
    .titlebar-left { display: flex; align-items: center; gap: 12px; }
    .title-dots { color: var(--candy-purple); letter-spacing: 2px; }
    .titlebar-text { letter-spacing: 1px; }
    .titlebar-right { display: flex; gap: 4px; }
    .lang-link { padding: 2px 8px; color: var(--ink); text-decoration: none; border-radius: 3px; }
    .lang-link:hover { background: rgba(255, 255, 255, 0.4); }
    .lang-active { background: rgba(255, 255, 255, 0.6); font-weight: 700; }

    .browser-strip {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 12px;
      align-items: center;
      padding: 10px 16px;
      background: var(--candy-cream);
      border-bottom: 2px dashed var(--candy-peach);
      font-family: var(--font-pixel);
      font-size: 11px;
    }
    .address-box {
      display: flex;
      align-items: center;
      gap: 7px;
      min-width: 0;
      padding: 7px 10px;
      background: var(--soft-white);
      border: 1.5px dashed var(--candy-purple);
      border-radius: 8px;
      box-shadow: inset 2px 2px 0 rgba(199, 179, 232, 0.16);
    }
    .address-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      border: 1px solid rgba(0, 0, 0, 0.12);
      flex: 0 0 auto;
    }
    .address-text {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      color: var(--ink-light);
    }
    .mini-tabs {
      display: flex;
      gap: 6px;
    }
    .mini-tabs span {
      padding: 5px 8px;
      background: rgba(255, 255, 255, 0.62);
      border: 1px dashed var(--candy-pink);
      border-radius: 6px 6px 0 0;
      color: var(--ink-light);
    }

    .window-content { padding: 24px; }
    .links-layout {
      display: grid;
      grid-template-columns: 238px minmax(0, 1fr) 202px;
      gap: 24px;
      align-items: start;
    }
    .sticky-sidebar { position: sticky; top: 24px; height: fit-content; }

    .link-portrait {
      background: var(--soft-white);
      border: 2px dashed var(--candy-pink);
      border-radius: 14px;
      padding: 20px 16px;
      text-align: center;
      box-shadow: 4px 4px 0 rgba(255, 182, 217, 0.35);
      margin-bottom: 14px;
    }
    .link-icon {
      width: 118px;
      height: auto;
      display: block;
      margin: 0 auto;
    }
    .link-id {
      font-family: var(--font-pixel);
      font-size: 11px;
      color: var(--ink-light);
      margin-top: 10px;
      letter-spacing: 2px;
    }
    .link-est {
      font-family: var(--font-pixel);
      font-size: 10px;
      color: var(--candy-purple);
      margin-top: 4px;
    }

    .card-title,
    .stats-title {
      font-family: var(--font-pixel);
      font-size: 12px;
      color: var(--ink-light);
      text-align: center;
      letter-spacing: 3px;
      margin-bottom: 12px;
      padding-bottom: 8px;
      border-bottom: 1px dashed currentColor;
    }
    .link-stats {
      background: var(--room-sage);
      border: 1.5px dashed var(--room-olive);
      border-radius: 14px;
      padding: 16px;
      box-shadow: 3px 3px 0 rgba(168, 192, 120, 0.3);
      margin-bottom: 14px;
    }
    .stats-list {
      display: flex;
      flex-direction: column;
      gap: 8px;
      margin: 0;
    }
    .stats-row {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
    }
    .stats-row dt {
      font-family: var(--font-pixel);
      font-size: 10px;
      color: var(--ink-light);
    }
    .stats-row dd {
      font-family: var(--font-rounded);
      font-size: 13px;
      font-weight: 700;
      color: var(--ink);
      margin-left: 0;
    }

    .index-card {
      background: var(--candy-cream);
      border: 1.5px dashed var(--candy-peach);
      border-radius: 12px;
      padding: 14px 12px;
      box-shadow: 3px 3px 0 rgba(255, 233, 182, 0.5);
    }
    .folder-nav {
      display: flex;
      flex-direction: column;
      gap: 7px;
    }
    .folder-tab {
      display: grid;
      grid-template-columns: 22px minmax(0, 1fr);
      align-items: center;
      gap: 7px;
      padding: 8px 10px;
      color: var(--ink);
      font-family: var(--font-rounded);
      font-size: 12.5px;
      font-weight: 700;
      line-height: 1.35;
      text-decoration: none;
      border: 1.5px dashed var(--candy-purple);
      border-left-width: 7px;
      border-radius: 0 8px 8px 0;
      background: rgba(255, 255, 255, 0.62);
      transition: transform 0.15s, background 0.15s;
    }
    .folder-tab:hover {
      transform: translateX(3px);
      background: var(--soft-white);
      text-decoration: none;
    }
    .folder-mint { border-left-color: var(--candy-mint); }
    .folder-peach { border-left-color: var(--candy-peach); }
    .folder-pink { border-left-color: var(--candy-pink); }
    .folder-aqua { border-left-color: var(--candy-aqua); }
    .folder-purple { border-left-color: var(--candy-purple); }
    .folder-cream { border-left-color: var(--candy-cream); }

    .shelf-panel {
      background:
        linear-gradient(var(--soft-white), var(--soft-white)) padding-box,
        repeating-linear-gradient(135deg, var(--candy-mint) 0 10px, var(--candy-aqua) 10px 20px, var(--candy-cream) 20px 30px, var(--candy-pink) 30px 40px) border-box;
      border: 3px solid transparent;
      border-radius: 14px;
      padding: 8px;
      box-shadow: 4px 4px 0 rgba(181, 232, 224, 0.4);
    }
    .shelf-hero {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 116px;
      gap: 18px;
      align-items: center;
      padding: 24px 26px;
      background: var(--soft-white);
      border: 1.5px dashed var(--candy-purple);
      border-radius: 10px;
      margin-bottom: 12px;
    }
    .shelf-kicker {
      font-family: var(--font-pixel);
      font-size: 11px;
      color: var(--candy-purple);
      letter-spacing: 1.5px;
      margin-bottom: 8px;
    }
    .shelf-hero h1 {
      font-family: var(--font-rounded);
      font-size: 32px;
      line-height: 1.15;
      color: var(--ink);
      letter-spacing: 0;
      margin-bottom: 8px;
      text-shadow: 2px 2px 0 var(--candy-cream);
    }
    .shelf-subtitle {
      font-family: var(--font-serif-tc);
      font-size: 14px;
      line-height: 1.8;
      color: var(--ink-light);
    }
    .shelf-badge {
      width: 104px;
      aspect-ratio: 1;
      border-radius: 50%;
      background: var(--candy-mint);
      border: 2px dashed var(--candy-purple);
      box-shadow: 4px 4px 0 rgba(199, 179, 232, 0.34);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      color: var(--ink);
    }
    .shelf-badge span {
      font-family: var(--font-bubble);
      font-size: 30px;
      line-height: 1;
    }
    .shelf-badge small {
      font-family: var(--font-pixel);
      font-size: 10px;
      margin-top: 5px;
    }

    .shelf-note {
      display: grid;
      grid-template-columns: 34px minmax(0, 1fr);
      gap: 12px;
      padding: 16px 18px;
      margin-bottom: 18px;
      background: rgba(181, 232, 224, 0.24);
      border: 1.5px dashed var(--candy-aqua);
      border-radius: 10px;
    }
    .note-pin {
      width: 30px;
      height: 30px;
      display: grid;
      place-items: center;
      border-radius: 50%;
      background: var(--candy-pink);
      border: 1.5px dashed var(--candy-purple);
      color: var(--ink);
      font-family: var(--font-pixel);
    }
    .shelf-note h2 {
      font-family: var(--font-rounded);
      font-size: 17px;
      color: var(--ink);
      margin-bottom: 5px;
    }
    .shelf-note p {
      font-family: var(--font-serif-tc);
      font-size: 14px;
      line-height: 1.85;
      color: var(--ink);
    }

    .folder-stack {
      display: flex;
      flex-direction: column;
      gap: 20px;
    }
    .folder-section {
      scroll-margin-top: 36px;
      background: #fff;
      border: 2px dashed var(--candy-mint);
      border-radius: 0 12px 12px 12px;
      box-shadow: 3px 3px 0 rgba(181, 232, 224, 0.25);
      overflow: hidden;
    }
    .folder-heading {
      display: flex;
      justify-content: space-between;
      gap: 16px;
      align-items: center;
      padding: 14px 18px;
      border-bottom: 1.5px dashed rgba(42, 31, 24, 0.16);
    }
    .folder-heading div {
      min-width: 0;
      display: grid;
      grid-template-columns: 30px minmax(0, 1fr);
      column-gap: 8px;
      align-items: center;
    }
    .folder-icon {
      grid-row: span 2;
      font-size: 22px;
    }
    .folder-heading h2 {
      font-family: var(--font-rounded);
      font-size: 18px;
      line-height: 1.35;
      color: var(--ink);
      letter-spacing: 0;
    }
    .folder-heading p {
      font-family: var(--font-pixel);
      font-size: 10px;
      color: var(--ink-light);
      letter-spacing: 1px;
    }
    .folder-count {
      min-width: 32px;
      height: 32px;
      display: inline-grid;
      place-items: center;
      font-family: var(--font-pixel);
      font-size: 12px;
      color: var(--ink);
      background: var(--soft-white);
      border: 1.5px dashed currentColor;
      border-radius: 50%;
