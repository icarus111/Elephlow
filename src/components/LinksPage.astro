    .section-mint { border-color: var(--candy-mint); }
    .section-peach { border-color: var(--candy-peach); }
    .section-pink { border-color: var(--candy-pink); }
    .section-aqua { border-color: var(--candy-aqua); }
    .section-purple { border-color: var(--candy-purple); }
    .section-cream { border-color: var(--candy-cream); }
    .section-mint .folder-heading { background: rgba(200, 233, 176, 0.34); }
    .section-peach .folder-heading { background: rgba(255, 200, 200, 0.34); }
    .section-pink .folder-heading { background: rgba(255, 182, 217, 0.26); }
    .section-aqua .folder-heading { background: rgba(181, 232, 224, 0.32); }
    .section-purple .folder-heading { background: rgba(199, 179, 232, 0.26); }
    .section-cream .folder-heading { background: rgba(255, 233, 182, 0.42); }

    .bookmark-list {
      display: flex;
      flex-direction: column;
    }
    .bookmark-row {
      display: grid;
      grid-template-columns: 54px minmax(0, 1fr) 150px;
      gap: 14px;
      padding: 14px 16px;
      border-bottom: 1px dashed rgba(42, 31, 24, 0.13);
      background: linear-gradient(90deg, rgba(255, 252, 245, 0.92), #fff);
      transition: background 0.15s, transform 0.15s;
