    .deco-row {
      font-size: 14px;
      color: var(--candy-purple);
      letter-spacing: 4px;
      margin-bottom: 10px;
    }
    .deco-text p {
      font-family: var(--font-pixel);
      font-size: 10px;
      color: var(--ink-light);
      margin: 2px 0;
    }

    .kawaii-player {
      background: var(--candy-mint);
      border: 2px dashed var(--candy-purple);
      border-radius: 12px;
      padding: 12px;
      box-shadow: 3px 3px 0 rgba(181, 232, 224, 0.8);
      margin-bottom: 16px;
    }
    .kp-header {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 6px;
      font-family: var(--font-pixel);
      font-size: 10px;
      color: var(--ink-light);
      margin-bottom: 8px;
      letter-spacing: 1px;
    }
    .kp-dot {
      width: 4px;
      height: 4px;
      background: var(--candy-pink);
      border-radius: 50%;
    }
    .kp-screen {
      background: var(--soft-white);
      border: 1.5px solid var(--candy-purple);
      border-radius: 6px;
      padding: 6px;
      overflow: hidden;
      margin-bottom: 10px;
    }
    .kp-marquee {
      font-family: var(--font-serif-tc);
      font-size: 12px;
      color: var(--candy-purple);
      font-weight: bold;
      white-space: nowrap;
      animation: marquee-scroll 8s linear infinite;
    }
    @keyframes marquee-scroll {
      0% { transform: translateX(100%); }
      100% { transform: translateX(-100%); }
    }
    .kp-controls {
      display: flex;
      justify-content: center;
      gap: 12px;
    }
    .kp-btn {
      display: inline-flex;
      justify-content: center;
      align-items: center;
      width: 24px;
      height: 24px;
      background: var(--soft-white);
      border: 1.5px dashed var(--candy-purple);
      border-radius: 50%;
      font-size: 10px;
      color: var(--candy-purple);
    }
    .kp-play { background: var(--candy-pink); color: white; border-color: transparent; }

    .kawaii-counter {
      background: var(--candy-cream);
      border: 2px dashed var(--candy-peach);
      border-radius: 12px;
      padding: 12px;
      text-align: center;
      box-shadow: 3px 3px 0 rgba(255, 200, 200, 0.4);
    }
    .kc-title {
      font-family: var(--font-pixel);
      font-size: 10px;
      color: var(--ink-light);
      margin: 0 0 8px 0;
      letter-spacing: 2px;
    }
    .kc-digits {
      display: flex;
      justify-content: center;
      gap: 3px;
    }
    .kc-digits span {
      background: var(--soft-white);
      color: var(--candy-pink);
      font-family: var(--font-pixel);
      font-size: 16px;
      padding: 4px 6px;
      border: 1.5px solid var(--candy-pink);
      border-radius: 4px;
      font-weight: bold;
    }

    .bg-mint { background-color: var(--candy-mint); }
    .bg-pink { background-color: var(--candy-pink); }
    .bg-cream { background-color: var(--candy-cream); }

    .window-taskbar {
      background: var(--candy-mint);
      padding: 8px 16px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-top: 2px dashed var(--candy-mint);
      border-radius: 0 0 13px 13px;
      font-family: var(--font-pixel);
      font-size: 11px;
      color: var(--ink);
    }
    .taskbar-left { display: flex; gap: 12px; align-items: center; }
    .taskbar-right { display: flex; gap: 12px; align-items: center; }
    .taskbar-start {
      background: rgba(255, 255, 255, 0.5);
      padding: 2px 8px;
      border-radius: 3px;
      border: 1px dashed var(--candy-purple);
    }
    .taskbar-status,
    .taskbar-clock { color: var(--ink); font-weight: 700; }

    @media (max-width: 900px) {
      .home-window { margin: 12px; }
      .browser-strip,
      .links-layout {
        grid-template-columns: 1fr;
      }
      .mini-tabs { display: none; }
      .window-content { padding: 16px 12px; }
      .links-layout { gap: 16px; }
      .window-titlebar,
      .window-taskbar {
        flex-direction: column;
        gap: 8px;
        text-align: center;
      }
      .titlebar-left,
      .taskbar-left,
      .taskbar-right {
        justify-content: center;
        flex-wrap: wrap;
      }
      .sticky-sidebar { position: static; }
      .shelf-hero {
        grid-template-columns: 1fr;
        padding: 20px 16px;
      }
      .shelf-hero h1 { font-size: 25px; }
      .shelf-badge {
        width: 88px;
        justify-self: center;
      }
      .shelf-note {
        grid-template-columns: 1fr;
      }
      .bookmark-row {
        grid-template-columns: 1fr;
        gap: 7px;
      }
      .bookmark-meta {
        align-items: stretch;
      }
      .bookmark-meta span { text-align: left; }
      .bookmark-meta a { text-align: center; }
    }
  </style>

